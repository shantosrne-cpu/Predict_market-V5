from typing import Dict, List
import math

from utils.logger import logger


def calculate_metrics(candle_data: List[Dict], orderbook_data: Dict, ticker_data: Dict) -> Dict:
    if not candle_data or not orderbook_data.get("bids") or not ticker_data.get("last_price"):
        logger.warning("Datos insuficientes para métricas: candle_data o bids o last_price vacíos")
        logger.warning(f"candle_data: {candle_data}")
        logger.warning(f"orderbook_data['bids']: {orderbook_data.get('bids')}")
        logger.warning(f"ticker_data['last_price']: {ticker_data.get('last_price')}")
        return {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0}

    candle_data = [c for c in candle_data if c.get("volume", 0) > 0]
    if len(candle_data) < 2:
        logger.warning("No hay suficientes velas con volume > 0")
        return {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.5, "ogm": 0.0}

    bid_volume = sum(float(bid[1]) for bid in orderbook_data["bids"][:5])
    ask_volume = sum(float(ask[1]) for ask in orderbook_data["asks"][:5])
    ild = (bid_volume - ask_volume) / (bid_volume + ask_volume + 0.0001)
    ild = max(min(ild, 1.0), -1.0)
    logger.debug(f"ILD: bid_volume={bid_volume}, ask_volume={ask_volume}, ild={ild}")

    last_price = float(ticker_data["last_price"])
    avg_price = sum(float(c["close"]) for c in candle_data) / len(candle_data)
    egm = (last_price - avg_price) / (avg_price + 0.0001) if avg_price > 0 else 0.0
    egm = max(min(egm, 1.0), -1.0)
    logger.debug(f"EGM: last_price={last_price}, avg_price={avg_price}, egm={egm}")

    bids_value = sum(float(bid[0]) * float(bid[1]) for bid in orderbook_data["bids"][:5])
    asks_value = sum(float(ask[0]) * float(ask[1]) for ask in orderbook_data["asks"][:5])
    total_value = bids_value + asks_value
    rol = bids_value / (total_value + 0.0001) if total_value > 0 else 0.0
    rol = min(max(rol, 0.8), 1.0) if bids_value > asks_value else rol
    logger.debug(f"ROL: bids_value={bids_value}, asks_value={asks_value}, rol={rol}")

    if len(candle_data) < 2:
        pio = 0.5
    else:
        volume_change = (float(candle_data[0]["volume"]) - float(candle_data[-1]["volume"])) / (float(candle_data[-1]["volume"]) + 0.0001)
        pio = 1 / (1 + math.exp(-volume_change))
    logger.debug(f"PIO: volume_change={volume_change if 'volume_change' in locals() else 'N/A'}, pio={pio}")

    high_price = max(float(c["high"]) for c in candle_data)
    low_price = min(float(c["low"]) for c in candle_data)
    price_range = high_price - low_price if high_price > low_price else 1.0
    ogm = (last_price - low_price) / (price_range + 0.0001)
    ogm = max(min(ogm, 1.0), 0.0)
    logger.debug(f"OGM: high_price={high_price}, low_price={low_price}, price_range={price_range}, ogm={ogm}")

    combined = (ild * 0.25 + egm * 0.25 + rol * 0.2 + pio * 0.15 + ogm * 0.15) * 10
    logger.debug(f"Combined: {combined}")

    return {
        "combined": combined,
        "ild": ild,
        "egm": egm,
        "rol": rol,
        "pio": pio,
        "ogm": ogm
    }