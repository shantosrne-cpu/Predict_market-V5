import os
from pathlib import Path
from typing import Dict
from dotenv import load_dotenv

class Config:
    """Clase para gestionar la configuración del proyecto."""
    def __init__(self, env_path: str = None):
        load_dotenv(env_path or ".env")
        self._load_config()

    def _load_config(self):
        """Carga y valida la configuración desde variables de entorno."""
        self.base_path = Path(os.getenv("BASE_PATH", Path(__file__).parent.parent / "DATA")).resolve()
        self.symbol = os.getenv("SYMBOL", "BTCUSDT").upper()
        self.timeframe = os.getenv("TIMEFRAME", "1h").lower()
        self.use_testnet = os.getenv("USE_TESTNET", "true").lower() == "true"
        self.simulation_mode = os.getenv("SIMULATION_MODE", "true").lower() == "true"
        self.api_key = os.getenv("BYBIT_API_KEY") or ""
        self.api_secret = os.getenv("BYBIT_API_SECRET") or ""
        self.capital_usdt = self._validate_float(os.getenv("CAPITAL_USDT", "50000.0"), "capital_usdt")
        self.fee_rate = self._validate_float(os.getenv("FEE_RATE", "0.002"), "fee_rate")
        self.egm_buy_threshold = self._validate_float(os.getenv("EGM_BUY_THRESHOLD", "0.5"), "egm_buy_threshold")
        self.egm_sell_threshold = self._validate_float(os.getenv("EGM_SELL_THRESHOLD", "-0.5"), "egm_sell_threshold")
        self.whale_volume_threshold = self._validate_float(os.getenv("WHALE_VOLUME_THRESHOLD", "2000000.0"), "whale_volume_threshold")
        self.whale_order_threshold = self._validate_float(os.getenv("WHALE_ORDER_THRESHOLD", "10.0"), "whale_order_threshold")
        self.whale_zscore_threshold = self._validate_float(os.getenv("WHALE_ZSCORE_THRESHOLD", "3.0"), "whale_zscore_threshold")
        self.whale_atr_period = self._validate_int(os.getenv("WHALE_ATR_PERIOD", "14"), "whale_atr_period")
        self.whale_ema_short = self._validate_int(os.getenv("WHALE_EMA_SHORT", "5"), "whale_ema_short")
        self.whale_ema_long = self._validate_int(os.getenv("WHALE_EMA_LONG", "20"), "whale_ema_long")
        self.telegram_bot_token = os.getenv("TELEGRAM_BOT_TOKEN") or ""
        self.telegram_chat_id = os.getenv("TELEGRAM_CHAT_ID") or ""

    def _validate_float(self, value: str, name: str) -> float:
        try:
            return float(value)
        except (ValueError, TypeError):
            raise ValueError(f"❌ Configuración inválida: {name} debe ser un número flotante, recibido: {value}")

    def _validate_int(self, value: str, name: str) -> int:
        try:
            return int(value)
        except (ValueError, TypeError):
            raise ValueError(f"❌ Configuración inválida: {name} debe ser un entero, recibido: {value}")

    def get_config(self) -> Dict:
        """Devuelve la configuración como diccionario."""
        return {
            "base_path": self.base_path,
            "symbol": self.symbol,
            "timeframe": self.timeframe,
            "use_testnet": self.use_testnet,
            "simulation_mode": self.simulation_mode,
            "api_key": self.api_key,
            "api_secret": self.api_secret,
            "capital_usdt": self.capital_usdt,
            "fee_rate": self.fee_rate,
            "egm_buy_threshold": self.egm_buy_threshold,
            "egm_sell_threshold": self.egm_sell_threshold,
            "whale_volume_threshold": self.whale_volume_threshold,
            "whale_order_threshold": self.whale_order_threshold,
            "whale_zscore_threshold": self.whale_zscore_threshold,
            "whale_atr_period": self.whale_atr_period,
            "whale_ema_short": self.whale_ema_short,
            "whale_ema_long": self.whale_ema_long,
            "telegram_bot_token": self.telegram_bot_token,
            "telegram_chat_id": self.telegram_chat_id
        }

config = Config()