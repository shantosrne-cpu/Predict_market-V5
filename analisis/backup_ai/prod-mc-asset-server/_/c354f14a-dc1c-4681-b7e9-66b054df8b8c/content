                "symbol": t.symbol,
                "action": t.action,
                "entry_price": t.entry_price,
                "exit_price": t.exit_price,
                "quantity": t.quantity,
                "profit_loss": t.profit_loss,
                "decision": t.decision,
                "combined": t.combined,
                "ild": t.ild,
                "egm": t.egm,
                "rol": t.rol,
                "pio": t.pio,
                "ogm": t.ogm,
                "risk_reward_ratio": t.risk_reward_ratio
            } for t in trades]

