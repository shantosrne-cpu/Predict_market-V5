                available = available_to_withdraw_f if available_to_withdraw_f is not None else (wallet_balance - locked)
                if available < 0:
                    available = 0.0
                out["coins"][coin] = {
                    "walletBalance": wallet_balance,
                    "locked": locked,
                    "availableToWithdraw": available_to_withdraw_f,
                    "available": available,
                }
