        try:
            logger.info("Fetching initial data...")
            kline_url = f"{BASE_URL}/v5/market/kline"
            params = {"category": "spot", "symbol": self.symbol, "interval": self.timeframe.replace("m", ""), "limit": 10}
            response = requests.get(kline_url, params=params, timeout=10)
            if response.status_code == 200:
                kline_response = response.json()
                if "result" in kline_response and "list" in kline_response["result"]:
