from datetime import datetime, timezone
from fastapi import FastAPI, Depends, HTTPException
from models.database import MarketData, Orderbook, MarketTicker, Trade, execute_in_db
from services.metrics import calculate_metrics
import services.trading_engine
from utils.logger import logger

app = FastAPI ()


def get_engine ():
    if not hasattr (app.state, 'engine') or app.state.engine is None or not app.state.engine.running:
        raise HTTPException (status_code=500, detail="TradingEngine no inicializado o no está corriendo")
    return app.state.engine


@app.get ("/market_data/{symbol}")
async def get_market_data (symbol: str, engine: services.trading_engine.TradingEngine = Depends (get_engine)):
    logger.info (f"📡 /market_data/{symbol}")
    candles = []

    def load_candles (db):
        try:
            candles.extend (db.query (MarketData).filter (MarketData.symbol == symbol)
                            .order_by (MarketData.timestamp.desc ()).limit (5).all ())
        except Exception as exc:
            logger.error (f"❌ Error al cargar candles: {exc}")
            raise

    try:
        execute_in_db (load_candles)
        if not candles:
            logger.warning (f"⚠️ No se encontraron candles para {symbol}")
            return {"symbol": symbol, "candles": [], "message": "No data"}
        return {
            "symbol": symbol,
            "candles": [{"timestamp": c.timestamp.isoformat () + "Z", "open": c.open, "high": c.high, "low": c.low,
                         "close": c.close, "volume": c.volume} for c in candles],
            "message": ""
        }
    except Exception as exc:
        logger.error (f"❌ Error en /market_data: {exc}")
        raise HTTPException (status_code=500, detail=f"Error interno: {str (exc)}")


