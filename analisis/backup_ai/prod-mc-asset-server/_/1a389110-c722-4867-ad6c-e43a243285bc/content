    def _load_initial_trade_id (self) -> int:
        """Carga el ID inicial del trade desde la base de datos."""

        def load_trade_id (db):  # Añadir 'db' como parámetro
            from models.database import SessionLocal
            last_trade = db.query (Trade.trade_id).order_by (Trade.trade_id.desc ()).first ()
            return last_trade [0] + 1 if last_trade else 1

        try:
            result = None

            def set_result (db):  # Función auxiliar para capturar el resultado
                nonlocal result
                result = load_trade_id (db)

            execute_in_db (set_result)
            return result if result is not None else 1  # Valor por defecto seguro
        except Exception as exc:
            logger.error (f"❌ Error al cargar trade_id inicial: {exc}")
            return 1

    def _load_positions (self) -> None:
        """Carga todas las posiciones de trades desde la base de datos."""
        positions: List [Dict] = []

        def load_positions (db):  # Añadir 'db' como parámetro
            from models.database import SessionLocal
            try:
                trades = db.query (Trade).filter (Trade.symbol == self.symbol).order_by (
                    Trade.timestamp.desc ()
                ).all ()
                trade_ids = set ()  # Evitar duplicados
                for t in trades:
                    if t.trade_id not in trade_ids:
                        positions.append ({
                            "trade_id": t.trade_id,
                            "timestamp": t.timestamp.isoformat () + "Z",
                            "symbol": t.symbol,
                            "action": t.action,
                            "entry_price": t.entry_price,
                            "exit_price": t.exit_price,
                            "quantity": t.quantity,
                            "profit_loss": t.profit_loss,
                            "decision": t.decision,
                            "combined": t.combined,
                            "ild": t.ild,
                            "egm": t.egm,
                            "rol": t.rol,
                            "pio": t.pio,
                            "ogm": t.ogm,
                            "risk_reward_ratio": t.risk_reward_ratio,
                        })
                        trade_ids.add (t.trade_id)
            except Exception as exc:
                logger.error (f"❌ Error al cargar posiciones: {exc}")
                raise

        try:
            execute_in_db (load_positions)
            self.positions = positions
            logger.info (f"📦 Posiciones cargadas: {len (self.positions)} trades únicos")
        except Exception as exc:
            logger.error (f"❌ Error en _load_positions: {exc}")
            self.positions = []


