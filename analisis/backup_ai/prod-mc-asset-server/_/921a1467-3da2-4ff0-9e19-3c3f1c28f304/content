            )
            self.candles = db.query(MarketData).filter_by(symbol=self.symbol).order_by(
                MarketData.timestamp.desc()).limit(5).all()
            if not any(c.volume > 0.0001 for c in self.candles) or len(self.candles) < 2:
                logger.warning("⚠️ Volumen insuficiente en velas o pocas velas, ajustando con datos simulados")
                sim_candles = [
                    MarketData(
                        timestamp=datetime.now(timezone.utc),
                        symbol=self.symbol,
                        open=83737.54,
                        high=83737.54 * 1.001,
                        low=83737.54 * 0.999,
                        close=83737.54 * 1.0005,
                        volume=150.0
                    ),
                    MarketData(
                        timestamp=datetime.now(timezone.utc),
                        symbol=self.symbol,
                        open=83737.54 * 1.0005,
                        high=83737.54 * 1.002,
                        low=83737.54 * 0.998,
                        close=83737.54 * 1.001,
                        volume=200.0
                    ),
                ]
                for sim_candle in sim_candles:
                    if not db.query(MarketData).filter_by(timestamp=sim_candle.timestamp,
                                                           symbol=self.symbol).first():
                        db.add(sim_candle)
                db.commit()
                self.candles = sim_candles + [c for c in self.candles if c.volume > 0.0001][:3]
            self._execute_trade(db)
            logger.info(f"⚡ Kline: {timestamp}, Close: {candle.close}, Volume: {candle.volume}")

    def _store_orderbook(self, db: Session):
        orderbook = Orderbook(
            timestamp=datetime.now(timezone.utc),
            symbol=self.symbol,
            bids=json.dumps(self.orderbook_data["bids"]),
            asks=json.dumps(self.orderbook_data["asks"])
        )
        db.add(orderbook)
        db.commit()
        orderbook_data = {
            "timestamp": orderbook.timestamp.isoformat(),
            "symbol": self.symbol,
            "bids_count": len(self.orderbook_data["bids"]),
            "asks_count": len(self.orderbook_data["asks"]),
            "best_bid_price": float(self.orderbook_data["bids"][0][0]) if self.orderbook_data["bids"] else 0,
            "best_bid_volume": float(self.orderbook_data["bids"][0][1]) if self.orderbook_data["bids"] else 0,
            "best_ask_price": float(self.orderbook_data["asks"][0][0]) if self.orderbook_data["asks"] else 0,
            "best_ask_volume": float(self.orderbook_data["asks"][0][1]) if self.orderbook_data["asks"] else 0
        }
        self.save_to_csv(
            data=[orderbook_data],
            filename="orderbooks.csv",
            fieldnames=["timestamp", "symbol", "bids_count", "asks_count", "best_bid_price", "best_bid_volume",
                        "best_ask_price", "best_ask_volume"]
        )
        if time.time() - self.last_orderbook_log >= 5:
            logger.info(
                f"🤘 Orderbook actualizado: Bids={len(self.orderbook_data['bids'])}, Asks={len(self.orderbook_data['asks'])}")
            self.last_orderbook_log = time.time()

    def _handle_ticker(self, ticker: Dict, db: Session):
        self.ticker_data = {
            "last_price": float(ticker["lastPrice"]),
            "volume_24h": float(ticker["volume24h"]),
            "high_24h": float(ticker["highPrice24h"]),
            "low_24h": float(ticker["lowPrice24h"])
        }
        if self.ticker_data["last_price"] <= 0:
            self.ticker_data["last_price"] = 83737.54
            logger.warning("⚠️ last_price inválido, usando valor simulado")
        market_ticker = MarketTicker(
            timestamp=datetime.now(timezone.utc),
            symbol=self.symbol,
            last_price=self.ticker_data["last_price"],
            volume_24h=self.ticker_data["volume_24h"],
            high_24h=self.ticker_data["high_24h"],
            low_24h=self.ticker_data["low_24h"]
        )
        db.add(market_ticker)
        db.commit()
        logger.info(f"⚡ Ticker: {self.ticker_data['last_price']}")

    def _determine_decision (self, symbol):
        candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in
                       self.candles.get (symbol, [])] if self.candles.get (symbol) else []
        if not self._is_valid_orderbook (self.orderbook_data [symbol] ["bids"], self.orderbook_data [symbol] ["asks"]):
            logger.warning (f"⚠️ Orderbook inválido para decisión en {symbol}, usando datos de respaldo")
            self.orderbook_data [symbol] = {
                "bids": [["83700.00", "0.001"]] * 50,
                "asks": [["83800.00", "0.001"]] * 50
            }
        metrics = calculate_metrics (candle_data, self.orderbook_data [symbol], self.ticker_data [symbol])
        logger.info (f"📊 Métricas para {symbol}: {metrics}")

        # Log adicional para depurar EGM
        logger.info (f"🔍 EGM para {symbol}: {metrics ['egm']}")

        egm_buy_threshold = float (os.getenv ("EGM_BUY_THRESHOLD", 15.0))
        egm_sell_threshold = float (os.getenv ("EGM_SELL_THRESHOLD", -15.0))

        recent_positions = self.positions [symbol] [-10:] if len (self.positions [symbol]) >= 10 else self.positions [
            symbol]
        buy_count = sum (1 for pos in recent_positions if pos ["action"] == "Buy")
        sell_count = len (recent_positions) - buy_count
        buy_sell_ratio = buy_count / (sell_count + 1)

        if metrics ["egm"] > egm_buy_threshold and self.capital > Config.min_capital and buy_sell_ratio < 2.0:
            return "buy"
        elif metrics ["egm"] < egm_sell_threshold and len (self.positions [symbol]) > 0 and buy_sell_ratio > 0.5:
            return "sell"
        return "hold"

    def _place_order(self, action: str, quantity: float, price: float) -> Dict:
        logger.info(f"🛠️ Simulando {action}, Qty: {quantity:.6f}, Price: {price:.2f}")
        return {"success": True, "order_id": f"sim-{self.trade_id_counter}", "entry_price": price}

    def _close_order(self, order_id: str, action: str, quantity: float, entry_price: float, db: Session) -> Dict:
        try:
            if action not in ["Buy", "Sell"]:
                raise ValueError(f"Acción inválida: {action}")
            if entry_price <= 0:
                raise ValueError(f"Precio de entrada inválido: {entry_price}")
            exit_price = entry_price * (1.002 if action == "Buy" else 0.998)
            if exit_price <= 0:
                raise ValueError(f"Precio de salida inválido: {exit_price}")
            fee = (entry_price + exit_price) * quantity * Config.fee_rate
            profit_loss = (exit_price - entry_price - fee) * quantity if action == "Buy" else (entry_price - exit_price - fee) * quantity
            candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in
                           self.candles] if self.candles and len(self.candles) >= 2 else []
            if not candle_data:
                logger.warning("⚠️ Usando métricas por defecto por falta de velas")
                metrics = {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0}
            else:
                metrics = calculate_metrics(candle_data, self.orderbook_data, self.ticker_data)
            while db.query(Trade).filter_by(trade_id=self.trade_id_counter).first():
                logger.warning(f"⚠️ trade_id {self.trade_id_counter} ya existe, incrementando...")
                self.trade_id_counter += 1
            trade = Trade(
                trade_id=self.trade_id_counter,
                timestamp=datetime.now(timezone.utc),
                symbol=self.symbol,
                action=action,
                entry_price=entry_price,
                exit_price=exit_price,
                quantity=quantity,
                profit_loss=profit_loss,
                decision=action.lower(),
                combined=metrics["combined"],
                ild=metrics["ild"],
                egm=metrics["egm"],
                rol=metrics["rol"],
                pio=metrics["pio"],
                ogm=metrics["ogm"],
                risk_reward_ratio=1.5
            )
            db.add(trade)
            db.commit()
            self.capital += profit_loss
            trade_dict = {
                "trade_id": trade.trade_id,
                "timestamp": trade.timestamp.isoformat(),
                "symbol": trade.symbol,
                "action": trade.action,
                "entry_price": trade.entry_price,
                "exit_price": trade.exit_price,
                "quantity": trade.quantity,
                "profit_loss": trade.profit_loss,
                "decision": trade.decision,
                "combined": trade.combined,
                "ild": trade.ild,
                "egm": trade.egm,
                "rol": trade.rol,
                "pio": trade.pio,
                "ogm": trade.ogm,
                "risk_reward_ratio": trade.risk_reward_ratio
            }
            self.positions.append(trade_dict)
            self.trade_id_counter += 1
            logger.info(f"🔥 Cierre: P&L={profit_loss:.2f}, Entry={entry_price:.2f}, Exit={exit_price:.2f}")
            return {"success": True, "exit_price": exit_price}
        except Exception as e:
            logger.error(f"❌ Error en _close_order: {e}", exc_info=True)
            db.rollback()
            return {"success": False, "error": str(e)}

    def _execute_trade(self, db: Session):
        if not self.running or self.iterations >= Config.max_iterations:
            logger.info(f"🛑 Detenido: Iter={self.iterations}/{Config.max_iterations}")
            self.stop()
            return
        decision = self._determine_decision()
        logger.info(f"🔍 Decisión: {decision}")
        if decision == "hold":
            logger.info("🎸 Hold")
            self.iterations += 1
            self._save_results(None)
            return
        if not self.ticker_data.get("last_price"):
            logger.warning("⚠️ Usando precio simulado: 80090.68")
            self.ticker_data["last_price"] = 80090.68
        entry_price = float(self.ticker_data["last_price"])
        quantity = max(min(Config.risk_factor * self.capital / entry_price, Config.max_trade_size),
                       Config.min_trade_size)
        logger.info(f"📏 Trade: {decision}, Price={entry_price:.2f}, Qty={quantity:.6f}")
        try:
            order_result = self._place_order(decision, quantity, entry_price)
            if not order_result["success"]:
                logger.error(f"❌ Orden falló: {order_result.get('error')}")
                failed_trade = {
                    "trade_id": self.trade_id_counter,
                    "timestamp": datetime.now(timezone.utc).isoformat(),
                    "symbol": self.symbol,
                    "action": decision,
                    "entry_price": entry_price,
                    "exit_price": None,
                    "quantity": quantity,
                    "profit_loss": 0.0,
                    "status": "failed",
                    "error": order_result.get("error", "Unknown error")
                }
                self.save_to_csv(
                    data=[failed_trade],
                    filename="trades.csv",
                    fieldnames=["trade_id", "timestamp", "symbol", "action", "entry_price", "exit_price", "quantity",
                                "profit_loss", "status", "error", "current_capital"]
                )
                self.iterations += 1
                self._save_results(None)
                return
            time.sleep(5)
            close_result = self._close_order(order_result["order_id"], "Sell" if decision == "buy" else "Buy",
                                             quantity, entry_price, db)
            if not close_result["success"]:
                logger.error(f"❌ Cierre falló: {close_result.get('error')}")
                failed_trade = {
                    "trade_id": self.trade_id_counter,
                    "timestamp": datetime.now(timezone.utc).isoformat(),
                    "symbol": self.symbol,
                    "action": decision,
                    "entry_price": entry_price,
                    "exit_price": None,
                    "quantity": quantity,
                    "profit_loss": 0.0,
                    "status": "failed_close",
                    "error": close_result.get("error", "Unknown error")
                }
                self.save_to_csv(
                    data=[failed_trade],
                    filename="trades.csv",
                    fieldnames=["trade_id", "timestamp", "symbol", "action", "entry_price", "exit_price", "quantity",
                                "profit_loss", "status", "error", "current_capital"]
                )
                self.iterations += 1
                self._save_results(None)
                return
            exit_price = close_result["exit_price"]
            profit_loss = (exit_price - entry_price) * quantity if decision == "buy" else (
                    entry_price - exit_price) * quantity
            current_time = datetime.now(timezone.utc)
            metrics = self._determine_decision_metrics()
            trade = Trade(
                trade_id=self.trade_id_counter,
                timestamp=current_time,
                symbol=self.symbol,
                action=decision,
                entry_price=entry_price,
                exit_price=exit_price,
                quantity=quantity,
                profit_loss=profit_loss,
                decision=decision,
                combined=metrics["combined"],
                ild=metrics["ild"],
                egm=metrics["egm"],
                rol=metrics["rol"],
                pio=metrics["pio"],
                ogm=metrics["ogm"],
                risk_reward_ratio=1.5
            )
            db.add(trade)
            db.commit()
            logger.info(f"📈 Guardado: ID={trade.trade_id}, P&L={profit_loss:.2f}")
            self.capital += profit_loss
            trade_result = {
                "trade_id": trade.trade_id,
                "timestamp": current_time.isoformat(),
                "symbol": self.symbol,
                "action": decision,
                "entry_price": entry_price,
                "exit_price": exit_price,
                "quantity": quantity,
                "profit_loss": profit_loss,
                "current_capital": self.capital,
                "combined": metrics["combined"],
                "ild": metrics["ild"],
                "egm": metrics["egm"],
                "rol": metrics["rol"],
                "pio": metrics["pio"],
                "ogm": metrics["ogm"],
                "risk_reward_ratio": 1.5
            }
            self.save_to_csv(
                data=[trade_result],
                filename="trades.csv",
                fieldnames=["trade_id", "timestamp", "symbol", "action", "entry_price", "exit_price", "quantity",
                            "profit_loss", "current_capital", "combined", "ild", "egm", "rol", "pio", "ogm",
                            "risk_reward_ratio"]
            )
            self._save_results(trade_result)
        except Exception as e:
            logger.error(f"❌ Error en _execute_trade: {e}", exc_info=True)
            db.rollback()
            self._save_results(None)
        self.iterations += 1
        if decision != "hold":
            self.force_initial_trade = False
            self._analyze_problematic_trades()
        logger.info(f"🔄 Iteración {self.iterations}, Capital={self.capital:.2f}")

    def _analyze_problematic_trades(self):
        problematic_trades = [pos for pos in self.positions if pos["combined"] < -5.0 or pos["profit_loss"] < 0]
        if problematic_trades:
            logger.warning(f"⚠️ Trades problemáticos detectados: {len(problematic_trades)}")
            for trade in problematic_trades:
                logger.info(f"Trade ID={trade['trade_id']}, Combined={trade['combined']:.2f}, P&L={trade['profit_loss']:.2f}")
        return problematic_trades

    def _save_results(self, trade_result: Dict):
        total_profit = sum(t["profit_loss"] for t in self.positions if t["profit_loss"] > 0)
        total_loss = sum(t["profit_loss"] for t in self.positions if t["profit_loss"] < 0)
        net_profit = total_profit + total_loss
        total_trades = len(self.positions)
        win_rate = (len([t for t in self.positions if t["profit_loss"] > 0]) / total_trades) if total_trades > 0 else 0
        avg_profit_per_trade = net_profit / total_trades if total_trades > 0 else 0

        results = {
            "metadata": {
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "capital_inicial": Config.capital_usdt,
                "capital_actual": self.capital,
                "capital_final": self.capital,
                "total_pnl": self.capital - Config.capital_usdt,
                "total_trades": total_trades,
                "iterations": self.iterations,
                "running": self.running
            },
            "summary": {
                "total_profit": round(total_profit, 2),
                "total_loss": round(total_loss, 2),
                "net_profit": round(net_profit, 2),
                "win_rate": round(win_rate, 2),
                "avg_profit_per_trade": round(avg_profit_per_trade, 2)
            },
            "trades": self.positions
        }
        if trade_result:
            results["metadata"]["last_trade_timestamp"] = trade_result.get("timestamp")
            results["last_trade"] = trade_result
        save_results(results, log_dir=os.path.join(os.path.dirname(__file__), '..', 'logs'))

    def stop(self):
        self.running = False
        if self.ws:
            self.ws.close()
        logger.info("🛑 Bot detenido")

    def save_to_csv(self, data: List[Dict], filename: str, fieldnames: List[str], base_dir: str = "logs"):
        """Guarda datos en un archivo CSV dentro de /logs/csv/."""
        log_dir = os.path.join(os.path.dirname(__file__), '..', base_dir, 'csv')
        os.makedirs(log_dir, exist_ok=True)
        filepath = os.path.join(log_dir, filename)

        file_exists = os.path.isfile(filepath)
        with open(filepath, mode='a', newline='') as csvfile:
            writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
            if not file_exists:
                writer.writeheader()
            for row in data:
                writer.writerow(row)

    def _determine_decision_metrics(self):
        candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in
                       self.candles] if self.candles else []
        return calculate_metrics(candle_data, self.orderbook_data, self.ticker_data)

    def reset_trades(self):
        self.positions = []
        self.trade_id_counter = self._load_initial_trade_id()
        with SessionLocal() as db:
            db.query(Trade).delete()
            db.commit()
        logger.info("🧹 Trades reseteados")

