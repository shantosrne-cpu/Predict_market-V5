import json
import logging
import sqlite3
import time
from datetime import datetime, timezone
from pathlib import Path

import websocket

from adju_config import config

# Configurar logging con vibe metalero
logging.basicConfig(level=logging.INFO, format='%(asctime)s [⚡ METAL ⚡] %(message)s')
logger = logging.getLogger("FillDB")

# Configurar la ruta absoluta para la base de datos usando config
db_path = Path(config.get_config()["base_path"]) / "market_data.db"

# Verificar si el archivo existe
if not db_path.exists():
    raise FileNotFoundError(f"❌ [⚡ METAL ⚡] La base de datos no existe en: {db_path}")

# Conectar a la base de datos con manejo de errores
try:
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    logger.info(f"⚡ [⚡ METAL ⚡] Conectado a la base de datos en: {db_path}")
except sqlite3.Error as e:
    raise Exception(f"❌ [⚡ METAL ⚡] Error al conectar a la base de datos: {e}")

# Crear tablas si no existen
cursor.execute("""
    CREATE TABLE IF NOT EXISTS market_data (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        timestamp INTEGER NOT NULL,
        symbol TEXT NOT NULL,
        timeframe TEXT NOT NULL,
        open REAL NOT NULL,
        high REAL NOT NULL,
        low REAL NOT NULL,
        close REAL NOT NULL,
        volume REAL NOT NULL,
        UNIQUE(timestamp, symbol, timeframe)
    )
""")
cursor.execute("""
    CREATE TABLE IF NOT EXISTS orderbook (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        timestamp INTEGER NOT NULL,
        symbol TEXT NOT NULL,
        bids TEXT NOT NULL,
        asks TEXT NOT NULL,
        UNIQUE(timestamp, symbol)
    )
""")
cursor.execute("""
    CREATE TABLE IF NOT EXISTS market_ticker (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        timestamp INTEGER NOT NULL,
        symbol TEXT NOT NULL,
        last_price REAL NOT NULL,
        volume_24h REAL NOT NULL,
        high_24h REAL NOT NULL,
        low_24h REAL NOT NULL,
        UNIQUE(timestamp, symbol)
    )
""")

# Configurar WebSocket para Bybit Testnet
symbol = config.get_config()["symbol"]
timeframe = config.get_config()["timeframe"]

def on_open(ws):
    timeframe_map = {
        "1m": "1m",
        "5m": "5m",
        "15m": "15m",
        "30m": "30m",
        "1h": "1h",
        "4h": "4h",
        "1d": "1d",
        "1w": "1w",
        "1M": "1M"
    }
    valid_timeframe = timeframe_map.get(timeframe.lower(), "1h")
    logger.info(f"⚡ Ritmo metalero bestial iniciado - WebSocket conectado")
    ws.send(json.dumps({
        "op": "subscribe",
        "args": [
            f"kline.{valid_timeframe}.{symbol}",
            f"orderbook.50.{symbol}",
            f"tickers.{symbol}"
        ]
    }))

def on_message(ws, message):
    try:
        data = json.loads(message)
        if "topic" in data and "data" in data:
            if "kline" in data["topic"]:
                kline = data["data"][0]  # Primer elemento de la lista de kline
                candle = {
                    "timestamp": kline["start"],  # Timestamp de inicio de la vela
                    "open": float(kline["open"]),
                    "high": float(kline["high"]),
                    "low": float(kline["low"]),
                    "close": float(kline["close"]),
                    "volume": float(kline["volume"])
                }
                cursor.execute("""
                    INSERT INTO market_data (timestamp, symbol, timeframe, open, high, low, close, volume)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                    ON CONFLICT(timestamp, symbol, timeframe) DO UPDATE SET open=?, high=?, low=?, close=?, volume=?
                """, (candle["timestamp"], symbol, timeframe, candle["open"], candle["high"], candle["low"],
                      candle["close"], candle["volume"],
                      candle["open"], candle["high"], candle["low"], candle["close"], candle["volume"]))
                conn.commit()
                logger.info(
                    f"⚡ [⚡ METAL ⚡] Vela almacenada: {datetime.fromtimestamp(candle['timestamp'] / 1000, tz=timezone.utc)} - Close: {candle['close']}")
            elif "orderbook" in data["topic"]:
                orderbook_data = data["data"]
                bids = orderbook_data.get("b", [])
                asks = orderbook_data.get("a", [])
                logger.info(f"🤘 [⚡ METAL ⚡] Orderbook recibido - Bids: {bids[:2]}, Asks: {asks[:2]}")  # Depuración
                cursor.execute("""
                    INSERT INTO orderbook (timestamp, symbol, bids, asks)
                    VALUES (?, ?, ?, ?)
                    ON CONFLICT(timestamp, symbol) DO UPDATE SET bids=?, asks=?
                """, (
                    int(datetime.now(timezone.utc).timestamp() * 1000), symbol, json.dumps(bids), json.dumps(asks),
                    json.dumps(bids), json.dumps(asks)))
                conn.commit()
                logger.info(f"🤘 [⚡ METAL ⚡] Orderbook almacenado - Bids: {len(bids)}, Asks: {len(asks)}")
            elif "tickers" in data["topic"]:
                ticker = data["data"]
                ticker_data = {
                    "last_price": float(ticker["lastPrice"]),
                    "volume_24h": float(ticker["volume24h"]),
                    "high_24h": float(ticker["highPrice24h"]),
                    "low_24h": float(ticker["lowPrice24h"])
                }
                cursor.execute("""
                    INSERT INTO market_ticker (timestamp, symbol, last_price, volume_24h, high_24h, low_24h)
                    VALUES (?, ?, ?, ?, ?, ?)
                    ON CONFLICT(timestamp, symbol) DO UPDATE SET last_price=?, volume_24h=?, high_24h=?, low_24h=?
                """, (int(datetime.now(timezone.utc).timestamp() * 1000), symbol, ticker_data["last_price"],
                      ticker_data["volume_24h"], ticker_data["high_24h"], ticker_data["low_24h"],
                      ticker_data["last_price"], ticker_data["volume_24h"], ticker_data["high_24h"], ticker_data["low_24h"]))
                conn.commit()
                logger.info(f"⚡ [⚡ METAL ⚡] Ticker almacenado: Precio: {ticker_data['last_price']}")
    except Exception as e:
        logger.error(f"❌ [⚡ METAL ⚡] Error al procesar mensaje: {e}")

def on_error(ws, error):
    logger.error(f"❌ [⚡ METAL ⚡] Error en WebSocket: {error}")

def on_close(ws, close_status_code=None, close_msg=None):
    logger.info(f"🔥 [⚡ METAL ⚡] WebSocket cerrado - Código: {close_status_code}, Mensaje: {close_msg}")
    conn.close()

# Iniciar WebSocket con reconexión automática
while True:
    ws = websocket.WebSocketApp(
        "wss://stream-testnet.bybit.com/v5/public/spot",
        on_open=on_open,
        on_message=on_message,
        on_error=on_error,
        on_close=on_close
    )
    ws.run_forever()
    logger.info("🔄 [⚡ METAL ⚡] Intentando reconectar en 5 segundos...")
    time.sleep(5)  # Esperar antes de intentar reconectar