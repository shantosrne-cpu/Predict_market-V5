# Funciones de utilidad
def calculate_metrics(candle_data: List[Dict], orderbook_data: Dict, ticker_data: Dict, depth: int = 5) -> Dict:
    """Calcula métricas de decisión basadas en velas, orderbook y ticker."""
    if not candle_data or len(candle_data) < 2 or not orderbook_data.get("bids") or not orderbook_data.get("asks") or not ticker_data.get("last_price"):
        logger.warning("Datos insuficientes para calcular métricas")
        return {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0}

    try:
        candle_data = candle_data[:]
        if all(float(c.get("volume", 0)) <= 0.0001 for c in candle_data):
            logger.warning("⚠️ Volumen insuficiente, ajustando con datos simulados")
            candle_data = [
                {"open": 83737.54, "high": 83737.54 * 1.001, "low": 83737.54 * 0.999, "close": 83737.54 * 1.0005, "volume": 150.0},
                {"open": 83737.54 * 1.0005, "high": 83737.54 * 1.002, "low": 83737.54 * 0.998, "close": 83737.54 * 1.001, "volume": 200.0},
            ]
        if len(candle_data) < 2:
            logger.warning("No hay suficientes velas después de ajuste")
            return {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0}

        last_price = float(ticker_data["last_price"])
        closes = [float(c["close"]) for c in candle_data]
        highs = [float(c["high"]) for c in candle_data]
        lows = [float(c["low"]) for c in candle_data]
        volumes = [float(c["volume"]) for c in candle_data]
        avg_price = np.mean(closes)
        price_range = max(max(highs) - min(lows), 1e-8)

        bid_volume = sum(float(bid[1]) for bid in orderbook_data["bids"][:depth])
        ask_volume = sum(float(ask[1]) for ask in orderbook_data["asks"][:depth])
        total_volume = bid_volume + ask_volume + 1e-6
        ild = (bid_volume - ask_volume) / total_volume

        egm = (last_price - avg_price) / price_range
        egm = np.clip(egm, -1.0, 1.0)

        bid_value = sum(float(bid[0]) * float(bid[1]) for bid in orderbook_data["bids"][:depth])
        ask_value = sum(float(ask[0]) * float(ask[1]) for ask in orderbook_data["asks"][:depth])
        total_value = bid_value + ask_value + 1e-6
        rol = (bid_value - ask_value) / total_value

        if len(volumes) >= 2:
            avg_volume = np.mean(volumes[:-1])
            last_volume = volumes[0]
            pio = (last_volume - avg_volume) / (avg_volume + 1e-6)
            pio = np.clip(pio, -1.0, 1.0)
        else:
            pio = 0.0

        best_bid = float(orderbook_data["bids"][0][0]) if orderbook_data["bids"] else last_price
        best_ask = float(orderbook_data["asks"][0][0]) if orderbook_data["asks"] else last_price
        spread = (best_ask - best_bid) / last_price
        ogm = 1.0 - np.clip(spread / 0.02, 0, 1.0)

        combined = (0.3 * ild + 0.2 * egm + 0.2 * rol + 0.2 * pio + 0.1 * ogm) * 100
        combined = np.clip(combined, -100.0, 100.0)

        logger.debug(f"Métricas: combined={combined}, ild={ild}, egm={egm}, rol={rol}, pio={pio}, ogm={ogm}")
        return {
            "combined": combined,
            "ild": ild,
            "egm": egm,
            "rol": rol,
            "pio": pio,
            "ogm": ogm
        }
    except (KeyError, ValueError, IndexError) as e:
        logger.error(f"Error calculando métricas: {e}")
        return {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0}
    except Exception as e:
        logger.error(f"Excepción inesperada en calculate_metrics: {e}", exc_info=True)
        return {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0}

def generate_signature(api_secret: str, params: dict) -> str:
    """Genera una firma HMAC-SHA256 para las solicitudes a la API de Bybit."""
    sorted_params = "&".join([f"{k}={v}" for k, v in sorted(params.items())])
    return hmac.new(api_secret.encode(), sorted_params.encode(), hashlib.sha256).hexdigest()

def sanitize_filename(filename: str) -> str:
    """Sanitiza el nombre del archivo para prevenir Path Injection."""
    return os.path.basename(filename)

def save_results(results: dict, log_dir: str = "logs", consolidate: bool = True, max_files: int = 1) -> None:
    """Guarda los resultados en un archivo JSON en el directorio de logs."""
    try:
        log_dir = os.path.abspath(log_dir)
        os.makedirs(log_dir, exist_ok=True)

        if consolidate:
            filename = "results_consolidated.json"
        else:
            timestamp = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
            filename = sanitize_filename(f"results_{timestamp}.json")

        filepath = os.path.join(log_dir, filename)

        if os.path.exists(filepath):
            with open(filepath, "r", encoding="utf-8") as f:
                existing_results = json.load(f)
        else:
            existing_results = {
                "capital_inicial": 0.0,
                "capital_final": 0.0,
                "total_pnl": 0.0,
                "trades": [],
                "iterations": 0,
            }

        if "capital_inicial" in results and existing_results["capital_inicial"] == 0.0:
            existing_results["capital_inicial"] = results["capital_inicial"]
        existing_results["capital_final"] = results.get("metadata", {}).get("capital_final", 0.0)
        existing_results["total_pnl"] = results.get("metadata", {}).get("total_pnl", 0.0)
        existing_results["trades"] = results.get("trades", [])
        existing_results["iterations"] = results.get("metadata", {}).get("iterations", 0)

        with open(filepath, "w", encoding="utf-8") as f:
            json.dump(existing_results, f, indent=4)

        logger.info(f"📈 Resultados guardados en {filepath}")

        if consolidate and max_files == 1:
            files = [f for f in os.listdir(log_dir) if f.startswith("results_") and f != "results_consolidated.json"]
            for file in files:
                os.remove(os.path.join(log_dir, file))

    except Exception as e:
        logger.error(f"❌ Error guardando resultados: {e}")

def timestamp_to_datetime(timestamp_ms: int) -> datetime:
    """Convierte un timestamp en milisegundos a datetime con timezone UTC."""
    return datetime.fromtimestamp(timestamp_ms / 1000, tz=timezone.utc)

