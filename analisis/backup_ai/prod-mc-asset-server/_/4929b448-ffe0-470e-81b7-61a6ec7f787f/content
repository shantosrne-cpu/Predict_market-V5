import logging
import os
from logging.handlers import RotatingFileHandler

logger = logging.getLogger("adju_bot")
logger.setLevel(logging.DEBUG)

formatter = logging.Formatter(
    "%(asctime)s [⚡ METAL ⚡] %(levelname)s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S"
)

console_handler = logging.StreamHandler()
console_handler.setLevel(logging.INFO)
console_handler.setFormatter(formatter)
console_handler.stream = open(console_handler.stream.fileno(), mode='w', encoding='utf-8', buffering=1)
logger.addHandler(console_handler)

log_dir = os.path.join(os.path.dirname(__file__), '..', 'logs')
os.makedirs(log_dir, exist_ok=True)

log_file = os.path.join(log_dir, "adju_bot.log")
file_handler = RotatingFileHandler(log_file, maxBytes=10*1024*1024, backupCount=5, encoding='utf-8')
file_handler.setLevel(logging.DEBUG)
file_handler.setFormatter(formatter)
logger.addHandler(file_handler)