import os
import json
from datetime import datetime, timezone
from utils.logger import logger

def timestamp_to_datetime(timestamp):
    """
    Convierte un timestamp (en segundos o milisegundos) a un objeto datetime en UTC.
    Bybit envía timestamps en milisegundos, así que los dividimos por 1000 si es necesario.
    """
    if not isinstance(timestamp, (int, float)):
        raise ValueError("Timestamp debe ser un número")
    if timestamp > 1e12:  # Si es mayor a 1e12, asumimos que está en milisegundos
        timestamp = timestamp / 1000
    return datetime.fromtimestamp(timestamp, tz=timezone.utc)

def save_results(results, log_dir, consolidate=True, max_files=1):
    """
    Guarda los resultados en un archivo JSON, con opción de consolidación y límite de archivos.
    """
    if not os.path.exists(log_dir):
        os.makedirs(log_dir)
    if consolidate:
        filename = "results_consolidated.json"
    else:
        timestamp = datetime.utcnow().strftime("%Y%m%d_%H%M%S")
        filename = f"results_{timestamp}.json"
    filepath = os.path.join(log_dir, filename)
    filepath_normalized = os.path.normpath(filepath)
    try:
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(results, f, indent=4)
        logger.info(f"Mapa del metal guardado en {filepath_normalized}")
        if consolidate and max_files == 1:
            files = [f for f in os.listdir(log_dir) if f.startswith("results_") and f != "results_consolidated.json"]
            for file in files:
                os.remove(os.path.join(log_dir, file))
    except Exception as e:
        logger.error(f"Error al guardar el mapa: {e}")

def send_alert(subject, message):
    """
    Envía una alerta al log (puede expandirse para notificaciones externas).
    """
    logger.warning(f"Alerta: {subject} - {message}")

def initialize_trading_engine(symbol: str, timeframe: str = "5m", capital: float = 10000, ws_url: str = "wss://stream.bybit.com/v5/public/spot"):
    """
    Inicializa y devuelve una instancia de TradingEngine con los parámetros especificados.
    """
    if not ws_url.startswith("wss://"):
        raise ValueError("URL de WebSocket debe empezar con wss://")
    from services.trading_engine import TradingEngine
    engine = TradingEngine(symbol=symbol, timeframe=timeframe, capital=capital)
    engine.ws_url = ws_url
    return engine

