        raise HTTPException(status_code=500, detail=f"Error interno: {str(exc)}")

@app.get("/metrics/{symbol}")
async def get_all_metrics(symbol: str, engine: services.trading_engine.TradingEngine = Depends(get_engine)):
    logger.info(f"📡 /metrics/{symbol}")
    try:
        candle_data = engine.candles[-10:] if engine.candles else []
        orderbook_data = engine.orderbook_data
        ticker_data = engine.ticker_data
        if not candle_data or not orderbook_data.get("bids") or not ticker_data.get("last_price"):
            logger.warning(f"⚠️ Datos insuficientes para métricas en tiempo real para {symbol}")
            return {"symbol": symbol, "metrics": {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0}, "timestamp": datetime.now(timezone.utc).isoformat() + "Z"}
        metrics = calculate_metrics(candle_data, orderbook_data, ticker_data)
        return {"symbol": symbol, "metrics": metrics, "timestamp": datetime.now(timezone.utc).isoformat() + "Z"}
    except Exception as exc:
        logger.error(f"❌ Error en /metrics: {exc}")
        raise HTTPException(status_code=500, detail=f"Error interno: {str(exc)}")

@app.get("/trades/{symbol}")
