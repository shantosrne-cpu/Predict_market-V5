_time_sync_lock = asyncio.Lock()
_time_offset_ms = 0
_time_last_sync_monotonic = 0.0
_time_sync_interval_seconds = 30.0


async def get_server_time(session: aiohttp.ClientSession) -> int:
    url = f"{BASE_URL}/v5/market/time"
    async with session.get(url) as response:
        if response.status == 200:
            data = await response.json()
            result = (data.get("result") or {}) if isinstance(data, dict) else {}
            time_nano = result.get("timeNano")
            if time_nano is not None:
                return int(time_nano) // 1_000_000
            time_second = result.get("timeSecond")
            if time_second is not None:
                return int(time_second) * 1000
            return int(time.time() * 1000)
        logger.error(f"❌ Failed to fetch Bybit server time: {response.status}")
        return int(time.time() * 1000)


def get_ntp_time() -> int:
    try:
        client = ntplib.NTPClient()
        response = client.request('pool.ntp.org', timeout=2)
        ntp_time = int(response.tx_time * 1000)
        local_time = int(time.time() * 1000)
        offset = ntp_time - local_time
        logger.info(f"✅ NTP time: {ntp_time}, offset: {offset} ms")
        return ntp_time
    except Exception as e:
        logger.error(f"❌ NTP failed: {e}. Falling back to local time.")
        return int(time.time() * 1000)


async def get_synced_time() -> int:
    global _time_offset_ms, _time_last_sync_monotonic
    now_monotonic = time.monotonic()
    if (now_monotonic - _time_last_sync_monotonic) > _time_sync_interval_seconds:
        async with _time_sync_lock:
            now_monotonic = time.monotonic()
            if (now_monotonic - _time_last_sync_monotonic) > _time_sync_interval_seconds:
                try:
                    async with aiohttp.ClientSession() as session:
                        server_time = await get_server_time(session)
                    local_time = int(time.time() * 1000)
                    _time_offset_ms = int(server_time - local_time)
                    _time_last_sync_monotonic = now_monotonic
                    logger.info(f"🕒 Sync tiempo: offset={_time_offset_ms} ms")
                except Exception as e:
                    logger.warning(f"⚠ No se pudo sincronizar tiempo: {e}")
    return int(time.time() * 1000) + int(_time_offset_ms)


