async def get_metrics_data (symbol: str, db: Session) -> Dict:
    candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in
                   bot.candles.get (symbol, [])] or [
                      {"open": 83000.0, "high": 83000.0 * 1.001, "low": 83000.0 * 0.999, "close": 83000.0,
                       "volume": 100.0}
                      for _ in range (5)
                  ]
    return cached_calculate_metrics (
        tuple (json.dumps (candle_data)),
        json.dumps (bot.orderbook_data.get (symbol, {"bids": [], "asks": []})),
        json.dumps (bot.ticker_data.get (symbol, {"last_price": 83000.0}))
    )


