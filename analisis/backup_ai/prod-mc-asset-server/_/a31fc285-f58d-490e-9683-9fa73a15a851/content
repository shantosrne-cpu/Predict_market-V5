@app.get("/pnl/{symbol}")
async def get_pnl(symbol: str, engine: services.trading_engine.TradingEngine = Depends(get_engine)):
    logger.info(f"📡 /pnl/{symbol}")
    try:
        # Usar positions en tiempo real desde engine para calcular PNL
        trades = engine.positions
        if not trades:
            logger.warning(f"⚠️ No se encontraron trades para {symbol} en tiempo real")
            return {
                "symbol": symbol,
                "total_pnl": 0.0,
                "trades_count": 0,
                "message": "No trades found",
                "timestamp": datetime.now(timezone.utc).isoformat() + "Z"
            }
        total_pnl = sum(trade["profit_loss"] for trade in trades)
        return {
            "symbol": symbol,
            "total_pnl": total_pnl,
            "trades_count": len(trades),
            "timestamp": datetime.now(timezone.utc).isoformat() + "Z"
        }
    except Exception as exc:
        logger.error(f"❌ Error en /pnl: {exc}")
        raise HTTPException(status_code=500, detail=f"Error interno: {str(exc)}")

@app.post("/reset_trades/{symbol}")
async def reset_trades(
    symbol: str,
    reset_counter: bool = False,
    engine: services.trading_engine.TradingEngine = Depends(get_engine),
):
    """
    Resetea los trades relacionados al símbolo y opcionalmente reinicia el contador de trade_id.
    """
    logger.info(f"📡 Solicitud para resetear trades en {symbol} con reset_counter={reset_counter}")

    try:
        # Llamar al método reset_trades del motor
        engine.reset_trades(reset_counter=reset_counter)
        return {
            "symbol": symbol,
            "message": f"Trades reseteados {'y contador reiniciado' if reset_counter else ''}.",
            "timestamp": datetime.now(timezone.utc).isoformat() + "Z"
        }
    except Exception as exc:
        logger.error(f"❌ Error al intentar resetear trades para {symbol}: {exc}")
        raise HTTPException(status_code=500, detail=f"Error interno: {str(exc)}")