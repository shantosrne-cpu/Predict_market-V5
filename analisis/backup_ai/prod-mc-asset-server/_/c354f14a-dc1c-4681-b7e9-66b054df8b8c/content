    def start(self):
        logger.info(f"🔥 Motor metalero iniciado para {self.symbol}")
        self.fetch_initial_data()
        self._connect_websocket()

    def _connect_websocket(self):
        if self.ws and self.ws.sock and self.ws.sock.connected:
            logger.info("🌐 WebSocket conectado, re-suscripción")
            self._resubscribe()
            return
        self.ws = WebSocketApp(
            WS_URL,
            on_open=self._on_open,
            on_message=self._on_message,
            on_error=self._on_error,
            on_close=self._on_close
        )
        wst = threading.Thread(target=self.ws.run_forever, daemon=True)
        wst.start()
        logger.info("🌐 WebSocket en hilo iniciado")

    def _resubscribe(self):
        interval = self.timeframe.replace("m", "")
        subscription = {
            "op": "subscribe",
            "args": [
                f"kline.{interval}.{self.symbol}",
                f"orderbook.50.{self.symbol}",
                f"tickers.{self.symbol}"
            ]
        }
        if self.ws and self.ws.sock and self.ws.sock.connected:
            try:
                self.ws.send(json.dumps(subscription))
                logger.info(f"📡 Suscripción enviada: {subscription}")
            except Exception as e:
                logger.error(f"❌ Error suscripción: {e}")

    def _on_open(self, ws):
        logger.info("🌐 WebSocket abierto")
        self._resubscribe()
        threading.Thread(
            target=lambda: [self.ws.send(json.dumps({"op": "ping"})) or time.sleep(10) for _ in iter(int, 1) if
                            self.running and self.ws.sock.connected],
            daemon=True
        ).start()

    def _on_message(self, ws, message: str):
        with SessionLocal() as db:
            try:
                data = json.loads(message)
                logger.debug(f"📨 Mensaje: {json.dumps(data, indent=2)}")
                if "op" in data:
                    if data["op"] == "subscribe":
                        logger.info(f"✅ Suscripción: {data.get('args', [])}" if data.get("success") else f"❌ Suscripción fallida: {data.get('ret_msg')}")
                        return
                    elif data["op"] == "ping":
                        logger.debug("📡 Pong recibido")
                        return
                if "topic" not in data:
                    return
                if "kline" in data["topic"]:
                    self._handle_kline(data["data"][0], db)
                elif "orderbook" in data["topic"]:
                    self.orderbook_data = {"bids": data["data"]["b"], "asks": data["data"]["a"]}
                    self._store_orderbook(db)
                elif "tickers" in data["topic"]:
                    self._handle_ticker(data["data"], db)
            except Exception as e:
                logger.error(f"❌ Error mensaje: {e}")

    def _on_error(self, ws, error):
        logger.error(f"❌ Error WebSocket: {error}")
        time.sleep(3)
        self._connect_websocket()

    def _on_close(self, ws, *args):
        logger.info("🔥 WebSocket cerrado")
        self._connect_websocket()

    def _handle_kline(self, kline: Dict, db: Session):
        timestamp = timestamp_to_datetime(int(kline["start"]))
        if not db.query(MarketData).filter_by(timestamp=timestamp, symbol=self.symbol).first():
            candle = MarketData(
                timestamp=timestamp,
                symbol=self.symbol,
                open=float(kline["open"]),
                high=float(kline["high"]),
                low=float(kline["low"]),
                close=float(kline["close"]),
                volume=float(kline["volume"])
            )
            db.add(candle)
            db.commit()
            self.candles = db.query(MarketData).filter_by(symbol=self.symbol).order_by(MarketData.timestamp.desc()).limit(5).all()
            self._execute_trade(db)
            logger.info(f"⚡ Kline: {timestamp}, Close: {candle.close}")

    def _store_orderbook(self, db: Session):
        orderbook = Orderbook(
            timestamp=datetime.now(timezone.utc),
            symbol=self.symbol,
            bids=json.dumps(self.orderbook_data["bids"]),
            asks=json.dumps(self.orderbook_data["asks"])
        )
        db.add(orderbook)
        db.commit()
        if time.time() - self.last_orderbook_log >= 5:
            logger.info(f"🤘 Orderbook actualizado")
            self.last_orderbook_log = time.time()

    def _handle_ticker(self, ticker: Dict, db: Session):
        self.ticker_data = {
            "last_price": float(ticker["lastPrice"]),
            "volume_24h": float(ticker["volume24h"]),
            "high_24h": float(ticker["highPrice24h"]),
            "low_24h": float(ticker["lowPrice24h"])
        }
        market_ticker = MarketTicker(
            timestamp=datetime.now(timezone.utc),
            symbol=self.symbol,
            last_price=self.ticker_data["last_price"],
            volume_24h=self.ticker_data["volume_24h"],
            high_24h=self.ticker_data["high_24h"],
            low_24h=self.ticker_data["low_24h"]
        )
        db.add(market_ticker)
        db.commit()
        logger.info(f"⚡ Ticker: {self.ticker_data['last_price']}")

    def _determine_decision(self):
        candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in
                       self.candles] if self.candles else []
        metrics = calculate_metrics(candle_data, self.orderbook_data, self.ticker_data)
        logger.info(f"📊 Métricas: {metrics}")
        recent_positions = self.positions[-10:] if len(self.positions) >= 10 else self.positions
        buy_count = sum(1 for pos in recent_positions if pos["action"] == "Buy")
        sell_count = len(recent_positions) - buy_count
        buy_sell_ratio = buy_count / (sell_count + 1)  # Evitar división por 0
        if metrics["combined"] > 0.5 and self.capital > Config.min_capital and buy_sell_ratio < 2.0:
            return "buy"
        elif metrics["combined"] < -0.5 and len(self.positions) > 0 and buy_sell_ratio > 0.5:
            return "sell"
        return "hold"

    def _place_order(self, action: str, quantity: float, price: float) -> Dict:
        logger.info(f"🛠️ Simulando {action}, Qty: {quantity:.6f}, Price: {price:.2f}")
        return {"success": True, "order_id": f"sim-{self.trade_id_counter}", "entry_price": price}

    def _close_order (self, order_id: str, action: str, quantity: float, entry_price: float, db: Session) -> Dict:
        try:
            if action not in ["Buy", "Sell"]:
                raise ValueError (f"Acción inválida: {action}")
            if entry_price <= 0:
                raise ValueError (f"Precio de entrada inválido: {entry_price}")
            exit_price = entry_price * (1.002 if action == "Buy" else 0.998)
            if exit_price <= 0:
                raise ValueError (f"Precio de salida inválido: {exit_price}")
            fee = (entry_price + exit_price) * quantity * Config.fee_rate
            profit_loss = (exit_price - entry_price - fee) * quantity if action == "Buy" else (
                                                                                                      entry_price - exit_price - fee) * quantity
            candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in
                           self.candles] if self.candles and len (self.candles) >= 2 else []
            if not candle_data:
                logger.warning ("⚠️ Usando métricas por defecto por falta de velas")
                metrics = {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0}
            else:
                metrics = calculate_metrics (candle_data, self.orderbook_data, self.ticker_data)
            while db.query (Trade).filter_by (trade_id=self.trade_id_counter).first ():
                logger.warning (f"⚠️ trade_id {self.trade_id_counter} ya existe, incrementando...")
                self.trade_id_counter += 1
            trade = Trade (
                trade_id=self.trade_id_counter,
                timestamp=datetime.now (timezone.utc),  # Aseguramos que el timestamp se establezca correctamente
                symbol=self.symbol,
                action=action,
                entry_price=entry_price,
                exit_price=exit_price,
                quantity=quantity,
                profit_loss=profit_loss,
                decision=action.lower (),
                combined=metrics ["combined"],
                ild=metrics ["ild"],
                egm=metrics ["egm"],
                rol=metrics ["rol"],
                pio=metrics ["pio"],
                ogm=metrics ["ogm"],
                risk_reward_ratio=1.5
            )
            db.add (trade)
            db.commit ()
            self.capital += profit_loss
            # Aseguramos que timestamp tenga un valor predeterminado o válido
            timestamp_value = trade.timestamp.isoformat () if trade.timestamp else None
            trade_dict = {
                "trade_id": trade.trade_id,
                "timestamp": timestamp_value,  # Utiliza timestamp_value
                "symbol": trade.symbol,
                "action": trade.action,
                "entry_price": trade.entry_price,
                "exit_price": trade.exit_price,
                "quantity": trade.quantity,
                "profit_loss": trade.profit_loss,
                "decision": trade.decision,
                "combined": trade.combined,
                "ild": trade.ild,
                "egm": trade.egm,
                "rol": trade.rol,
                "pio": trade.pio,
                "ogm": trade.ogm,
                "risk_reward_ratio": trade.risk_reward_ratio
            }
            self.positions.append (trade_dict)
            self.trade_id_counter += 1
            logger.info (f"🔥 Cierre: P&L={profit_loss:.2f}, Entry={entry_price:.2f}, Exit={exit_price:.2f}")
            return {"success": True, "exit_price": exit_price}
        except Exception as e:
            logger.error (f"❌ Error en _close_order: {e}", exc_info=True)
            db.rollback ()
            return {"success": False, "error": str (e)}

    def _execute_trade (self, db: Session):
        if not self.running or self.iterations >= Config.max_iterations:
            logger.info (f"🛑 Detenido: Iter={self.iterations}/{Config.max_iterations}")
            self.stop ()
            return
        decision = self._determine_decision ()
        logger.info (f"🔍 Decisión: {decision}")
        if decision == "hold":
            logger.info ("🎸 Hold")
            self.iterations += 1
            self._save_results (None)
            return
        if not self.ticker_data.get ("last_price"):
            logger.warning ("⚠️ Usando precio simulado: 80090.68")
            self.ticker_data ["last_price"] = 80090.68
        entry_price = float (self.ticker_data ["last_price"])
        quantity = max (min (Config.risk_factor * self.capital / entry_price, Config.max_trade_size),
                        Config.min_trade_size)
        logger.info (f"📏 Trade: {decision}, Price={entry_price:.2f}, Qty={quantity:.6f}")
        try:
            order_result = self._place_order (decision, quantity, entry_price)
            if not order_result ["success"]:
                logger.error (f"❌ Orden falló: {order_result.get ('error')}")
                self.iterations += 1
                self._save_results (None)
                return
            time.sleep (5)
            close_result = self._close_order (order_result ["order_id"], "Sell" if decision == "buy" else "Buy",
                                              quantity, entry_price, db)
            if not close_result ["success"]:
                logger.error (f"❌ Cierre falló: {close_result.get ('error')}")
                self.iterations += 1
                self._save_results (None)
                return
            exit_price = close_result ["exit_price"]
            profit_loss = (exit_price - entry_price) * quantity if decision == "buy" else (
                                                                                                      entry_price - exit_price) * quantity
            current_time = datetime.now (timezone.utc)
            trade = Trade (
                trade_id=self.trade_id_counter,
                timestamp=current_time,
                symbol=self.symbol,
                action=decision,
                entry_price=entry_price,
                exit_price=exit_price,
                quantity=quantity,
                profit_loss=profit_loss,
                decision=decision,
                combined=self._determine_decision_metrics () ["combined"],
                ild=self._determine_decision_metrics () ["ild"],
                egm=self._determine_decision_metrics () ["egm"],
                rol=self._determine_decision_metrics () ["rol"],
                pio=self._determine_decision_metrics () ["pio"],
                ogm=self._determine_decision_metrics () ["ogm"],
                risk_reward_ratio=1.5
            )
            db.add (trade)
            db.commit ()
            logger.info (f"📈 Guardado: ID={trade.trade_id}, P&L={profit_loss:.2f}")
            self.capital += profit_loss
            trade_result = {
                "trade_id": trade.trade_id,
                "timestamp": current_time.isoformat (),
                "symbol": self.symbol,
                "action": decision,
                "entry_price": entry_price,
                "exit_price": exit_price,
                "quantity": quantity,
                "profit_loss": profit_loss,
                "current_capital": self.capital
            }
            self._save_results (trade_result)
        except Exception as e:
            logger.error (f"❌ Error en _execute_trade: {e}", exc_info=True)
            db.rollback ()
            self._save_results (None)
        self.iterations += 1
        if decision != "hold":
            self.force_initial_trade = False
            self._analyze_problematic_trades ()
        logger.info (f"🔄 Iteración {self.iterations}, Capital={self.capital:.2f}")

    def _analyze_problematic_trades(self):
        problematic_trades = [pos for pos in self.positions if pos["combined"] < -5.0 or pos["profit_loss"] < 0]
        if problematic_trades:
            logger.warning(f"⚠️ Trades problemáticos detectados: {len(problematic_trades)}")
            for trade in problematic_trades:
                logger.info(f"Trade ID={trade['trade_id']}, Combined={trade['combined']:.2f}, P&L={trade['profit_loss']:.2f}")
        return problematic_trades

    def _save_results(self, trade_result: Dict):
        results = {
            "capital_inicial": Config.capital_usdt,
            "capital_final": self.capital,
            "total_pnl": self.capital - Config.capital_usdt,
            "trades": self.positions,
            "iterations": self.iterations
        }
        if trade_result:
            results["last_trade"] = trade_result
