@app.get("/profit")
async def get_profit(db: Session = Depends(get_db)):
    logger.info("📡 /profit")
    total_profit = 0.0
    total_loss = 0.0
    total_trades = 0
    profit_by_symbol = {}
    loss_by_symbol = {}

    for symbol in bot.symbols:
        symbol_profit = sum(trade["profit_loss"] for trade in bot.positions.get(symbol, []) if trade["profit_loss"] > 0)
        symbol_loss = sum(trade["profit_loss"] for trade in bot.positions.get(symbol, []) if trade["profit_loss"] < 0)
        profit_by_symbol[symbol] = round(symbol_profit, 2)
        loss_by_symbol[symbol] = round(symbol_loss, 2)
        total_profit += symbol_profit
        total_loss += symbol_loss
        total_trades += len(bot.positions.get(symbol, []))

    net_profit = total_profit + total_loss
    win_rate = (len([trade for symbol in bot.symbols for trade in bot.positions.get(symbol, []) if trade["profit_loss"] > 0]) / total_trades) if total_trades > 0 else 0

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "capital_inicial": Config.capital_usdt,
        "capital_actual": bot.capital,
        "total_pnl": round(bot.capital - Config.capital_usdt, 2),
        "total_profit": round(total_profit, 2),
        "total_loss": round(total_loss, 2),
        "net_profit": round(net_profit, 2),
        "win_rate": round(win_rate * 100, 2),
        "by_symbol": {
            symbol: {
                "profit": profit_by_symbol[symbol],
                "loss": loss_by_symbol[symbol],
                "net_profit": round(profit_by_symbol[symbol] + loss_by_symbol[symbol], 2),
                "trade_count": len(bot.positions.get(symbol, []))
            } for symbol in bot.symbols
        }
    }

