import aiohttp
import asyncio
import json
import websockets
import logging
from datetime import datetime, timezone
from models.database import MarketData, MarketTicker, Orderbook, execute_in_db
from utils.utils import timestamp_to_datetime, send_alert

logger = logging.getLogger("⚡ METAL ⚡")

class TradingEngine:
    def __init__(self, symbol: str, timeframe: str, capital: float):
        self.symbol = symbol
        self.timeframe = timeframe
        self.capital = capital
        self.candles = []
        self.orderbook_data = {"bids": [], "asks": []}
        self.ticker_data = {}
        self.positions = []
        self.ws_url = "wss://stream.bybit.com/v5/public/spot"
        self.running = False

