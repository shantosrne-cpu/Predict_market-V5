    def start(self):
        logger.info(f"🔥 Motor metalero iniciado para {self.symbol}")
        max_attempts = 5
        attempt = 0
        while attempt < max_attempts and self.running:
            try:
                self.fetch_initial_data()
                self._connect_websocket()
                break
            except Exception as e:
                logger.error(f"❌ Error al iniciar (intento {attempt + 1}/{max_attempts}): {e}")
                attempt += 1
                time.sleep(5)
        if attempt >= max_attempts:
            logger.critical("❌ Máximo de intentos alcanzado. Deteniendo bot.")
            self.stop()

    def _connect_websocket(self):
        if self.ws and self.ws.sock and self.ws.sock.connected:
            logger.info("🌐 WebSocket conectado, re-suscripción")
            self._resubscribe()
            return
        self.ws = WebSocketApp(
            WS_URL,
            on_open=self._on_open,
            on_message=self._on_message,
            on_error=self._on_error,
            on_close=self._on_close
        )
        wst = threading.Thread(target=self.ws.run_forever, daemon=True)
        wst.start()
        logger.info("🌐 WebSocket en hilo iniciado")

    def _resubscribe(self):
        interval = self.timeframe.replace("m", "")
        subscription = {
            "op": "subscribe",
            "args": [
                f"kline.{interval}.{self.symbol}",
                f"orderbook.50.{self.symbol}",
                f"tickers.{self.symbol}"
            ]
        }
        if self.ws and self.ws.sock and self.ws.sock.connected:
            try:
                self.ws.send(json.dumps(subscription))
                logger.info(f"📡 Suscripción enviada: {subscription}")
            except Exception as e:
                logger.error(f"❌ Error suscripción: {e}")

    def _on_open(self, ws):
        logger.info("🌐 WebSocket abierto")
        self._resubscribe()
        threading.Thread(
            target=lambda: [self.ws.send(json.dumps({"op": "ping"})) or time.sleep(10) for _ in iter(int, 1) if
                            self.running and self.ws.sock.connected],
            daemon=True
        ).start()

    def _on_message(self, ws, message: str):
        with SessionLocal() as db:
            try:
                data = json.loads(message)
                logger.debug(f"📨 Mensaje: {json.dumps(data, indent=2)}")
                if "op" in data:
                    if data["op"] == "subscribe":
                        logger.info(f"✅ Suscripción: {data.get('args', [])}" if data.get(
                            'success') else f"❌ Suscripción fallida: {data.get('ret_msg')}")
                        return
                    elif data["op"] == "ping":
                        logger.debug("📡 Pong recibido")
                        return
                if "topic" not in data:
                    return
                if "kline" in data["topic"]:
                    self._handle_kline(data["data"][0], db)
                elif "orderbook" in data["topic"]:
                    new_bids = data["data"]["b"]
                    new_asks = data["data"]["a"]
                    logger.debug(f"📊 Orderbook recibido: Bids={len(new_bids)}, Asks={len(new_asks)}")
                    filtered_bids = [bid for bid in new_bids if float(bid[1]) > 0]
                    filtered_asks = [ask for ask in new_asks if float(ask[1]) > 0]
                    if self._is_valid_orderbook(new_bids, new_asks):
                        self.orderbook_data = {"bids": filtered_bids, "asks": filtered_asks}
                        self._store_orderbook(db)
                    else:
                        logger.warning(
                            f"⚠️ Datos de orderbook inválidos después de filtrar: Bids={len(filtered_bids)}, Asks={len(filtered_asks)}, manteniendo datos previos")
                elif "tickers" in data["topic"]:
                    self._handle_ticker(data["data"], db)
            except Exception as e:
                logger.error(f"❌ Error mensaje: {e}")

    def _is_valid_orderbook(self, bids: List, asks: List) -> bool:
        valid_bids = [bid for bid in bids if float(bid[1]) > 0]
        valid_asks = [ask for ask in asks if float(ask[1]) > 0]
        return len(valid_bids) > 0 and len(valid_asks) > 0

    def _on_error(self, ws, error):
        logger.error(f"❌ Error WebSocket: {error}")
        time.sleep(3)
        self._connect_websocket()

    def _on_close(self, ws, *args):
        logger.info("🔥 WebSocket cerrado")
        self._connect_websocket()

    def _handle_kline(self, kline: Dict, db: Session):
        timestamp = timestamp_to_datetime(int(kline["start"]))
        if not db.query(MarketData).filter_by(timestamp=timestamp, symbol=self.symbol).first():
            candle = MarketData(
                timestamp=timestamp,
                symbol=self.symbol,
                open=float(kline["open"]),
                high=float(kline["high"]),
                low=float(kline["low"]),
                close=float(kline["close"]),
                volume=float(kline["volume"])
            )
            self.candles = db.query(MarketData).filter_by(symbol=self.symbol).order_by(
                MarketData.timestamp.desc()).limit(5).all()
            if candle.volume <= 0.0001 and any(c.volume > 0.0001 for c in self.candles):
                logger.warning(f"⚠️ Volumen insuficiente ({candle.volume}) en {timestamp}, ignorando vela")
                return
            db.add(candle)
            db.commit()
            candle_data = {
                "timestamp": timestamp.isoformat(),
                "symbol": self.symbol,
                "open": candle.open,
                "high": candle.high,
                "low": candle.low,
                "close": candle.close,
                "volume": candle.volume
            }
