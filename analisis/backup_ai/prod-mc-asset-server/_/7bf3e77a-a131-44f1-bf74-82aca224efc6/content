                                    symbol=self.symbol,
                                    last_price=self.ticker_data["last_price"],
                                    volume_24h=self.ticker_data["volume_24h"],
                                    high_24h=self.ticker_data["high_24h"],
                                    low_24h=self.ticker_data["low_24h"]
                                )
                                db.add(ticker)
                                db.commit()
                            await execute_in_db(save_ticker)
                        else:
                            logger.error(f"Ticker inesperado: {ticker_response}")
                    else:
                        logger.error(f"Error ticker: {response.status} - {await response.text()}")

            except Exception as exc:
                logger.error(f"Fetch inicial falló: {exc}")
                await self._load_fallback_data()

    async def _load_fallback_data(self):
        logger.info("Cargando datos de respaldo...")
        # Implementar lógica de respaldo si es necesario
        pass

    async def start(self):
        logger.info(f"Motor metalero iniciado para {self.symbol}")
        await self.fetch_initial_data()
        self.running = True
        asyncio.create_task(self.run_websocket())

    async def stop(self):
        self.running = False

    async def run_websocket(self):
        async with websockets.connect(self.ws_url) as ws:
            subscription_message = {
                "op": "subscribe",
                "args": [f"kline.{self.timeframe}.{self.symbol}", f"orderbook.50.{self.symbol}", f"tickers.{self.symbol}"]
            }
            await ws.send(json.dumps(subscription_message))
            logger.info(f"Suscripción enviada: {subscription_message}")
            while self.running:
                try:
                    message = await ws.recv()
                    data = json.loads(message)
                    if "success" in data:
                        logger.info("Suscripción confirmada")
                    elif data.get("topic") == f"kline.{self.timeframe}.{self.symbol}":
                        await self.process_kline(data["data"])
                    elif data.get("topic") == f"orderbook.50.{self.symbol}":
                        await self.process_orderbook(data)
                    elif data.get("topic") == f"tickers.{self.symbol}":
                        await self.process_ticker(data["data"])
                except Exception as exc:
                    logger.error(f"Error en WebSocket: {exc}")
                    break

    async def process_kline(self, data):
        kline = data[0]
        logger.debug(f"Kline recibido: {kline}")
        candle = MarketData(
            timestamp=timestamp_to_datetime(kline["timestamp"] / 1000),
            symbol=self.symbol,
            open=float(kline["open"]),
            high=float(kline["high"]),
            low=float(kline["low"]),
            close=float(kline["close"]),
            volume=float(kline["volume"])
        )
        self.candles.append(candle)
        if len(self.candles) > 100:
            self.candles.pop(0)
        def save_kline(db):
            if not db.query(MarketData).filter(MarketData.timestamp == candle.timestamp, MarketData.symbol == self.symbol).first():
                db.add(candle)
            db.commit()
        await execute_in_db(save_kline)

    async def process_ticker(self, data):
        self.ticker_data = {
            "last_price": float(data["lastPrice"]),
            "volume_24h": float(data["volume24h"]),
            "high_24h": float(data["highPrice24h"]),
            "low_24h": float(data["lowPrice24h"])
        }
        usd_index_price = data.get("usdIndexPrice")
        if usd_index_price:
            logger.debug(f"USD Index Price: {usd_index_price}")
        else:
            logger.warning("USD Index Price no disponible")
        ticker = MarketTicker(
            timestamp=datetime.now(timezone.utc),
            symbol=self.symbol,
            last_price=self.ticker_data["last_price"],
            volume_24h=self.ticker_data["volume_24h"],
            high_24h=self.ticker_data["high_24h"],
            low_24h=self.ticker_data["low_24h"]
        )
        def save_ticker(db):
            db.add(ticker)
            db.commit()
        await execute_in_db(save_ticker)

    async def process_orderbook(self, data):
        if data["type"] == "snapshot":
            self.orderbook_data = {"bids": data["data"]["b"], "asks": data["data"]["a"]}
        else:  # delta
            for bid in data["data"]["b"]:
                price, quantity = bid
                self.orderbook_data["bids"] = [b for b in self.orderbook_data["bids"] if b[0] != price]
                if float(quantity) > 0:
                    self.orderbook_data["bids"].append(bid)
            for ask in data["data"]["a"]:
                price, quantity = ask
                self.orderbook_data["asks"] = [a for a in self.orderbook_data["asks"] if a[0] != price]
                if float(quantity) > 0:
                    self.orderbook_data["asks"].append(ask)
        orderbook = Orderbook(
            timestamp=datetime.now(timezone.utc),
            symbol=self.symbol,
            bids=self.orderbook_data["bids"],
            asks=self.orderbook_data["asks"]
        )
        def save_orderbook(db):
            db.add(orderbook)
            db.commit()
        await execute_in_db(save_orderbook)