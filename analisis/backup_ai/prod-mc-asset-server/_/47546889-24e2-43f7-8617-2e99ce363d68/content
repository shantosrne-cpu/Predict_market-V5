import hashlib
import hmac
import json
import logging
import os
from datetime import datetime, timezone
from typing import List, Dict, Tuple

import numpy as np

logger = logging.getLogger("NertzMetalEngine")

def calculate_metrics(candle_data: List[Dict[str, float]], orderbook_data: Dict[str, List[List[str]]], ticker_data: Dict[str, float], depth: int = 5) -> Dict[str, float]:
    if not all([candle_data, len(candle_data) >= 2, orderbook_data.get("bids"), orderbook_data.get("asks"), ticker_data.get('last_price')]):
        logger.warning("Datos insuficientes para métricas, devolviendo valores por defecto")
        return {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0, "volatility": 0.0}

    try:
        last_price: float = float(ticker_data["last_price"])

        if all(float(c.get("volume", 0)) <= 0.0001 for c in candle_data):
            logger.warning("Volumen bajo detectado, ajustando velas")
            candle_data = candle_data[-2:]

        closes: np.ndarray = np.array([float(c["close"]) for c in candle_data[-5:]], dtype=np.float64)
        highs: np.ndarray = np.array([float(c.get("high", 0)) for c in candle_data[-5:] if c.get("high") is not None], dtype=np.float64)
        lows: np.ndarray = np.array([float(c.get("low", 0)) for c in candle_data[-5:] if c.get("low") is not None], dtype=np.float64)
        volumes: np.ndarray = np.array([float(c.get("volume", 0)) for c in candle_data[-5:] if c.get("volume") is not None], dtype=np.float64)

        if len(highs) == 0 or len(lows) == 0:
            logger.warning("Datos insuficientes para calcular altos y bajos, devolviendo valores por defecto")
            return {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0, "volatility": 0.0}

        avg_price: float = float(np.mean(closes))
        price_range: float = float(max(highs.max() - lows.min(), 1e-8))
        volatility: float = (highs.max() - lows.min()) / last_price

        bids: List[List[str]] = orderbook_data["bids"][:depth]
        asks: List[List[str]] = orderbook_data["asks"][:depth]
        bid_volume: float = sum(float(bid[1]) for bid in bids if float(bid[1]) > 0)
        ask_volume: float = sum(float(ask[1]) for ask in asks if float(ask[1]) > 0)
        total_volume: float = bid_volume + ask_volume + 1e-6
        ild: float = np.clip((bid_volume - ask_volume) / total_volume, -1.0, 1.0)  # Asegurar rango

        egm: float = np.clip((last_price - avg_price) / price_range, -1.0, 1.0)

        bid_value: float = sum(float(bid[0]) * float(bid[1]) for bid in bids if float(bid[1]) > 0)
        ask_value: float = sum(float(ask[0]) * float(ask[1]) for ask in asks if float(ask[1]) > 0)
        total_value: float = bid_value + ask_value + 1e-6
        rol: float = np.clip((bid_value - ask_value) / total_value, -1.0, 1.0)  # Asegurar rango

        pio: float = 0.0
        if len(volumes) >= 2:
            avg_volume: float = float(np.mean(volumes[1:]))
            pio = np.clip((volumes[0] - avg_volume) / (avg_volume + 1e-6), -1.0, 1.0)

        best_bid: float = float(bids[0][0]) if bids else last_price
        best_ask: float = float(asks[0][0]) if asks else last_price
        spread: float = (best_ask - best_bid) / last_price
        ogm: float = 1.0 - np.clip(spread / 0.02, 0, 1.0)

        combined: float = np.clip((0.4 * egm + 0.2 * ild + 0.2 * rol + 0.1 * pio + 0.1 * ogm) * 10, -10.0, 10.0)

        logger.debug(f"Métricas: combined={combined:.2f}, ild={ild:.4f}, egm={egm:.4f}, rol={rol:.4f}, pio={pio:.4f}, ogm={ogm:.4f}, volatility={volatility:.4f}")
        return {
            "combined": float(combined),
            "ild": float(ild),
            "egm": float(egm),
            "rol": float(rol),
            "pio": float(pio),
            "ogm": float(ogm),
            "volatility": float(volatility)
        }
    except Exception as e:
        logger.error(f"Error en calculate_metrics: {e}", exc_info=True)
        return {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0, "volatility": 0.0}


def generate_signature (api_secret: str, params: dict) -> str:
    """
    Genera una firma HMAC SHA256 para la solicitud de la API de Bybit.

    :param api_secret: La clave secreta de la API.
    :param params: Los parámetros de la solicitud.
    :return: La firma generada.
    """
    sorted_params = "&".join ([f"{k}={v}" for k, v in sorted (params.items ())])
    return hmac.new (api_secret.encode (), sorted_params.encode (), hashlib.sha256).hexdigest ()


def sanitize_filename (filename: str) -> str:
    """
    Sanitiza el nombre del archivo eliminando cualquier ruta.

    :param filename: El nombre del archivo a sanitizar.
    :return: El nombre del archivo sin ruta.
    """
    return os.path.basename (filename)


def save_results (results: dict, log_dir: str = "logs") -> None:
    """
    Guarda los resultados en un archivo JSON en el directorio especificado.

    :param results: Los resultados a guardar.
    :param log_dir: El directorio donde se guardará el archivo.
    """
    log_dir = os.path.abspath (log_dir)
    os.makedirs (log_dir, exist_ok=True)
    filepath = os.path.join (log_dir, "results.json")
    with open (filepath, "w", encoding="utf-8") as f:
        json.dump (results, f, indent=4)
    logger.info (f"📈 Resultados guardados en {filepath}")


def timestamp_to_datetime (timestamp_ms: int) -> datetime:
    """
    Convierte un timestamp en milisegundos a un objeto datetime.

    :param timestamp_ms: El timestamp en milisegundos.
    :return: El objeto datetime correspondiente.
    """
    return datetime.fromtimestamp (timestamp_ms / 1000, tz=timezone.utc)

def calculate_tp_sl(price: float, volatility: float, action: str, tp_factor: float = 1.5, sl_factor: float = 1.0) -> Tuple[float, float]:
    """Calcula Take Profit y Stop Loss dinámicos basados en volatilidad."""
    try:
        price_range = volatility * price
        if action.lower() == "buy":
            tp = price + (price_range * tp_factor)
            sl = price - (price_range * sl_factor)
        else:  # sell
            tp = price - (price_range * tp_factor)
            sl = price + (price_range * sl_factor)
        return round(tp, 2), round(sl, 2)
    except Exception as e:
        logger.error(f"❌ Error en calculate_tp_sl: {e}")
        return 0.0, 0.0

# Clase TpslStrategy
class BaseTradingStrategy:
    def __init__(self, connector=None, data_manager=None, **kwargs):
        self.logger = logging.getLogger("NertzMetalEngine")
        self.connector = connector
        self.data_manager = data_manager

def evaluate_trend(short_ema: float, mid_ema: float, long_ema: float) -> Tuple[str, str]:
    """Evalúa la tendencia para decidir la acción de trading."""
    if short_ema > mid_ema > long_ema:
        return "BUY", "Cruzamiento alcista de Triple EMA"
    elif short_ema < mid_ema < long_ema:
        return "SELL", "Cruzamiento bajista de Triple EMA"
    return "HOLD", "No hay confirmación clara"

class TpslStrategy(BaseTradingStrategy):
    def __init__(self, connector=None, data_manager=None, short_window=5, mid_window=10, long_window=20,
                 tp_percentage=1.5, sl_percentage=0.75, **kwargs):
        super().__init__(connector, data_manager, **kwargs)
        self.short_window = short_window
        self.mid_window = mid_window
        self.long_window = long_window
        self.tp_percentage = tp_percentage  # En porcentaje (ej. 1.5 = 1.5%)
        self.sl_percentage = sl_percentage  # En porcentaje (ej. 0.75 = 0.75%)

    def calculate_ema(self, prices: List[float], window: int) -> float:
        """Calcula EMA de manera pura en Python."""
        if len(prices) < window:
            return sum(prices[-window:]) / min(len(prices), window)  # SMA si no hay suficientes datos
        alpha = 2 / (window + 1)
        ema = prices[-window]  # Primer valor como SMA inicial
        for price in prices[-window + 1:]:
            ema = (price * alpha) + (ema * (1 - alpha))
        return ema

    def generate_signal(self, market_data: Dict) -> Dict:
        """Genera señales basadas en Triple EMA y TP/SL."""
        if "close_prices" not in market_data or not market_data["close_prices"]:
            self.logger.warning("⚠️ Faltan datos de 'close_prices' en market_data.")
            return {"action": "HOLD", "confidence": 0.0, "take_profit": 0.0, "stop_loss": 0.0, "reason": "Sin datos"}

        closing_prices = market_data["close_prices"]

        if len(closing_prices) < self.long_window:
            self.logger.warning(f"⚠️ No hay suficientes datos (mínimo {self.long_window} precios).")
            return {"action": "HOLD", "confidence": 0.0, "take_profit": 0.0, "stop_loss": 0.0,
                    "reason": "Datos insuficientes"}

        short_ema = self.calculate_ema(closing_prices, self.short_window)
        mid_ema = self.calculate_ema(closing_prices, self.mid_window)
        long_ema = self.calculate_ema(closing_prices, self.long_window)

        latest_price = closing_prices[-1]
        action, reason = evaluate_trend(short_ema, mid_ema, long_ema)
        take_profit, stop_loss = self.calculate_take_profit_stop_loss(latest_price, action)

        return {
            "action": action,
            "confidence": 0.9 if action in ["BUY", "SELL"] else 0.5,
            "take_profit": take_profit,
            "stop_loss": stop_loss,
            "reason": reason
        }

    def calculate_take_profit_stop_loss(self, latest_price: float, action: str) -> Tuple[float, float]:
        """Calcula el nivel de Take Profit y Stop Loss."""
        if action == "BUY":
            take_profit = latest_price * (1 + self.tp_percentage / 100)
            stop_loss = latest_price * (1 - self.sl_percentage / 100)
        elif action == "SELL":
            take_profit = latest_price * (1 - self.tp_percentage / 100)
            stop_loss = latest_price * (1 + self.sl_percentage / 100)
        else:
            take_profit = stop_loss = 0.0
        return round(take_profit, 2), round(stop_loss, 2)