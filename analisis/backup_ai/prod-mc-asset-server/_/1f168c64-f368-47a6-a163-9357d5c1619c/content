            "trades": [
                {
                    "trade_id": t.trade_id if hasattr(t, "trade_id") else t.get("trade_id"),
                    "timestamp": t.timestamp.isoformat() + "Z" if hasattr(t, "timestamp") else t.get("timestamp"),
                    "action": t.action if hasattr(t, "action") else t.get("action"),
                    "entry_price": t.entry_price if hasattr(t, "entry_price") else t.get("entry_price"),
                    "exit_price": t.exit_price if hasattr(t, "exit_price") else t.get("exit_price"),
                    "quantity": t.quantity if hasattr(t, "quantity") else t.get("quantity"),
                    "profit_loss": t.profit_loss if hasattr(t, "profit_loss") else t.get("profit_loss"),
                    "combined": t.combined if hasattr(t, "combined") else t.get("combined"),
                    "ild": t.ild if hasattr(t, "ild") else t.get("ild"),
                    "egm": t.egm if hasattr(t, "egm") else t.get("egm"),
                    "rol": t.rol if hasattr(t, "rol") else t.get("rol"),
                    "pio": t.pio if hasattr(t, "pio") else t.get("pio"),
                    "ogm": t.ogm if hasattr(t, "ogm") else t.get("ogm"),
                    "risk_reward_ratio": t.risk_reward_ratio if hasattr(t, "risk_reward_ratio") else t.get("risk_reward_ratio")
