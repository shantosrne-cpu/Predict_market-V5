import json
import threading
import time
from websocket import WebSocketApp
from config.config import WS_URL
from utils.logger import logger

class WebSocketService:
    def __init__(self):
        self.ws = None
        self.running = False
        self.engine = None
        self.error_count = 0
        self.last_message_id = None

    async def start(self, engine):
        self.engine = engine
        self.running = True
        await self._connect()

    def stop(self):
        self.running = False
        if self.ws:
            self.ws.close()

    async def _connect(self):
        if self.ws and self.ws.sock and self.ws.sock.connected:
            logger.info("WebSocket conectado, re-suscripción")
            self._resubscribe()
            return
        self.ws = WebSocketApp(
            WS_URL,
            on_open=self._on_open,
            on_message=self._on_message,
            on_error=self._on_error,
            on_close=self._on_close
        )
        threading.Thread(target=self.ws.run_forever, daemon=True).start()
        logger.info("WebSocket en hilo iniciado")

    def _resubscribe(self):
        interval = self.engine.timeframe.replace("m", "")
        subscription = {
            "op": "subscribe",
            "args": [
                f"kline.{interval}.{self.engine.symbol}",
                f"orderbook.50.{self.engine.symbol}",
                f"tickers.{self.engine.symbol}"
            ]
        }
        if self.ws and self.ws.sock and self.ws.sock.connected:
            self.ws.send(json.dumps(subscription))
            logger.info(f"Suscripción enviada: {subscription}")

    def _on_open(self, ws):
        logger.info("WebSocket abierto")
        self._resubscribe()
        self.error_count = 0
        threading.Thread(
            target=lambda: [self.ws.send(json.dumps({"op": "ping"})) or time.sleep(10)
                          for _ in iter(int, 1) if self.running and self.ws.sock.connected],
            daemon=True
        ).start()

    def _on_message(self, ws, message: str):
        try:
            logger.debug(f"Mensaje recibido: {message}")
            data = json.loads(message)
            if "id" in data and data["id"] == self.last_message_id:
                logger.debug("Mensaje duplicado ignorado")
                return
            self.last_message_id = data.get("id")
            if "op" in data:
                if data["op"] == "subscribe" and data.get("success"):
                    logger.info("Suscripción confirmada")
                    return
                elif data["op"] == "ping" and data.get("success"):
                    logger.debug("Pong recibido")
                    return
            if "topic" in data and "data" in data:
                if "kline" in data["topic"]:
                    if data["data"] and isinstance(data["data"], list) and len(data["data"]) > 0:
                        self.engine.handle_kline(data["data"][0])
                    else:
                        logger.warning("Datos de kline inválidos")
                elif "orderbook" in data["topic"]:
                    if "b" in data["data"] and "a" in data["data"]:
                        self.engine.orderbook_data = {"bids": data["data"]["b"], "asks": data["data"]["a"]}
                        self.engine.store_orderbook()
                    else:
                        logger.warning("Datos de orderbook inválidos")
                elif "tickers" in data["topic"]:
                    if data["data"]:
                        self.engine.handle_ticker(data["data"])
                    else:
                        logger.warning("Datos de tickers inválidos")
            else:
                logger.warning(f"Mensaje inesperado: {data}")
        except json.JSONDecodeError as e:
            logger.error(f"Error decodificando JSON: {e}")
        except Exception as e:
            logger.error(f"Error mensaje: {e}")

    def _on_error(self, ws, error):
        logger.error(f"Error WebSocket: {error}")
        if self.running:
            delay = min(3 * (2 ** min(self.error_count, 5)), 60)
            self.error_count += 1
            time.sleep(delay)
            self._connect()

    def _on_close(self, ws, *args):
        logger.info("WebSocket cerrado")
        if self.running:
            self._connect()