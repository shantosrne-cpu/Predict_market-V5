@app.get("/pnl/{symbol}")
async def get_pnl(symbol: str, engine: services.trading_engine.TradingEngine = Depends(get_engine)):
    logger.info(f"📡 /pnl/{symbol}")
    trades = []

    def load_trades(db):
        try:
            trades.extend(db.query(Trade).filter(Trade.symbol == symbol)
                          .order_by(Trade.timestamp.desc()).all())
        except Exception as exc:
            logger.error(f"❌ Error al cargar trades para PNL: {exc}")
            raise

    try:
        execute_in_db(load_trades)
        if not trades:
            logger.warning(f"⚠️ No se encontraron trades para {symbol}")
            return {
                "symbol": symbol,
                "total_pnl": 0.0,
                "trades_count": 0,
                "message": "No trades found"
            }
        total_pnl = sum(trade.profit_loss for trade in trades)
        return {
            "symbol": symbol,
            "total_pnl": total_pnl,
            "trades_count": len(trades),
            "timestamp": datetime.now(timezone.utc).isoformat() + "Z"
        }
    except Exception as exc:
        logger.error(f"❌ Error en /pnl: {exc}")
        raise HTTPException(status_code=500, detail=f"Error interno: {str(exc)}")