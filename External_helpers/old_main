                try:
                    return float(raw)
                except (TypeError, ValueError):
                    continue
            return 0.0
        except Exception:
            return None

    async def _reconcile_open_position_with_wallet(self, symbol: str, order_id: str) -> bool:
        filled_statuses = {"filled", "partiallyfilled", "partiallyfilledcanceled"}
        cancelled_statuses = {"cancelled", "canceled", "rejected", "deactivated"}
        with SessionLocal() as db:
            trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
            position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
            if not trade or not position:
                return False
            if position.symbol != symbol:
                return False
            if position.status not in ["open", "closing"]:
                return False
            action = str(trade.action).lower()
            if action == "sell" and bool(getattr(config, "SPOT_LONG_ONLY", True)):
                try:
                    session = HTTP(
                        testnet=config.USE_TESTNET,
                        api_key=config.BYBIT_API_KEY,
                        api_secret=config.BYBIT_API_SECRET
                    )
                    info = await self._fetch_spot_order_history_info(session, symbol, order_id, getattr(trade, "order_link_id", None))
                    if not info:
                        return False
                    resolved_order_id = info.get("orderId")
                    if resolved_order_id and str(resolved_order_id) != str(trade.order_id):
                        old_order_id = str(trade.order_id)
                        new_order_id = str(resolved_order_id)
                        trade.order_id = new_order_id
                        position.order_id = new_order_id
                        db.commit()
                        self._migrate_internal_order_key(symbol, old_order_id, new_order_id)
                        order_id = new_order_id
                    status = str(info.get("orderStatus", "")).lower()
                    if status in filled_statuses:
                        executed_qty = float(info.get("cumExecQty", "0.0") or 0.0)
                        avg_price = float(info.get("avgPrice") or 0.0)
                        if avg_price <= 0 and executed_qty > 0:
                            cum_exec_value = float(info.get("cumExecValue") or 0.0)
                            if cum_exec_value > 0:
                                avg_price = cum_exec_value / executed_qty
                        exit_price = avg_price if avg_price > 0 else float(trade.entry_price)
                        qty_used = executed_qty if executed_qty > 0 else float(position.quantity or 0.0)
                        entry_price = float(position.entry_price or trade.entry_price or 0.0)
                        fee_usdt = self._spot_order_fee_usdt(symbol, info)
                        pnl = 0.0
                        if qty_used > 0 and entry_price > 0 and exit_price > 0:
                            pnl = (exit_price - entry_price) * qty_used
                            pnl -= fee_usdt
                        trade.exit_price = exit_price
                        trade.profit_loss = pnl
                        trade.decision = "closed_external"
                        position.status = "closed"
                        db.commit()

                        task = self.order_status_tasks.get(order_id)
                        if task and not task.done():
                            task.cancel()
                        self.order_status_tasks.pop(order_id, None)
                        self.exit_orders.pop(order_id, None)

                        updates = {
                            "status": "closed",
                            "exit_price": exit_price,
                            "profit_loss": pnl,
                            "decision": "closed_external",
                            "exit_order_id": None,
                        }
                        if fee_usdt > 0:
                            updates["fees_usdt"] = fee_usdt
                        self._update_position_cache(symbol, order_id, updates)

                        self.capital = await self.fetch_real_balance()
                        with SessionLocal() as inner_db:
                            refreshed = inner_db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                            if refreshed:
                                await self._save_results(symbol, refreshed)
                        return True

                    if status in cancelled_statuses:
                        trade.exit_price = None
                        trade.profit_loss = 0.0
                        trade.decision = "cancelled"
                        position.status = "cancelled"
                        db.commit()

                        self._update_position_cache(symbol, order_id, {
                            "status": "cancelled",
                            "exit_price": None,
                            "profit_loss": 0.0,
                            "decision": "cancelled",
                            "exit_order_id": None,
                        })
                        with SessionLocal() as inner_db:
                            refreshed = inner_db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                            if refreshed:
                                await self._save_results(symbol, refreshed)
                        return True
                    return False
                except Exception:
                    return False
            if action != "buy":
                return False
            position_qty = float(position.quantity or 0.0)
            order_link_id = getattr(trade, "order_link_id", None) or getattr(position, "order_link_id", None)

        base_coin, _quote = self._split_symbol_base_quote(symbol)
        if not base_coin:
            return False

        if config.BYBIT_API_KEY and config.BYBIT_API_SECRET:
            try:
                session = HTTP(
                    testnet=config.USE_TESTNET,
                    api_key=config.BYBIT_API_KEY,
                    api_secret=config.BYBIT_API_SECRET
                )

                entry_info = await self._fetch_spot_order_history_info(session, symbol, order_id, order_link_id)
                if entry_info:
                    entry_status = str(entry_info.get("orderStatus", "") or "").lower()
                    entry_exec_qty = float(entry_info.get("cumExecQty", "0.0") or 0.0)
                    if entry_status in cancelled_statuses and entry_exec_qty <= 0:
                        with SessionLocal() as db:
                            trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                            position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                            if not trade or not position:
                                return False
                            trade.exit_price = None
                            trade.profit_loss = 0.0
                            trade.decision = "cancelled"
                            position.status = "cancelled"
                            db.commit()

                        task = self.order_status_tasks.get(order_id)
                        if task and not task.done():
                            task.cancel()
                        self.order_status_tasks.pop(order_id, None)
                        self.exit_orders.pop(order_id, None)

                        self._update_position_cache(symbol, order_id, {
                            "status": "cancelled",
                            "exit_price": None,
                            "profit_loss": 0.0,
                            "decision": "cancelled",
                            "exit_order_id": None,
                        })
                        with SessionLocal() as inner_db:
                            refreshed = inner_db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                            if refreshed:
                                await self._save_results(symbol, refreshed)
                        return True

                exit_order_id = self.exit_orders.get(order_id)
                discovered = None
                if not exit_order_id:
                    discovered = await self._discover_exit_order(symbol, parent_order_id=order_id, action="buy")
                    discovered_id = (discovered or {}).get("orderId")
                    if discovered_id:
                        exit_order_id = str(discovered_id)
                        self.exit_orders[order_id] = exit_order_id

                if exit_order_id:
                    exit_info = await self._fetch_spot_order_history_info(
                        session,
                        symbol,
                        str(exit_order_id),
                        (discovered or {}).get("orderLinkId"),
                    )
                    if exit_info:
                        exit_status = str(exit_info.get("orderStatus", "") or "").lower()
                        if exit_status in filled_statuses:
                            realized = None
                            if entry_info:
                                realized = self._compute_spot_realized_pnl_usdt(symbol, entry_info, exit_info, "buy")
                            if realized:
                                exit_price = float(realized.get("exit_avg_price") or 0.0)
                                pnl = float(realized.get("pnl_net_usdt") or 0.0)
                                qty_used = float(realized.get("qty_executed") or 0.0)
                                entry_avg = float(realized.get("entry_avg_price") or 0.0)
                            else:
                                last_price = float(self.ticker_data.get(symbol, {}).get("last_price", 0.0) or 0.0)
                                exit_price = float(exit_info.get("avgPrice") or 0.0) or last_price
                                with SessionLocal() as db:
                                    trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                                    position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                                    if not trade or not position:
                                        return False
                                    entry_price = float(position.entry_price or trade.entry_price or 0.0)
                                    qty_used = float(position.quantity or 0.0)
                                pnl = (exit_price - entry_price) * qty_used if exit_price and entry_price and qty_used else 0.0
                                entry_avg = 0.0

                            with SessionLocal() as db:
                                trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                                position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                                if not trade or not position:
                                    return False
                                if entry_avg > 0:
                                    trade.entry_price = entry_avg
                                    position.entry_price = entry_avg
                                if qty_used > 0:
                                    trade.quantity = qty_used
                                    position.quantity = qty_used
                                trade.exit_price = exit_price
                                trade.profit_loss = pnl
                                trade.decision = "closed_external"
                                position.status = "closed"
                                db.commit()

                            task = self.order_status_tasks.get(order_id)
                            if task and not task.done():
                                task.cancel()
                            self.order_status_tasks.pop(order_id, None)
                            self.exit_orders.pop(order_id, None)

                            updates = {
                                "status": "closed",
                                "exit_price": exit_price,
                                "profit_loss": pnl,
                                "decision": "closed_external",
                                "exit_order_id": exit_order_id,
                            }
                            if realized:
                                updates.update({
                                    "entry_value_usdt": float(realized.get("entry_value_usdt") or 0.0),
                                    "exit_value_usdt": float(realized.get("exit_value_usdt") or 0.0),
                                    "fees_usdt": float(realized.get("fees_usdt") or 0.0),
                                    "pnl_gross_usdt": float(realized.get("pnl_gross_usdt") or 0.0),
                                    "pnl_net_usdt": float(realized.get("pnl_net_usdt") or 0.0),
                                })
                            self._update_position_cache(symbol, order_id, updates)

                            self.capital = await self.fetch_real_balance()
                            with SessionLocal() as inner_db:
                                refreshed = inner_db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                                if refreshed:
                                    await self._save_results(symbol, refreshed)
                            return True

                        if exit_status in cancelled_statuses:
                            self.exit_orders.pop(order_id, None)
                            with SessionLocal() as db:
                                position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                                if position and position.status == "closing":
                                    position.status = "open"
                                    db.commit()
                                    self._update_position_cache(symbol, order_id, {
                                        "status": "open",
                                        "exit_order_id": None,
                                    })
                            return True
            except Exception:
                pass

        held_qty = await self._fetch_coin_total_balance(base_coin)
        if held_qty is None:
            return False

        dust_threshold = float(getattr(config, "SPOT_POSITION_DUST_THRESHOLD", 1e-8))
        partial_threshold_ratio = float(getattr(config, "SPOT_POSITION_PARTIAL_THRESHOLD_RATIO", 0.98))

        if held_qty <= dust_threshold:
            with SessionLocal() as db:
                trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                if not trade or not position:
                    return False
                if position.status not in ["open", "closing"]:
                    return False

                last_price = float(self.ticker_data.get(symbol, {}).get("last_price", 0.0) or 0.0)
                exit_order_id = self.exit_orders.get(order_id)
                realized = None

                if config.BYBIT_API_KEY and config.BYBIT_API_SECRET:
                    try:
                        session = HTTP(
                            testnet=config.USE_TESTNET,
                            api_key=config.BYBIT_API_KEY,
                            api_secret=config.BYBIT_API_SECRET
                        )
                        entry_info = await self._fetch_spot_order_history_info(
                            session,
                            symbol,
                            order_id,
                            getattr(trade, "order_link_id", None),
                        )
                        discovered = None
                        if not exit_order_id:
                            discovered = await self._discover_exit_order(symbol, parent_order_id=order_id, action=trade.action)
                            discovered_id = (discovered or {}).get("orderId")
                            if discovered_id:
                                exit_order_id = str(discovered_id)
                                self.exit_orders[order_id] = exit_order_id
                        exit_info = None
                        if exit_order_id:
                            exit_info = await self._fetch_spot_order_history_info(
                                session,
                                symbol,
                                str(exit_order_id),
                                (discovered or {}).get("orderLinkId"),
                            )
                        if entry_info and exit_info:
                            realized = self._compute_spot_realized_pnl_usdt(symbol, entry_info, exit_info, trade.action)
                    except Exception:
                        realized = None

                if realized:
                    exit_price = float(realized.get("exit_avg_price") or 0.0) or (last_price if last_price > 0 else float(trade.entry_price))
                    pnl = float(realized.get("pnl_net_usdt") or 0.0)
                    qty_used = float(realized.get("qty_executed") or 0.0)
                    entry_avg = float(realized.get("entry_avg_price") or 0.0)
                    if entry_avg > 0:
                        trade.entry_price = entry_avg
                        position.entry_price = entry_avg
                    if qty_used > 0:
                        trade.quantity = qty_used
                        position.quantity = qty_used

                    pnl_details = {
                        "entry_value_usdt": float(realized.get("entry_value_usdt") or 0.0),
                        "exit_value_usdt": float(realized.get("exit_value_usdt") or 0.0),
                        "fees_usdt": float(realized.get("fees_usdt") or 0.0),
                        "pnl_gross_usdt": float(realized.get("pnl_gross_usdt") or 0.0),
                        "pnl_net_usdt": float(realized.get("pnl_net_usdt") or 0.0),
                    }
                else:
                    exit_price = last_price if last_price > 0 else float(trade.entry_price)
                    entry_price = float(trade.entry_price)
                    qty = float(position.quantity or 0.0)
                    pnl = (exit_price - entry_price) * qty
                    pnl *= (1 - config.FEE_RATE)

                    pnl_details = {}

                trade.exit_price = exit_price
                trade.profit_loss = pnl
                trade.decision = "closed_external"
                position.status = "closed"
                db.commit()

            task = self.order_status_tasks.get(order_id)
            if task and not task.done():
                task.cancel()
            self.order_status_tasks.pop(order_id, None)
            self.exit_orders.pop(order_id, None)

            updates = {
                "status": "closed",
                "exit_price": exit_price,
                "profit_loss": pnl,
                "decision": "closed_external",
                "exit_order_id": exit_order_id,
            }
            if pnl_details:
                updates.update(pnl_details)
            self._update_position_cache(symbol, order_id, updates)

            self.capital = await self.fetch_real_balance()
            with SessionLocal() as db:
                trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                if trade:
                    await self._save_results(symbol, trade)
            return True

        if position_qty > 0 and held_qty < (position_qty * partial_threshold_ratio):
            with SessionLocal() as db:
                trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                if not trade or not position:
                    return False
                if position.status not in ["open", "closing"]:
                    return False
                trade.quantity = held_qty
                position.quantity = held_qty
                db.commit()

            self._update_position_cache(symbol, order_id, {"quantity": held_qty})
            self.capital = await self.fetch_real_balance()
            with SessionLocal() as db:
                trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                if trade:
                    await self._save_results(symbol, trade)
            return True

        return False

    async def fetch_initial_data(self) -> None:
        async with aiohttp.ClientSession() as session:
            tasks = [self._fetch_symbol_data(session, symbol) for symbol in self.symbols]
            await asyncio.gather(*tasks, return_exceptions=True)

    async def _fetch_symbol_data(self, session: aiohttp.ClientSession, symbol: str) -> None:
        try:
            kline_url = f"{BASE_URL}/v5/market/kline"
            params = {"category": "spot", "symbol": symbol, "interval": self.timeframe.replace("m", ""), "limit": "50"}
            kline_response = await fetch_data(session, kline_url, params)
            if kline_response and "result" in kline_response and "list" in kline_response["result"]:
                with SessionLocal() as db:
                    candles = [
                        MarketData(
                            timestamp=timestamp_to_datetime(int(k[0])),
                            symbol=symbol,
                            open=float(k[1]),
                            high=float(k[2]),
                            low=float(k[3]),
                            close=float(k[4]),
                            volume=float(k[5]) if float(k[5]) > 0 else 0.001
                        ) for k in kline_response["result"]["list"]
                    ]
                    for candle in candles:
                        if not db.query(MarketData).filter_by(timestamp=candle.timestamp, symbol=symbol).first():
                            db.add(candle)
                    db.commit()

                    self.candles[symbol] = [
                        {
                            "timestamp": c.timestamp.isoformat(),
                            "symbol": c.symbol,
                            "open": c.open,
                            "high": c.high,
                            "low": c.low,
                            "close": c.close,
                            "volume": c.volume
                        } for c in candles
                    ]
                    logger.info(f"📈 Velas iniciales para {symbol}: {len(self.candles[symbol])} cargadas")
                    if all(c["volume"] == 0 for c in self.candles[symbol]):
                        logger.warning(f"⚠ Todas las velas iniciales para {symbol} tienen volumen 0 antes del ajuste")
                    if all(c["volume"] <= 0.001 for c in self.candles[symbol]):
                        logger.info(f"✅ Volumen ajustado a mínimo (0.001) para todas las velas de {symbol}")
                    else:
                        logger.info(
                            f"✅ Algunas velas de {symbol} tienen volumen real: {max(c['volume'] for c in self.candles[symbol])}")

            orderbook_url = f"{BASE_URL}/v5/market/orderbook"
            params = {"category": "spot", "symbol": symbol, "limit": "100"}
            orderbook_response = await fetch_data(session, orderbook_url, params)
            if orderbook_response and "result" in orderbook_response:
                self.orderbook_data[symbol] = {"bids": orderbook_response["result"]["b"],
                                               "asks": orderbook_response["result"]["a"]}
                self.last_orderbook_update[symbol] = time.time()
                logger.info(
                    f"📊 Orderbook inicial para {symbol}: Bids={len(self.orderbook_data[symbol]['bids'])}, Asks={len(self.orderbook_data[symbol]['asks'])}")
            else:
                logger.warning(f"⚠ No se obtuvo orderbook válido para {symbol}: {orderbook_response}")

            ticker_url = f"{BASE_URL}/v5/market/tickers"
            params = {"category": "spot", "symbol": symbol}
            ticker_response = await fetch_data(session, ticker_url, params)
            if ticker_response and "result" in ticker_response and "list" in ticker_response["result"]:
                ticker_data = ticker_response["result"]["list"][0]
                self.ticker_data[symbol] = {
                    "last_price": float(ticker_data["lastPrice"]),
                    "volume_24h": float(ticker_data["volume24h"]),
                    "high_24h": float(ticker_data["highPrice24h"]),
                    "low_24h": float(ticker_data["lowPrice24h"])
                }
                self.last_ticker_update[symbol] = time.time()
                logger.info(f"⚡ Ticker inicial para {symbol}: Last={self.ticker_data[symbol]['last_price']}")
            else:
                logger.warning(f"⚠ No se obtuvo ticker válido para {symbol}: {ticker_response}")
        except Exception as e:
            logger.error(f"❌ Fetch inicial falló para {symbol}: {e}", exc_info=True)

    async def start_async(self) -> None:
        await self.validate_symbols()
        if not self.symbols:
            return

        self.capital = await self.fetch_real_balance()
        self.initial_capital = self.capital
        logger.info(f"🔥 Iniciando bot para {self.symbols} con capital inicial: {self.capital:.2f} USDT")

        await self._startup_reconcile_positions()
        if self.reconcile_task is None or self.reconcile_task.done():
            self.reconcile_task = asyncio.create_task(self._reconcile_active_positions_loop())
        if self.sync_supervisor_task is None or self.sync_supervisor_task.done():
            self.sync_supervisor_task = asyncio.create_task(self._sync_supervisor_loop())

        max_attempts = 5
        for attempt in range(max_attempts):
            if not self.running:
                logger.info("🛑 Bot detenido antes de iniciar.")
                break
            try:
                logger.info(f"Intento {attempt + 1}/{max_attempts} para obtener datos iniciales...")
                await self.fetch_initial_data()
                self._resume_order_status_tasks()
                logger.info("✅ Datos iniciales obtenidos, conectando al WebSocket...")
                await self._connect_websocket_async()
                break
            except Exception as e:
                logger.error(f"❌ Error al iniciar (intento {attempt + 1}/{max_attempts}): {e}")
                if attempt < max_attempts - 1:
                    await asyncio.sleep(5)
                else:
                    logger.critical("❌ Máximo de intentos alcanzado. Deteniendo.")
                    self.stop()

    async def _connect_websocket_async(self) -> None:
        while self.running:
            try:
                async with websockets.connect(WS_URL, ping_interval=20, ping_timeout=40) as ws:
                    self.ws = ws
                    logger.info("🌐 WebSocket abierto")
                    await self._resubscribe_async()
                    async for message in ws:
                        await self._on_message(ws, message)
            except websockets.ConnectionClosed as e:
                logger.warning(f"⚠️ WebSocket cerrado: {e}, intentando reconectar en 5s...")
                await asyncio.sleep(5)
            except Exception as e:
                logger.error(f"❌ Error en WebSocket: {e}")
                await asyncio.sleep(5)

    async def _resubscribe_async(self) -> None:
        interval = self.timeframe.replace("m", "")
        for symbol in self.symbols:
            subscription = {"op": "subscribe",
                            "args": [f"kline.{interval}.{symbol}", f"orderbook.50.{symbol}", f"tickers.{symbol}"]}
            if self.ws:
                await self.ws.send(json.dumps(subscription))
                logger.info(f"📡 Suscrito a {symbol}")

    async def _on_message(self, ws: Any, message: Any) -> None:
        if self.paused and time.time() >= float(self.paused_until_ts or 0.0):
            self.paused = False
            self.paused_until_ts = 0.0
        if self.paused:
            return

        with SessionLocal() as db:
            try:
                if isinstance(message, bytes):
                    message = message.decode('utf-8')
                elif isinstance(message, tuple):
                    message = message[0]
                elif message is None:
                    logger.warning("⚠️ Mensaje recibido es None, ignorando.")
                    return

                if isinstance(message, str):
                    data = json.loads(message)
                    logger.debug(f"📨 Mensaje procesado: {json.dumps(data, indent=2)}")

                    if "topic" not in data:
                        logger.debug("⚠️ Mensaje sin tema ('topic'), posiblemente ping/pong.")
                        if data.get("op") == "ping" and ws is not None:
                            await ws.send(json.dumps({"op": "pong", "ts": data.get("ts", int(time.time() * 1000))}))
                        return

                    symbol = data["topic"].split(".")[-1]
                    if symbol not in self.symbols:
                        logger.warning(f"⚠️ Símbolo desconocido: {symbol}")
                        return

                    if "kline" in data["topic"] and data.get("data") and len(data["data"]) > 0:
                        await self._handle_kline(symbol, data["data"][0], db)
                    elif "orderbook" in data["topic"] and data.get("data"):
                        await self._handle_orderbook(symbol, data, db)
                    elif "tickers" in data["topic"] and data.get("data"):
                        await self._handle_ticker(symbol, data["data"], db)
                        current_time = int(time.time() * 1000)
                        if current_time - self.last_kline_time.get(symbol, 0) > 60000:
                            self._request_trade(symbol)
            except json.JSONDecodeError as e:
                logger.error(f"❌ Error de decodificación JSON: {e}")
            except Exception as e:
                logger.error(f"❌ Error inesperado en mensaje: {e}")
                self.error_count += 1
                self.consecutive_errors += 1
                if self.consecutive_errors >= self.max_consecutive_errors:
                    logger.warning(
                        f"⏸ Demasiados errores consecutivos ({self.consecutive_errors}). Pausando bot por {self.pause_duration} segundos.")
                    self.consecutive_errors = 0
                    self._trigger_pause(self.pause_duration)
                if self.error_count >= self.max_errors:
                    logger.critical(f"❌ Demasiados errores ({self.error_count}). Deteniendo bot.")
                    self.stop()

    async def _handle_kline(self, symbol: str, kline: Dict, db: Session) -> None:
        try:
            timestamp_value = kline.get("start")
            if not timestamp_value or not str(timestamp_value).isdigit():
                logger.warning(f"⚠️ Timestamp inválido '{timestamp_value}' para {symbol}. Saltando.")
                return
            timestamp = timestamp_to_datetime(int(timestamp_value))

            volume = float(kline.get("volume", 0)) if float(kline.get("volume", 0)) > 0 else 0.001
            open_price = float(kline.get("open", 0))
            high_price = float(kline.get("high", 0))
            low_price = float(kline.get("low", 0))
            close_price = float(kline.get("close", 0))

            logger.debug(f"📥 Kline recibido para {symbol}: timestamp={timestamp}, close={close_price}, volume={volume}")
            candle = db.query(MarketData).filter_by(timestamp=timestamp, symbol=symbol).first()
            if candle is None:
                candle = MarketData(
                    timestamp=timestamp,
                    symbol=symbol,
                    open=open_price,
                    high=high_price,
                    low=low_price,
                    close=close_price,
                    volume=volume
                )
                db.add(candle)
            else:
                candle.open = open_price
                candle.high = high_price
                candle.low = low_price
                candle.close = close_price
                candle.volume = volume
            db.commit()

            candle_dict = {
                "timestamp": candle.timestamp.isoformat(),
                "symbol": candle.symbol,
                "open": candle.open,
                "high": candle.high,
                "low": candle.low,
                "close": candle.close,
                "volume": candle.volume
            }
            existing_idx = None
            for i, c in enumerate(self.candles[symbol]):
                if c.get("timestamp") == candle_dict["timestamp"]:
                    existing_idx = i
                    break
            if existing_idx is None:
                self.candles[symbol].append(candle_dict)
            else:
                self.candles[symbol][existing_idx] = candle_dict
            self.candles[symbol] = self.candles[symbol][-50:]
            self.last_kline_time[symbol] = int(timestamp_value)

            logger.info(f"⚡ Kline para {symbol}: Close={candle.close}, Volume={candle.volume}")
            logger.info(f"📈 Acumulados {len(self.candles[symbol])} velas para {symbol}")

            self._request_trade(symbol)
        except Exception as e:
            logger.error(f"❌ Error en _handle_kline para {symbol}: {e}")

    async def _handle_orderbook(self, symbol: str, data: Dict, db: Session) -> None:
        try:
            if data.get("type") == "snapshot":
                self.orderbook_data[symbol] = {"bids": data["data"]["b"], "asks": data["data"]["a"]}
                self.last_orderbook_update[symbol] = time.time()
                await self._store_orderbook(symbol, db)
                logger.info(
                    f"📊 Snapshot para {symbol}: Bids={len(self.orderbook_data[symbol]['bids'])}, Asks={len(self.orderbook_data[symbol]['asks'])}")
            elif data.get("type") == "delta":
                if symbol not in self.orderbook_data or not self.orderbook_data[symbol]["bids"]:
                    logger.warning(f"⚠️ No hay orderbook previo para {symbol}, esperando snapshot")
                    return
                current = self.orderbook_data[symbol]
                bid_dict = {float(b[0]): float(b[1]) for b in current["bids"]}
                ask_dict = {float(a[0]): float(a[1]) for a in current["asks"]}
                _update_orderbook(bid_dict, ask_dict, data)
                self.orderbook_data[symbol] = {
                    "bids": [[str(p), str(q)] for p, q in sorted(bid_dict.items(), reverse=True) if q > 0][:50],
                    "asks": [[str(p), str(q)] for p, q in sorted(ask_dict.items()) if q > 0][:50]
                }
                self.last_orderbook_update[symbol] = time.time()
                await self._store_orderbook(symbol, db)
                logger.info(
                    f"📊 Delta para {symbol}: Bids={len(self.orderbook_data[symbol]['bids'])}, Asks={len(self.orderbook_data[symbol]['asks'])}")
        except Exception as e:
            logger.error(f"❌ Error en _handle_orderbook para {symbol}: {e}")

    async def _store_orderbook(self, symbol: str, db: Session) -> None:
        try:
            bids_val = self.orderbook_data[symbol]["bids"]
            asks_val = self.orderbook_data[symbol]["asks"]
            for _ in range(2):
                if isinstance(bids_val, str):
                    try:
                        bids_val = json.loads(bids_val)
                    except Exception:
                        bids_val = []
                if isinstance(asks_val, str):
                    try:
                        asks_val = json.loads(asks_val)
                    except Exception:
                        asks_val = []

            orderbook = Orderbook(
                timestamp=datetime.now(timezone.utc),
                symbol=symbol,
                bids=bids_val,
                asks=asks_val
            )
            db.add(orderbook)
            db.commit()
            if time.time() - self.last_orderbook_log >= 5:
                logger.info(
                    f"🤘 Orderbook guardado para {symbol}: Bids={len(bids_val) if isinstance(bids_val, list) else 0}, Asks={len(asks_val) if isinstance(asks_val, list) else 0}")
                self.last_orderbook_log = time.time()
        except Exception as e:
            logger.error(f"❌ Error al guardar orderbook para {symbol}: {e}")

    async def _handle_ticker(self, symbol: str, ticker: Dict, db: Session) -> None:
        try:
            if not isinstance(ticker, dict) or not ticker:
                logger.warning(f"⚠️ Ticker inválido para {symbol}: {ticker}. Saltando.")
                return

            required = ["lastPrice", "volume24h", "highPrice24h", "lowPrice24h"]
            optional = ["usdIndexPrice"]
            if not all(key in ticker for key in required):
                logger.warning(f"⚠️ Faltan claves requeridas en ticker para {symbol}: {ticker}. Saltando.")
                return

            ticker_values = {}
            for key in required + optional:
                value = ticker.get(key, 0.0)
                try:
                    ticker_values[key] = float(value) if value else 0.0
                except (ValueError, TypeError):
                    ticker_values[key] = 0.0

            if ticker_values.get("usdIndexPrice", 0.0) <= 0:
                ticker_values["usdIndexPrice"] = self.ticker_data[symbol].get("usd_index_price", 0.0)

            self.ticker_data[symbol] = {
                "last_price": ticker_values["lastPrice"],
                "volume_24h": ticker_values["volume24h"],
                "high_24h": ticker_values["highPrice24h"],
                "low_24h": ticker_values["lowPrice24h"],
                "usd_index_price": ticker_values["usdIndexPrice"]
            }
            self.last_ticker_update[symbol] = time.time()

            market_ticker = MarketTicker(
                timestamp=datetime.now(timezone.utc),
                symbol=symbol,
                last_price=self.ticker_data[symbol]["last_price"],
                volume_24h=self.ticker_data[symbol]["volume_24h"],
                high_24h=self.ticker_data[symbol]["high_24h"],
                low_24h=self.ticker_data[symbol]["low_24h"]
            )
            db.add(market_ticker)
            db.commit()

            logger.info(
                f"⚡ Ticker actualizado para {symbol}: Last={self.ticker_data[symbol]['last_price']}, USDIndex={self.ticker_data[symbol]['usd_index_price']}")
        except Exception as e:
            logger.error(f"❌ Error en _handle_ticker para {symbol}: {e}")

    @staticmethod
    def _determine_decision(symbol: str, metrics: Dict[str, float]) -> str:
        egm = metrics.get("egm", 0.0)
        combined = metrics.get("combined", 0.0)
        ild = metrics.get("ild", 0.0)
        rol = metrics.get("rol", 0.0)
        pio = metrics.get("pio", 0.0)
        ogm = metrics.get("ogm", 0.0)

        logger.info(
            f"🔍 {symbol}: EGM={egm:.4f}, Combined={combined:.4f}, ILD={ild:.4f}, ROL={rol:.4f}, PIO={pio:.4f}, OGM={ogm:.4f}, Buy Threshold={config.EGM_BUY_THRESHOLD}, Sell Threshold={config.EGM_SELL_THRESHOLD}")

        buy_score = (egm * 0.3 + combined * 0.3 + ild * 0.2 + rol * 0.1 + pio * 0.05 + ogm * 0.05)
        sell_score = (-egm * 0.3 - combined * 0.3 - ild * 0.2 - rol * 0.1 - pio * 0.05 - ogm * 0.05)

        if buy_score >= 0.5 or (egm >= config.EGM_BUY_THRESHOLD and combined >= 1.0):
            return "buy"
        elif sell_score >= 0.5 or (egm <= config.EGM_SELL_THRESHOLD and combined <= -1.0):
            return "sell"
        return "hold"

    @staticmethod
    def _compute_signal_scores(metrics: Dict[str, float]) -> Dict[str, float]:
        egm = float(metrics.get("egm", 0.0) or 0.0)
        combined = float(metrics.get("combined", 0.0) or 0.0)
        ild = float(metrics.get("ild", 0.0) or 0.0)
        rol = float(metrics.get("rol", 0.0) or 0.0)
        pio = float(metrics.get("pio", 0.0) or 0.0)
        ogm = float(metrics.get("ogm", 0.0) or 0.0)

        buy_score = (egm * 0.3 + combined * 0.3 + ild * 0.2 + rol * 0.1 + pio * 0.05 + ogm * 0.05)
        sell_score = (-egm * 0.3 - combined * 0.3 - ild * 0.2 - rol * 0.1 - pio * 0.05 - ogm * 0.05)
        return {"buy_score": float(buy_score), "sell_score": float(sell_score)}

    @staticmethod
    def _compute_trade_correlations(trades: List[Dict[str, Any]]) -> Dict[str, Any]:
        def _safe_float(value: Any) -> Optional[float]:
            if value is None:
                return None
            try:
                as_float = float(value)
            except Exception:
                return None
            if not math.isfinite(as_float):
                return None
            return as_float

        rows: List[Dict[str, float]] = []
        for t in trades or []:
            if not isinstance(t, dict):
                continue
            if t.get("status") != "closed":
                continue
            pnl = _safe_float(t.get("profit_loss"))
            if pnl is None:
                continue
            row: Dict[str, float] = {"profit_loss": pnl}
            for key in ("combined", "ild", "egm", "rol", "pio", "ogm", "risk_reward_ratio"):
                v = _safe_float(t.get(key))
                if v is not None:
                    row[key] = v
            rows.append(row)

        n = len(rows)
        if n < 2:
            return {"n": n, "to_pnl": {}, "matrix": {}}

        df = pd.DataFrame(rows)
        df = df.apply(pd.to_numeric, errors="coerce")
        df = df.replace([float("inf"), -float("inf")], pd.NA)
        corr = df.corr(numeric_only=True)

        to_pnl: Dict[str, Optional[float]] = {}
        if "profit_loss" in corr.columns:
            for k, v in corr["profit_loss"].to_dict().items():
                if k == "profit_loss":
                    continue
                to_pnl[str(k)] = _safe_float(v)

        cols = [c for c in corr.columns if c != "profit_loss"]
        matrix: Dict[str, Dict[str, Optional[float]]] = {}
        for c1 in cols:
            row: Dict[str, Optional[float]] = {}
            for c2 in cols:
                try:
                    val = corr.at[c1, c2]
                except Exception:
                    val = None
                row[str(c2)] = _safe_float(val)
            matrix[str(c1)] = row

        return {"n": n, "to_pnl": to_pnl, "matrix": matrix}

    async def _cancel_stale_orders(self, symbol: str) -> None:
        """Cancela órdenes que no se han ejecutado después de 5 minutos, solo si fueron creadas por el bot."""
        try:
            session = HTTP(
                testnet=config.USE_TESTNET,
                api_key=config.BYBIT_API_KEY,
                api_secret=config.BYBIT_API_SECRET
            )
            timestamp = await get_synced_time()
            response = session.get_open_orders(
                category="spot",
                symbol=symbol,
                timestamp=str(timestamp),
                recvWindow=str(int(config.RECV_WINDOW))
            )
            if response.get("retCode") == 0:
                orders = response["result"]["list"]
                current_time = datetime.now(timezone.utc)
                for order in orders:
                    # Solo cancelar órdenes creadas por el bot (orderLinkId comienza con "nertz-")
                    if not order.get("orderLinkId", "").startswith("nertz-"):
                        continue
                    created_raw = order.get("createdTime") or order.get("updatedTime")
                    try:
                        order_time = timestamp_to_datetime(int(created_raw))
                    except Exception:
                        continue
                    if (current_time - order_time).total_seconds() > 300:  # 5 minutos
                        order_id = str(order.get("orderId", "") or "")
                        if not order_id:
                            continue

                        try:
                            cancel_response = session.cancel_order(
                                category="spot",
                                symbol=symbol,
                                orderId=order_id,
                                timestamp=str(timestamp),
                                recvWindow=str(int(config.RECV_WINDOW))
                            )
                        except Exception as e:
                            if self._is_order_not_found_error(e):
                                cancel_response = {"retCode": 170213, "retMsg": str(e)}
                            else:
                                raise

                        if cancel_response.get("retCode") == 0:
                            await self._finalize_cancelled_pending_entry(
                                symbol,
                                order_id,
                                (current_time - order_time).total_seconds(),
                                "cancelada por inactividad"
                            )
                            continue

                        if self._is_order_not_found_response(cancel_response):
                            status = await self._reconcile_pending_entry(symbol, order_id)
                            if status == "pending":
                                await self._finalize_cancelled_pending_entry(
                                    symbol,
                                    order_id,
                                    (current_time - order_time).total_seconds(),
                                    "ya no existe en exchange"
                                )
                            continue
        except Exception as e:
            logger.error(f"❌ Error al cancelar órdenes inactivas para {symbol}: {e}")

    @staticmethod
    def _as_utc(dt: Optional[datetime]) -> datetime:
        if dt is None:
            return datetime.min.replace(tzinfo=timezone.utc)
        if dt.tzinfo is None:
            return dt.replace(tzinfo=timezone.utc)
        return dt.astimezone(timezone.utc)

    @staticmethod
    def _is_order_not_found_response(resp: Any) -> bool:
        if not isinstance(resp, dict):
            return False
        code = resp.get("retCode")
        msg = str(resp.get("retMsg", "")).lower()
        if code in {170213, 110001, 110010}:
            return True
        if "order does not exist" in msg:
            return True
        if "not exist" in msg and "order" in msg:
            return True
        return False

    @staticmethod
    def _is_order_not_found_error(err: BaseException) -> bool:
        parts: list[str] = [f"{err!r}", str(err)]
        try:
            for a in (getattr(err, "args", None) or []):
                try:
                    parts.append(str(a))
                except Exception:
                    continue
        except Exception:
            pass
        msg = " ".join(parts).lower()
        if "170213" in msg:
            return True
        if "order does not exist" in msg:
            return True
        if "not exist" in msg and "order" in msg:
            return True
        return False

    @staticmethod
    def _as_float(value: Any) -> Optional[float]:
        if value is None:
            return None
        try:
            return float(value)
        except (TypeError, ValueError):
            return None

    async def _finalize_cancelled_pending_entry(self, symbol: str, order_id: str, age_seconds: float, note: str) -> bool:
        with SessionLocal() as db:
            trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
            position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
            if trade:
                trade.exit_price = None
                trade.profit_loss = 0.0
                trade.decision = "cancelled"
            if position:
                position.status = "cancelled"
            db.commit()

            if trade:
                self._update_position_cache(symbol, order_id, {
                    "status": "cancelled",
                    "exit_price": None,
                    "profit_loss": 0.0,
                    "decision": "cancelled",
                })
                await self._save_results(symbol, trade)

        task = self.order_status_tasks.get(order_id)
        if task and not task.done():
            task.cancel()
        self.order_status_tasks.pop(order_id, None)

        logger.info(f"🧹 {symbol}: orden pending expirada ({int(age_seconds)}s), {note}. OrderID={order_id}")
        return True

    def _update_position_cache(self, symbol: str, order_id: str, updates: Dict[str, Any]) -> None:
        for position_dict in self.positions.get(symbol, []):
            if position_dict.get("order_id") == order_id:
                position_dict.update(updates)
                break

    def _migrate_internal_order_key(self, symbol: str, old_order_id: str, new_order_id: str) -> None:
        if not old_order_id or not new_order_id or old_order_id == new_order_id:
            return

        task = self.order_status_tasks.pop(old_order_id, None)
        if task is not None:
            self.order_status_tasks[new_order_id] = task

        exit_order_id = self.exit_orders.pop(old_order_id, None)
        if exit_order_id is not None:
            self.exit_orders[new_order_id] = exit_order_id

        for position_dict in self.positions.get(symbol, []):
            if position_dict.get("order_id") == old_order_id:
                position_dict["order_id"] = new_order_id

        for position_dict in self.trade_buffer.get(symbol, []):
            if position_dict.get("order_id") == old_order_id:
                position_dict["order_id"] = new_order_id

    async def _discover_exit_order(self, symbol: str, parent_order_id: str, action: str) -> Optional[Dict[str, Any]]:
        try:
            session = HTTP(
                testnet=config.USE_TESTNET,
                api_key=config.BYBIT_API_KEY,
                api_secret=config.BYBIT_API_SECRET
            )
            timestamp = await get_synced_time()
            wanted_prefix = f"nertz-exit-{parent_order_id}"
            wanted_side = "Sell" if action == "buy" else "Buy"

            open_resp = session.get_open_orders(
                category="spot",
                symbol=symbol,
                timestamp=str(timestamp),
                recvWindow=str(int(config.RECV_WINDOW))
            )
            if open_resp.get("retCode") == 0:
                for o in (open_resp.get("result", {}).get("list", []) or []):
                    if o.get("side") != wanted_side:
                        continue
                    if str(o.get("orderLinkId", "")).startswith(wanted_prefix):
                        return o

            hist_resp = session.get_order_history(
                category="spot",
                symbol=symbol,
                timestamp=str(timestamp),
                recvWindow=str(int(config.RECV_WINDOW))
            )
            if hist_resp.get("retCode") == 0:
                for o in (hist_resp.get("result", {}).get("list", []) or []):
                    if o.get("side") != wanted_side:
                        continue
                    if str(o.get("orderLinkId", "")).startswith(wanted_prefix):
                        return o
            return None
        except Exception:
            return None

    async def _reconcile_pending_entry(self, symbol: str, order_id: str) -> str:
        filled_statuses = {"filled", "partiallyfilled", "partiallyfilledcanceled"}
        cancelled_statuses = {"cancelled", "canceled", "rejected", "deactivated"}

        try:
            session = HTTP(
                testnet=config.USE_TESTNET,
                api_key=config.BYBIT_API_KEY,
                api_secret=config.BYBIT_API_SECRET
            )
            timestamp = await get_synced_time()

            open_resp = session.get_open_orders(
                category="spot",
                symbol=symbol,
                orderId=order_id,
                timestamp=str(timestamp),
                recvWindow=str(int(config.RECV_WINDOW))
            )
            if open_resp.get("retCode") == 0:
                orders = open_resp.get("result", {}).get("list", []) or []
                if orders:
                    link_id = orders[0].get("orderLinkId")
                    if link_id and not str(link_id).startswith("nertz-"):
                        return "external"

                    executed_qty = float(orders[0].get("cumExecQty", "0.0") or 0.0)
                    if executed_qty > 0:
                        avg_entry_raw = float(orders[0].get("avgPrice") or 0.0)
                        if avg_entry_raw <= 0:
                            cum_exec_value = float(orders[0].get("cumExecValue") or 0.0)
                            avg_entry = (cum_exec_value / executed_qty) if cum_exec_value > 0 else 0.0
                        else:
                            avg_entry = avg_entry_raw

                        try:
                            session.cancel_order(
                                category="spot",
                                symbol=symbol,
                                orderId=order_id,
                                timestamp=str(timestamp),
                                recvWindow=str(int(config.RECV_WINDOW))
                            )
                        except Exception:
                            pass

                        with SessionLocal() as db:
                            trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                            position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                            if not trade or not position:
                                return "open"

                            if avg_entry > 0:
                                trade.entry_price = avg_entry
                                position.entry_price = avg_entry

                            trade.quantity = executed_qty
                            position.quantity = executed_qty
                            position.status = "open"
                            trade.exit_price = None
                            db.commit()

                            self._update_position_cache(symbol, order_id, {
                                "status": "open",
                                "entry_price": float(trade.entry_price),
                                "quantity": float(position.quantity),
                                "exit_price": None,
                                "profit_loss": 0.0,
                            })

                            await self._save_results(symbol, trade)
                        return "open"

                    return "pending"

            history_response = session.get_order_history(
                category="spot",
                symbol=symbol,
                orderId=order_id,
                timestamp=str(timestamp),
                recvWindow=str(int(config.RECV_WINDOW))
            )
            if history_response.get("retCode") != 0:
                if self._is_order_not_found_response(history_response):
                    with SessionLocal() as db:
                        trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                        position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                        if trade:
                            trade.exit_price = None
                            trade.profit_loss = 0.0
                            trade.decision = "cancelled"
                        if position:
                            position.status = "cancelled"
                        db.commit()

                        if trade:
                            self._update_position_cache(symbol, order_id, {
                                "status": "cancelled",
                                "exit_price": None,
                                "profit_loss": 0.0,
                                "decision": "cancelled",
                            })
                            await self._save_results(symbol, trade)
                    return "cancelled"
                return "pending"

            hist_list = history_response.get("result", {}).get("list", []) or []
            if not hist_list:
                return "pending"

            order_info = hist_list[0]
            order_link_id = order_info.get("orderLinkId")
            if order_link_id and not str(order_link_id).startswith("nertz-"):
                return "external"

            order_status = str(order_info.get("orderStatus", "")).lower()

            with SessionLocal() as db:
                trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                if not trade or not position:
                    return order_status or "pending"

                if order_status in filled_statuses:
                    executed_qty = float(order_info.get("cumExecQty", "0.0") or 0.0)
                    if executed_qty <= 0:
                        return "pending"

                    avg_entry_raw = float(order_info.get("avgPrice") or 0.0)
                    if avg_entry_raw <= 0:
                        cum_exec_value = float(order_info.get("cumExecValue") or 0.0)
                        avg_entry = (cum_exec_value / executed_qty) if cum_exec_value > 0 else float(trade.entry_price)
                    else:
                        avg_entry = avg_entry_raw

                    if avg_entry > 0:
                        trade.entry_price = avg_entry
                        position.entry_price = avg_entry

                    trade.quantity = executed_qty
                    position.quantity = executed_qty
                    position.status = "open"
                    trade.exit_price = None
                    db.commit()

                    self._update_position_cache(symbol, order_id, {
                        "status": "open",
                        "entry_price": float(trade.entry_price),
                        "quantity": float(position.quantity),
                        "exit_price": None,
                        "profit_loss": 0.0,
                    })

                    await self._save_results(symbol, trade)
                    return "open"

                if order_status in cancelled_statuses:
                    trade.exit_price = None
                    trade.profit_loss = 0.0
                    trade.decision = "cancelled"
                    position.status = "cancelled"
                    db.commit()

                    self._update_position_cache(symbol, order_id, {
                        "status": "cancelled",
                        "exit_price": None,
                        "profit_loss": 0.0,
                        "decision": "cancelled",
                    })

                    await self._save_results(symbol, trade)
                    return "cancelled"

            return order_status or "pending"
        except Exception as e:
            logger.error(f"❌ Error al reconciliar orden pending {symbol}, OrderID={order_id}: {e}")
            return "pending"

    async def _expire_pending_entry_if_needed(self, symbol: str, order_id: str, position_ts: Optional[datetime]) -> bool:
        now = datetime.now(timezone.utc)
        pos_ts = self._as_utc(position_ts)
        age_seconds = (now - pos_ts).total_seconds()
        if age_seconds <= float(getattr(config, "PENDING_ENTRY_MAX_AGE_SECONDS", 90.0)):
            return False

        status = await self._reconcile_pending_entry(symbol, order_id)
        if status != "pending":
            return True

        try:
            session = HTTP(
                testnet=config.USE_TESTNET,
                api_key=config.BYBIT_API_KEY,
                api_secret=config.BYBIT_API_SECRET
            )
            timestamp = await get_synced_time()
            open_resp = session.get_open_orders(
                category="spot",
                symbol=symbol,
                orderId=order_id,
                timestamp=str(timestamp),
                recvWindow=str(int(config.RECV_WINDOW))
            )
            orders: list[dict[str, Any]]
            if open_resp.get("retCode") == 0:
                orders = open_resp.get("result", {}).get("list", []) or []
            else:
                if self._is_order_not_found_response(open_resp):
                    orders = []
                else:
                    return False

            if not orders:
                final_status = await self._reconcile_pending_entry(symbol, order_id)
                if final_status != "pending":
                    return True
                return await self._finalize_cancelled_pending_entry(symbol, order_id, age_seconds, "no aparece en open/orders")

            link_id = orders[0].get("orderLinkId")
            if link_id and not str(link_id).startswith("nertz-"):
                return False

            try:
                cancel_response = session.cancel_order(
                    category="spot",
                    symbol=symbol,
                    orderId=order_id,
                    timestamp=str(timestamp),
                    recvWindow=str(int(config.RECV_WINDOW))
                )
            except Exception as e:
                if self._is_order_not_found_error(e):
                    for _ in range(3):
                        final_status = await self._reconcile_pending_entry(symbol, order_id)
                        if final_status != "pending":
                            return True
                        await asyncio.sleep(1)
                    return await self._finalize_cancelled_pending_entry(symbol, order_id, age_seconds, "ya no existe en exchange")
                raise
            if cancel_response.get("retCode") != 0:
                cancel_code = cancel_response.get("retCode")
                cancel_msg = str(cancel_response.get("retMsg", "")).lower()
                if cancel_code == 170213 or "order does not exist" in cancel_msg:
                    for _ in range(3):
                        final_status = await self._reconcile_pending_entry(symbol, order_id)
                        if final_status != "pending":
                            return True
                        await asyncio.sleep(1)
                    return await self._finalize_cancelled_pending_entry(symbol, order_id, age_seconds, "ya no existe en exchange")

                return False

            return await self._finalize_cancelled_pending_entry(symbol, order_id, age_seconds, "cancelada")
        except Exception as e:
            if self._is_order_not_found_error(e):
                return await self._finalize_cancelled_pending_entry(symbol, order_id, age_seconds, "ya no existe en exchange")
            logger.error(f"❌ Error al expirar orden pending {symbol}, OrderID={order_id}: {e}")
            return False

    async def _execute_trade(self, symbol: str, db: Session) -> None:
        if self.paused:
            logger.info(f"⏸ Bot en pausa, ignorando trade para {symbol}.")
            return

        try:
            self.cycle_counter += 1
            await self._monitor_cycle(symbol, "start")
            await self._save_results(symbol, None)
            candles = self.candles.get(symbol, [])
            if len(candles) < 5:
                logger.warning(f"⚠️ No hay suficientes velas ({len(candles)}/5) para {symbol}")
                return

            current_time = datetime.now(timezone.utc)
            cooldown = timedelta(seconds=config.DEFAULT_SLEEP_TIME)
            last_trade_time = self.last_trade_time.get(symbol, datetime.min.replace(tzinfo=timezone.utc))
            if current_time <= last_trade_time + cooldown:
                logger.debug(f"⏳ Cooldown activo para {symbol}, esperando hasta {last_trade_time + cooldown}")
                return

            # Cancelar órdenes inactivas antes de intentar un nuevo trade
            await self._cancel_stale_orders(symbol)

            existing_order_id = None
            existing_status = None
            existing_action = None
            existing_ts = None
            with SessionLocal() as check_db:
                existing_position = (
                    check_db.query(Position)
                    .filter(
                        Position.symbol == symbol,
                        Position.status.in_(["pending", "open", "closing"])
                    )
                    .order_by(Position.id.desc())
                    .first()
                )
                if existing_position:
                    existing_order_id = existing_position.order_id
                    existing_status = existing_position.status
                    existing_action = existing_position.action
                    existing_ts = existing_position.timestamp

            spot_long_only = bool(getattr(config, "SPOT_LONG_ONLY", True))

            if existing_order_id:
                if existing_status in ["open", "closing"] and spot_long_only and str(existing_action or "").lower() == "sell":
                    await self._reconcile_open_position_with_wallet(symbol, existing_order_id)
                    with SessionLocal() as check_db:
                        rechecked = (
                            check_db.query(Position)
                            .filter(
                                Position.symbol == symbol,
                                Position.status.in_(["pending", "open", "closing"])
                            )
                            .order_by(Position.id.desc())
                            .first()
                        )
                        if not rechecked or rechecked.status not in ["pending", "open", "closing"]:
                            existing_order_id = None
                            existing_status = None
                            existing_action = None

            if existing_order_id:
                if existing_status == "pending":
                    now_ts = time.time()
                    last_reconcile = float(self.last_pending_reconcile.get(symbol, 0.0) or 0.0)
                    if (now_ts - last_reconcile) >= 5.0:
                        self.last_pending_reconcile[symbol] = now_ts
                        await self._reconcile_pending_entry(symbol, existing_order_id)

                    with SessionLocal() as check_db:
                        rechecked = (
                            check_db.query(Position)
                            .filter(
                                Position.symbol == symbol,
                                Position.status.in_(["pending", "open", "closing"])
                            )
                            .order_by(Position.id.desc())
                            .first()
                        )
                        if rechecked and rechecked.status in ["open", "closing"]:
                            now_ts = time.time()
                            last_log = float(self.last_skip_log.get(symbol, 0.0) or 0.0)
                            if (now_ts - last_log) >= 60.0:
                                self.last_skip_log[symbol] = now_ts
                                logger.info(f"⏭ {symbol}: ya hay una posición {rechecked.status}, saltando nueva entrada")
                            return
                        if rechecked and rechecked.status == "pending":
                            expired = await self._expire_pending_entry_if_needed(
                                symbol,
                                rechecked.order_id,
                                rechecked.timestamp
                            )
                            if not expired:
                                now_ts = time.time()
                                last_log = float(self.last_skip_log.get(symbol, 0.0) or 0.0)
                                if (now_ts - last_log) >= 60.0:
                                    self.last_skip_log[symbol] = now_ts
                                    logger.info(
                                        f"⏭ {symbol}: hay una orden pending reciente, saltando nueva entrada. OrderID={rechecked.order_id}"
                                    )
                                return

            await self._refresh_market_state_if_stale(symbol)

            candle_data = [
                {"open": c["open"], "high": c["high"], "low": c["low"], "close": c["close"], "volume": c["volume"]}
                for c in candles
            ]
            orderbook = self.orderbook_data.get(symbol, {"bids": [], "asks": []})
            ticker = self.ticker_data.get(symbol, {"last_price": 0.0})
            logger.info(
                f"📊 Datos de entrada para {symbol}: candles={len(candles)}, orderbook_bids={len(orderbook['bids'])}, ticker_last={ticker['last_price']}")

            metrics = calculate_metrics(candle_data, orderbook, ticker)
            if all(v == 0.0 for v in metrics.values()):
                logger.warning(f"⚠️ Todas las métricas son 0 para {symbol}, saltando trade")
                return

            logger.info(
                f"📊 Métricas calculadas para {symbol}: pio={metrics.get('pio', 0)}, ild={metrics.get('ild', 0)}, egm={metrics.get('egm', 0)}, rol={metrics.get('rol', 0)}, combined={metrics.get('combined', 0)}")

            decision = self._determine_decision(symbol, metrics)

            if existing_order_id and existing_status in ["open", "closing"]:
                now_ts = time.time()
                last_reconcile = float(self.last_open_reconcile.get(symbol, 0.0) or 0.0)
                if (now_ts - last_reconcile) >= 5.0:
                    self.last_open_reconcile[symbol] = now_ts
                    await self._reconcile_open_position_with_wallet(symbol, existing_order_id)
                    with SessionLocal() as check_db:
                        rechecked = (
                            check_db.query(Position)
                            .filter(
                                Position.symbol == symbol,
                                Position.status.in_(["pending", "open", "closing"])
                            )
                            .order_by(Position.id.desc())
                            .first()
                        )
                        if not rechecked or rechecked.status not in ["pending", "open", "closing"]:
                            existing_order_id = None
                            existing_status = None
                            existing_action = None

                if existing_order_id:
                    if spot_long_only and str(existing_action or "").lower() == "buy" and decision == "sell" and existing_status == "open":
                        with SessionLocal() as close_db:
                            trade = close_db.query(Trade).filter_by(order_id=existing_order_id).order_by(Trade.id.desc()).first()
                            position = close_db.query(Position).filter_by(order_id=existing_order_id).order_by(Position.id.desc()).first()
                            if trade and position and position.status == "open":
                                fixed_ts = await get_synced_time()
                                exit_res = await self._place_exit_order(
                                    symbol=symbol,
                                    action="sell",
                                    quantity=float(position.quantity),
                                    fixed_timestamp=fixed_ts,
                                    parent_order_id=existing_order_id
                                )
                                if exit_res.get("success"):
                                    exit_order_id = exit_res.get("order_id")
                                    self.exit_orders[existing_order_id] = exit_order_id
                                    position.status = "closing"
                                    close_db.commit()
                                    self._update_position_cache(symbol, existing_order_id, {
                                        "status": "closing",
                                        "exit_order_id": exit_order_id,
                                    })
                                    await self._save_results(symbol, trade)
                        return

                    now_ts = time.time()
                    last_log = float(self.last_skip_log.get(symbol, 0.0) or 0.0)
                    if (now_ts - last_log) >= 60.0:
                        self.last_skip_log[symbol] = now_ts
                        logger.info(f"⏭ {symbol}: ya hay una posición {existing_status}, saltando nueva entrada")
                    return
            if decision == "hold":
                logger.debug(f"🤖 Decisión de hold para {symbol}")
                return

            if spot_long_only and decision == "sell":
                logger.info(f"⏭ {symbol}: SPOT_LONG_ONLY activo y no hay posición abierta; ignorando señal SELL")
                return

            # Usar el saldo disponible real
            available_balance = await self.fetch_real_balance()
            self.capital = available_balance
            logger.info(f"💰 Capital disponible antes del trade: {self.capital:.2f} USDT")

            risk_per_trade = self.capital * config.RISK_FACTOR
            volatility = metrics.get("volatility", 0.01)
            if volatility <= 0:
                logger.warning(f"⚠️ Volatilidad inválida ({volatility}) para {symbol}")
                volatility = 0.01

            last_price = ticker.get("last_price", 0.0)
            if last_price <= 0:
                logger.warning(
                    f"⚠️ Precio inválido ({last_price}) para {symbol}, usando valor predeterminado de 75000.0")
                last_price = 75000.0
            logger.info(f"📈 Precio usado para {symbol}: {last_price}")

            # Calcular la cantidad basada en el 2% del saldo disponible
            quantity = (self.capital * 0.02) / last_price
            quantity = round(quantity, 4)
            quantity = max(min(quantity, config.MAX_TRADE_SIZE), config.MIN_TRADE_SIZE)
            logger.info(f"📊 Cantidad calculada para {symbol}: {quantity}")

            trade_value = quantity * last_price
            if trade_value > self.capital:
                logger.warning(f"⚠️ Cantidad excesiva ({trade_value:.2f}) para {symbol}. Ajustando...")
                quantity = (self.capital * 0.9) / last_price
                quantity = round(quantity, 4)
                if quantity < config.MIN_TRADE_SIZE:
                    quantity = config.MIN_TRADE_SIZE
                elif quantity > config.MAX_TRADE_SIZE:
                    quantity = config.MAX_TRADE_SIZE
                logger.info(f"📊 Cantidad ajustada para {symbol}: {quantity}")
                trade_value = quantity * last_price
                if trade_value > self.capital:
                    logger.warning(f"⚠️ Cantidad ajustada sigue siendo excesiva ({trade_value:.2f}). Saltando trade.")
                    return

            order_type = str(getattr(config, "ORDER_TYPE", "limit") or "limit").lower()
            entry_price = last_price
            if order_type == "limit":
                shift = float(getattr(config, "PRICE_SHIFT_FACTOR", 0.0) or 0.0)
                shift = max(0.0, shift)
                try:
                    best_bid = float((orderbook.get("bids") or [])[0][0])
                except Exception:
                    best_bid = 0.0
                try:
                    best_ask = float((orderbook.get("asks") or [])[0][0])
                except Exception:
                    best_ask = 0.0

                if decision == "buy":
                    if best_ask > 0:
                        entry_price = best_ask * (1 + shift)
                else:
                    if best_bid > 0:
                        entry_price = best_bid * (1 - shift)

                if entry_price <= 0:
                    entry_price = last_price

            strategy = TpslStrategy(fee_rate=config.FEE_RATE, max_drawdown=config.MAX_DRAWDOWN)
            tp, sl = strategy.calculate_take_profit_stop_loss(entry_price, decision.upper(), volatility)
            if tp <= 0 or sl <= 0:
                logger.warning(f"⚠️ TP/SL inválidos ({tp}, {sl}), usando valores predeterminados")
                tp = entry_price * (1 + config.TP_PERCENTAGE) if decision == "buy" else entry_price * (
                        1 - config.TP_PERCENTAGE)
                sl = entry_price * (1 - config.SL_PERCENTAGE) if decision == "buy" else entry_price * (
                        1 + config.SL_PERCENTAGE)
            logger.info(f"📌 TP={tp:.2f} y SL={sl:.2f} calculados para {symbol}")

            fixed_timestamp = await get_synced_time()
            order_result = await self._place_order(symbol, decision, quantity, entry_price, tp, sl, fixed_timestamp)
            if not order_result.get("success", False):
                logger.error(
                    f"❌ Fallo al colocar orden para {symbol}: {order_result.get('message', 'Error desconocido')}")
                self.trade_id_counter += 1
                failed_trade = Trade(
                    trade_id=self.trade_id_counter - 1,
                    timestamp=current_time,
                    symbol=symbol,
                    action=decision,
                    entry_price=entry_price,
                    exit_price=None,
                    quantity=quantity,
                    profit_loss=0.0,
                    decision="failed",
                    combined=metrics.get("combined", 0.0),
                    ild=metrics.get("ild", 0.0),
                    egm=metrics.get("egm", 0.0),
                    rol=metrics.get("rol", 0.0),
                    pio=metrics.get("pio", 0.0),
                    ogm=metrics.get("ogm", 0.0),
                    risk_reward_ratio=config.TP_PERCENTAGE / config.SL_PERCENTAGE,
                    order_id=None
                )
                db.add(failed_trade)
                try:
                    db.commit()
                except IntegrityError as e:
                    db.rollback()
                    msg = str(e).lower()
                    if "trades.trade_id" in msg or "unique constraint failed: trades.trade_id" in msg:
                        new_trade_id = int(_load_initial_trade_id())
                        failed_trade.trade_id = new_trade_id
                        self.trade_id_counter = new_trade_id + 1
                        db.add(failed_trade)
                        db.commit()
                    else:
                        raise

                failed_position = {
                    "trade_id": failed_trade.trade_id,
                    "order_id": None,
                    "order_link_id": None,
                    "symbol": symbol,
                    "action": decision,
                    "entry_price": self._as_float(entry_price),
                    "exit_price": None,
                    "quantity": self._as_float(quantity),
                    "profit_loss": 0.0,
                    "decision": "failed",
                    "combined": self._as_float(metrics.get("combined", 0.0)) or 0.0,
                    "ild": self._as_float(metrics.get("ild", 0.0)) or 0.0,
                    "egm": self._as_float(metrics.get("egm", 0.0)) or 0.0,
                    "rol": self._as_float(metrics.get("rol", 0.0)) or 0.0,
                    "pio": self._as_float(metrics.get("pio", 0.0)) or 0.0,
                    "ogm": self._as_float(metrics.get("ogm", 0.0)) or 0.0,
                    "exit_order_id": None,
                    "timestamp": current_time.isoformat(),
                    "tp": self._as_float(tp),
                    "sl": self._as_float(sl),
                    "status": "failed",
                }
                self.positions.setdefault(symbol, []).append(failed_position)
                self.trade_buffer.setdefault(symbol, []).append(failed_position)
                self.last_trade_time[symbol] = current_time
                await self._save_results(symbol, failed_trade)
                self.consecutive_errors += 1
                if self.consecutive_errors >= self.max_consecutive_errors:
                    logger.warning(
                        f"⏸ Demasiados errores consecutivos ({self.consecutive_errors}). Pausando bot por {self.pause_duration} segundos.")
                    self._trigger_pause(self.pause_duration)
                    self.consecutive_errors = 0
                return

            order_id = order_result.get("order_id")
            if not order_id:
                logger.error(f"❌ No se obtuvo order_id para la orden de {symbol}")
                return

            order_link_id = order_result.get("order_link_id")

            self.trade_id_counter += 1

            trade = Trade(
                trade_id=self.trade_id_counter - 1,
                timestamp=current_time,
                symbol=symbol,
                action=decision,
                entry_price=entry_price,
                exit_price=None,
                quantity=quantity,
                profit_loss=0.0,
                decision=decision,
                combined=metrics.get("combined", 0.0),
                ild=metrics.get("ild", 0.0),
                egm=metrics.get("egm", 0.0),
                rol=metrics.get("rol", 0.0),
                pio=metrics.get("pio", 0.0),
                ogm=metrics.get("ogm", 0.0),
                risk_reward_ratio=config.TP_PERCENTAGE / config.SL_PERCENTAGE,
                order_id=order_id,
                order_link_id=order_link_id,
            )
            db.add(trade)

            position = Position(
                order_id=order_id,
                order_link_id=order_link_id,
                symbol=symbol,
                action=decision,
                entry_price=entry_price,
                quantity=quantity,
                timestamp=current_time,
                tp=tp,
                sl=sl,
                status="pending"
            )
            db.add(position)
            try:
                db.commit()
            except IntegrityError as e:
                db.rollback()
                msg = str(e).lower()
                if "trades.trade_id" in msg or "unique constraint failed: trades.trade_id" in msg:
                    new_trade_id = int(_load_initial_trade_id())
                    trade.trade_id = new_trade_id
                    self.trade_id_counter = new_trade_id + 1
                    db.add(trade)
                    db.add(position)
                    db.commit()
                else:
                    raise

            position_dict = {
                "trade_id": trade.trade_id,
                "order_id": position.order_id,
                "order_link_id": position.order_link_id,
                "symbol": position.symbol,
                "action": position.action,
                "entry_price": self._as_float(position.entry_price),
                "exit_price": None,
                "quantity": self._as_float(position.quantity),
                "profit_loss": 0.0,
                "decision": trade.decision,
                "combined": self._as_float(trade.combined) or 0.0,
                "ild": self._as_float(trade.ild) or 0.0,
                "egm": self._as_float(trade.egm) or 0.0,
                "rol": self._as_float(trade.rol) or 0.0,
                "pio": self._as_float(trade.pio) or 0.0,
                "ogm": self._as_float(trade.ogm) or 0.0,
                "exit_order_id": None,
                "timestamp": position.timestamp.isoformat(),
                "tp": self._as_float(position.tp),
                "sl": self._as_float(position.sl),
                "status": position.status
            }

            self.positions.setdefault(symbol, []).append(position_dict)
            self.trade_buffer[symbol].append(position_dict)
            self.last_trade_time[symbol] = current_time

            logger.info(
                f"💰 Orden colocada: {decision.upper()} {quantity:.6f} {symbol} @ {entry_price:.2f}, TP={tp:.2f}, SL={sl:.2f}, OrderID={trade.order_id}, Capital={self.capital:.2f}")

            # Iniciar la verificación periódica del estado de la orden
            existing_task = self.order_status_tasks.get(order_id)
            if existing_task is None or existing_task.done():
                self.order_status_tasks[order_id] = asyncio.create_task(self._check_order_status(symbol, order_id, side=decision))

            self.iterations += 1
            if config.MAX_ITERATIONS > 0 and self.iterations >= config.MAX_ITERATIONS:
                logger.info("🏁 Máximo de iteraciones alcanzado. Deteniendo bot.")
                self.stop()

            if sum(len(trades) for trades in self.trade_buffer.values()) >= self.buffer_size:
                try:
                    await self._save_results(symbol, trade)
                except Exception as e:
                    logger.error(f"❌ Error al guardar resultados para {symbol}: {e}")
        except Exception as e:
            logger.error(f"❌ Error en _execute_trade para {symbol}: {e}")
            self.error_count += 1
            self.consecutive_errors += 1
            if self.consecutive_errors >= self.max_consecutive_errors:
                logger.warning(
                    f"⏸ Demasiados errores consecutivos ({self.consecutive_errors}). Pausando bot por {self.pause_duration} segundos.")
                self.consecutive_errors = 0
                self._trigger_pause(self.pause_duration)
            if self.error_count >= self.max_errors:
                logger.critical(f"❌ Demasiados errores ({self.error_count}). Deteniendo bot.")
                self.stop()

    async def _execute_trade_on_ticker(self, symbol: str, db: Session) -> None:
        current_time = int(time.time() * 1000)
        if current_time - self.last_kline_time.get(symbol, 0) > 60000:
            await self._refresh_market_state_if_stale(symbol)
            self._request_trade(symbol)

    async def _place_order(self, symbol: str, action: str, quantity: float, price: float, tp: float, sl: float,
                           fixed_timestamp: int = None) -> dict[str, Union[str, bool]]:
        max_retries = 3
        base_recv_window = int(config.RECV_WINDOW)
        max_delay = 15
        session = None
        insufficient_balance: bool = False

        if not symbol or not isinstance(symbol, str):
            logger.error(f"❌ Símbolo inválido: {symbol}")
            return {"success": False, "order_id": None, "message": "Símbolo inválido"}
        if action.lower() not in ["buy", "sell"]:
            logger.error(f"❌ Acción inválida: {action}")
            return {"success": False, "order_id": None, "message": "Acción debe ser 'buy' o 'sell'"}
        if quantity <= 0 or not isinstance(quantity, (int, float)):
            logger.error(f"❌ Cantidad inválida: {quantity}")
            return {"success": False, "order_id": None, "message": "Cantidad debe ser positiva"}
        if price <= 0 and config.ORDER_TYPE.lower() == "limit":
            logger.error(f"❌ Precio inválido: {price}")
            return {"success": False, "order_id": None, "message": "Precio debe ser positivo para órdenes limit"}
        if tp <= 0 or sl <= 0:
            logger.warning(f"⚠ TP o SL inválidos ({tp}, {sl}), se omitirán en la orden")
            tp, sl = 0.0, 0.0

        for attempt in range(max_retries):
            if insufficient_balance:
                logger.error(f"❌ Saldo insuficiente detectado, cancelando reintentos para {symbol}")
                self.error_count += 1
                self.consecutive_errors += 1
                if self.consecutive_errors >= self.max_consecutive_errors:
                    logger.warning(
                        f"⏸ Demasiados errores consecutivos ({self.consecutive_errors}). Pausando bot por {self.pause_duration} segundos.")
                    self.consecutive_errors = 0
                    self._trigger_pause(self.pause_duration)
                if self.error_count >= self.max_errors:
                    logger.critical(f"❌ Demasiados errores ({self.error_count}). Deteniendo bot.")
                    self.stop()
                return {"success": False, "order_id": None, "message": "Saldo insuficiente, reintentos cancelados"}
            try:
                if not config.BYBIT_API_KEY or not config.BYBIT_API_SECRET:
                    logger.warning(f"⚠️ Sin API keys, simulando orden: {action.upper()} {quantity:.6f} {symbol}")
                    return {
                        "success": True,
                        "order_id": f"sim-{self.trade_id_counter}",
                        "order_link_id": f"nertz-sim-{self.trade_id_counter}",
                        "message": "Orden simulada",
                    }

                timestamp = fixed_timestamp if fixed_timestamp else await get_synced_time()
                logger.info(f"📅 Timestamp usado: {timestamp}")
                recv_window = base_recv_window + (attempt * 5000)

                session = HTTP(
                    testnet=config.USE_TESTNET,
                    api_key=config.BYBIT_API_KEY,
                    api_secret=config.BYBIT_API_SECRET
                )

                for retry in range(3):
                    try:
                        wallet_response = session.get_wallet_balance(accountType="UNIFIED", timestamp=str(timestamp),
                                                                     recvWindow=str(int(recv_window)))
                        logger.debug(f"📥 Respuesta de wallet: {json.dumps(wallet_response, indent=2)}")
                        if wallet_response.get("retCode") != 0:
                            raise Exception(f"Error en balance: {wallet_response.get('retMsg')}")
                        wallet = wallet_response["result"]["list"][0]["coin"]
                        available_usdt = float(next((c["walletBalance"] for c in wallet if c["coin"] == "USDT"), 0.0))
                        locked_usdt = float(next((c["locked"] for c in wallet if c["coin"] == "USDT"), 0.0))
                        available_usdt -= locked_usdt
                        available_btc = float(next((c["walletBalance"] for c in wallet if c["coin"] == "BTC"), 0.0))
                        break
                    except Exception as e:
                        logger.warning(f"⚠ Intento {retry + 1}/3 fallido al obtener balance: {e}")
                        if retry < 2:
                            await asyncio.sleep(2)
                        else:
                            raise Exception(f"No se pudo obtener el balance: {str(e)}")

                if action.lower() == "buy" and (quantity * price > available_usdt):
                    insufficient_balance = True
                    return {"success": False, "order_id": None,
                            "message": f"Saldo USDT insuficiente: {available_usdt:.2f}, requerido: {quantity * price:.2f}"}
                elif action.lower() == "sell" and (quantity > available_btc):
                    insufficient_balance = True
                    return {"success": False, "order_id": None,
                            "message": f"Saldo BTC insuficiente: {available_btc:.6f}, requerido: {quantity:.6f}"}

                side = "Buy" if action.lower() == "buy" else "Sell"
                order_type = config.ORDER_TYPE.lower()
                category = "spot"
                time_in_force = config.TIME_IN_FORCE

                # Agregar un identificador único para las órdenes del bot
                order_link_id = f"nertz-{self.trade_id_counter}-{int(time.time() * 1000)}"

                order_type_param = "Limit" if order_type == "limit" else "Market"
                if order_type_param == "Market":
                    time_in_force = "ImmediateOrCancel"

                order_params = {
                    "category": category,
                    "symbol": symbol,
                    "side": side,
                    "orderType": order_type_param,
                    "qty": f"{quantity:.6f}",
                    "timeInForce": time_in_force,
                    "timestamp": str(timestamp),
                    "recvWindow": str(int(recv_window)),
                    "orderLinkId": order_link_id
                }
                if order_type == "limit":
                    order_params["price"] = f"{price:.2f}"

                if tp > 0 and sl > 0:
                    if category != "spot":
                        order_params["takeProfit"] = f"{tp:.2f}"
                        order_params["stopLoss"] = f"{sl:.2f}"
                        order_params["tpTriggerBy"] = "LastPrice"
                        order_params["slTriggerBy"] = "LastPrice"
                        logger.info(f"📌 TP={tp:.2f} y SL={sl:.2f} establecidos en Bybit para la orden")
                    else:
                        logger.info(f"📌 TP={tp:.2f} y SL={sl:.2f} calculados; enviando orden spot sin TP/SL")
                else:
                    logger.debug("⚠ No se definieron TP o SL para la orden")

                response = session.place_order(**order_params)
                logger.debug(f"📥 Respuesta de pybit: {json.dumps(response, indent=2)}")

                if response.get("retCode") == 0:
                    order_id = response["result"]["orderId"]
                    logger.info(
                        f"✅ Orden colocada: {symbol} {side} {quantity:.6f} @ {price if order_type.lower() == 'limit' else 'market'}, OrderID={order_id}, OrderLinkId={order_link_id}")
                    self.consecutive_errors = 0  # Resetear contador de errores consecutivos
                    return {"success": True, "order_id": str(order_id), "order_link_id": str(order_link_id), "message": "Orden exitosa"}
                else:
                    logger.error(
                        f"❌ Error al colocar orden: retCode={response.get('retCode')}, retMsg={response.get('retMsg')}")
                    if "Insufficient balance" in response.get('retMsg', ''):
                        insufficient_balance = True
                    raise Exception(f"retCode: {response.get('retCode')}, retMsg: {response.get('retMsg')}")
            except Exception as e:
                error_msg = str(e)
                logger.error(
                    f"❌ Fallo al colocar orden para {symbol} (intento {attempt + 1}/{max_retries}): {error_msg}")
                if attempt < max_retries - 1:
                    delay = min(2 ** attempt, max_delay)
                    logger.info(f"⏳ Reintentando en {delay} segundos...")
                    await asyncio.sleep(delay)
                else:
                    return {"success": False, "order_id": None, "message": error_msg}
            finally:
                if session:
                    session = None

        return {"success": False, "order_id": None, "message": "Máximo de reintentos alcanzado"}

    async def _place_exit_order(
            self,
            symbol: str,
            action: str,
            quantity: float,
            fixed_timestamp: int = None,
            parent_order_id: Optional[str] = None
    ) -> dict[str, Union[str, bool]]:
        max_retries = 3
        base_recv_window = int(config.RECV_WINDOW)
        max_delay = 15
        session = None

        if not symbol or not isinstance(symbol, str):
            return {"success": False, "order_id": None, "message": "Símbolo inválido"}
        if action.lower() not in ["buy", "sell"]:
            return {"success": False, "order_id": None, "message": "Acción debe ser 'buy' o 'sell'"}
        if quantity <= 0 or not isinstance(quantity, (int, float)):
            return {"success": False, "order_id": None, "message": "Cantidad debe ser positiva"}

        for attempt in range(max_retries):
            try:
                if not config.BYBIT_API_KEY or not config.BYBIT_API_SECRET:
                    sim_parent = parent_order_id or int(time.time() * 1000)
                    return {
                        "success": True,
                        "order_id": f"sim-exit-{sim_parent}",
                        "order_link_id": f"nertz-exit-{sim_parent}",
                        "message": "Orden simulada",
                    }

                timestamp = fixed_timestamp if fixed_timestamp else await get_synced_time()
                recv_window = base_recv_window + (attempt * 5000)

                session = HTTP(
                    testnet=config.USE_TESTNET,
                    api_key=config.BYBIT_API_KEY,
                    api_secret=config.BYBIT_API_SECRET
                )

                side = "Buy" if action.lower() == "buy" else "Sell"
                if parent_order_id:
                    order_link_id = f"nertz-exit-{parent_order_id}"
                else:
                    order_link_id = f"nertz-exit-{int(time.time() * 1000)}"

                order_params = {
                    "category": "spot",
                    "symbol": symbol,
                    "side": side,
                    "orderType": "Market",
                    "qty": f"{quantity:.6f}",
                    "timeInForce": "ImmediateOrCancel",
                    "timestamp": str(timestamp),
                    "recvWindow": str(int(recv_window)),
                    "orderLinkId": order_link_id
                }

                response = session.place_order(**order_params)
                if response.get("retCode") == 0:
                    order_id = response["result"]["orderId"]
                    return {"success": True, "order_id": str(order_id), "order_link_id": str(order_link_id), "message": "Orden exitosa"}
                raise Exception(f"retCode: {response.get('retCode')}, retMsg: {response.get('retMsg')}")
            except Exception as e:
                if attempt < max_retries - 1:
                    delay = min(2 ** attempt, max_delay)
                    await asyncio.sleep(delay)
                else:
                    return {"success": False, "order_id": None, "message": str(e)}
            finally:
                if session:
                    session = None

        return {"success": False, "order_id": None, "message": "Máximo de reintentos alcanzado"}

    async def _check_order_status(self, symbol: str, order_id: str, side: str) -> None:
        try:
            session = HTTP(
                testnet=config.USE_TESTNET,
                api_key=config.BYBIT_API_KEY,
                api_secret=config.BYBIT_API_SECRET
            )
            max_retries = 5
            retry_delay = 1
            check_interval = 5
            filled_statuses = {"filled", "partiallyfilled", "partiallyfilledcanceled"}
            cancelled_statuses = {"cancelled", "canceled", "rejected", "deactivated"}
            while True:
                with SessionLocal() as db:
                    trade = db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                    position = db.query(Position).filter_by(order_id=order_id).order_by(Position.id.desc()).first()
                    if not trade or not position:
                        return

                    if position.symbol != symbol:
                        return

                    if position.status in ["closed", "cancelled"]:
                        return

                    if bool(getattr(config, "SPOT_LONG_ONLY", True)) and str(trade.action).lower() == "sell":
                        try:
                            info = await self._fetch_spot_order_history_info(session, symbol, order_id, getattr(trade, "order_link_id", None))
                            if info:
                                resolved_order_id = info.get("orderId")
                                if resolved_order_id and str(resolved_order_id) != str(trade.order_id):
                                    old_order_id = str(trade.order_id)
                                    new_order_id = str(resolved_order_id)
                                    trade.order_id = new_order_id
                                    position.order_id = new_order_id
                                    db.commit()
                                    self._migrate_internal_order_key(symbol, old_order_id, new_order_id)
                                    order_id = new_order_id
                                status = str(info.get("orderStatus", "")).lower()
                                if status in filled_statuses:
                                    executed_qty = float(info.get("cumExecQty", "0.0") or 0.0)
                                    avg_price = float(info.get("avgPrice") or 0.0)
                                    if avg_price <= 0 and executed_qty > 0:
                                        cum_exec_value = float(info.get("cumExecValue") or 0.0)
                                        if cum_exec_value > 0:
                                            avg_price = cum_exec_value / executed_qty
                                    exit_price = avg_price if avg_price > 0 else float(trade.entry_price)
                                    qty_used = executed_qty if executed_qty > 0 else float(position.quantity or 0.0)
                                    entry_price = float(position.entry_price or trade.entry_price or 0.0)
                                    fee_usdt = self._spot_order_fee_usdt(symbol, info)
                                    pnl = 0.0
                                    if qty_used > 0 and entry_price > 0 and exit_price > 0:
                                        pnl = (exit_price - entry_price) * qty_used
                                        pnl -= fee_usdt
                                    trade.exit_price = exit_price
                                    trade.profit_loss = pnl
                                    trade.decision = "closed_external"
                                    position.status = "closed"
                                    db.commit()
                                    updates = {
                                        "status": "closed",
                                        "exit_price": exit_price,
                                        "profit_loss": pnl,
                                        "decision": "closed_external",
                                        "exit_order_id": None,
                                    }
                                    if fee_usdt > 0:
                                        updates["fees_usdt"] = fee_usdt
                                    self._update_position_cache(symbol, order_id, updates)
                                    self.capital = await self.fetch_real_balance()
                                    with SessionLocal() as inner_db:
                                        refreshed = inner_db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                                        if refreshed:
                                            await self._save_results(symbol, refreshed)
                                    return
                                if status in cancelled_statuses:
                                    trade.exit_price = None
                                    trade.profit_loss = 0.0
                                    trade.decision = "cancelled"
                                    position.status = "cancelled"
                                    db.commit()
                                    self._update_position_cache(symbol, order_id, {
                                        "status": "cancelled",
                                        "exit_price": None,
                                        "profit_loss": 0.0,
                                        "decision": "cancelled",
                                        "exit_order_id": None,
                                    })
                                    with SessionLocal() as inner_db:
                                        refreshed = inner_db.query(Trade).filter_by(order_id=order_id).order_by(Trade.id.desc()).first()
                                        if refreshed:
                                            await self._save_results(symbol, refreshed)
                                    return
                        except Exception:
                            pass

                    if trade.decision not in ["closed", "cancelled", "failed"] and isinstance(trade.exit_price, (int, float)) and float(trade.exit_price) == 0.0:
                        trade.exit_price = None
                        db.commit()

                    exit_order_id = self.exit_orders.get(order_id)
                    if not exit_order_id:
                        for position_dict in self.positions.get(symbol, []):
                            if position_dict.get("order_id") == order_id:
                                exit_order_id = position_dict.get("exit_order_id")
                                break

                    if position.status == "closing" and not exit_order_id:
                        discovered = await self._discover_exit_order(symbol, parent_order_id=order_id, action=trade.action)
                        if discovered:
                            discovered_id = discovered.get("orderId")
                            if discovered_id:
                                exit_order_id = discovered_id
                                self.exit_orders[order_id] = discovered_id
                                self._update_position_cache(symbol, order_id, {"exit_order_id": discovered_id})
                        if not exit_order_id:
                            position.status = "open"
                            db.commit()
                            self.exit_orders.pop(order_id, None)
                            self._update_position_cache(symbol, order_id, {"status": "open", "exit_order_id": None})

                    if position.status == "closing" and exit_order_id:
                        for attempt in range(max_retries):
                            try:
                                timestamp = await get_synced_time()
                                history_response = session.get_order_history(
                                    category="spot",
                                    symbol=symbol,
                                    orderId=exit_order_id,
                                    timestamp=str(timestamp),
                                    recvWindow=str(int(config.RECV_WINDOW))
                                )
                                if history_response.get("retCode") != 0:
                                    if self._is_order_not_found_response(history_response):
                                        position.status = "open"
                                        db.commit()
                                        self.exit_orders.pop(order_id, None)
                                        self._update_position_cache(symbol, order_id, {
                                            "status": "open",
                                            "exit_order_id": None,
                                        })
                                        break
                                    await asyncio.sleep(retry_delay)
                                    continue

                                if history_response.get("retCode") == 0 and history_response["result"]["list"]:
                                    exit_info = history_response["result"]["list"][0]
                                    exit_link_id = exit_info.get("orderLinkId")
                                    if exit_link_id and not str(exit_link_id).startswith("nertz-"):
                                        return
                                    exit_status = exit_info.get("orderStatus", "").lower()
                                    if exit_status in filled_statuses:
                                        executed_qty = float(exit_info.get("cumExecQty", "0.0"))
                                        if executed_qty <= 0:
                                            return
                                        try:
                                            entry_info = await self._fetch_spot_order_history_info(
                                                session,
                                                symbol,
                                                order_id,
                                                getattr(trade, "order_link_id", None),
                                            )
                                        except Exception:
                                            entry_info = None

                                        pnl_details = {}

                                        if entry_info:
                                            realized = self._compute_spot_realized_pnl_usdt(symbol, entry_info, exit_info, trade.action)
                                            exit_price = float(realized.get("exit_avg_price") or 0.0) or float(
                                                self.ticker_data.get(symbol, {}).get("last_price", trade.entry_price) or trade.entry_price
                                            )
                                            pnl = float(realized.get("pnl_net_usdt") or 0.0)
                                            qty_used = float(realized.get("qty_executed") or executed_qty)
                                            entry_avg = float(realized.get("entry_avg_price") or 0.0)
                                            if entry_avg > 0:
                                                trade.entry_price = entry_avg
                                                position.entry_price = entry_avg
                                            trade.quantity = qty_used
                                            position.quantity = qty_used

                                            pnl_details = {
                                                "entry_value_usdt": float(realized.get("entry_value_usdt") or 0.0),
                                                "exit_value_usdt": float(realized.get("exit_value_usdt") or 0.0),
                                                "fees_usdt": float(realized.get("fees_usdt") or 0.0),
                                                "pnl_gross_usdt": float(realized.get("pnl_gross_usdt") or 0.0),
                                                "pnl_net_usdt": float(realized.get("pnl_net_usdt") or 0.0),
                                            }
                                        else:
                                            exit_price = float(self._spot_order_avg_price(exit_info) or 0.0) or float(
                                                self.ticker_data.get(symbol, {}).get("last_price", trade.entry_price) or trade.entry_price
                                            )
                                            entry_price = float(trade.entry_price)
                                            pnl = (exit_price - entry_price) * executed_qty if trade.action == "buy" else (
                                                entry_price - exit_price
                                            ) * executed_qty
                                            pnl *= (1 - config.FEE_RATE)

                                        trade.exit_price = exit_price
                                        trade.profit_loss = pnl
                                        trade.decision = "closed"
                                        position.status = "closed"
                                        db.commit()

                                        updates = {
                                            "status": "closed",
                                            "exit_price": exit_price,
                                            "profit_loss": pnl,
                                            "exit_order_id": exit_order_id,
                                            "decision": "closed",
                                        }
                                        if pnl_details:
                                            updates.update(pnl_details)
                                        self._update_position_cache(symbol, order_id, updates)

                                        if config.BYBIT_API_KEY and config.BYBIT_API_SECRET:
                                            self.capital = await self.fetch_real_balance()
                                        else:
                                            self.capital += pnl
                                        await self._save_results(symbol, trade)
                                        self.exit_orders.pop(order_id, None)
                                        return
                                    if exit_status in cancelled_statuses:
                                        position.status = "open"
                                        db.commit()
                                        self.exit_orders.pop(order_id, None)
                                        self._update_position_cache(symbol, order_id, {
                                            "status": "open",
                                            "exit_order_id": None,
                                        })
                                        break
                                else:
                                    await asyncio.sleep(retry_delay)
                            except Exception:
                                await asyncio.sleep(retry_delay)
                        await asyncio.sleep(check_interval)
                        continue

                    if position.status in ["pending", "open"] and not exit_order_id:
                        order_open = False
                        promoted_to_open = False
                        for attempt in range(max_retries):
                            try:
                                timestamp = await get_synced_time()
                                open_resp = session.get_open_orders(
                                    category="spot",
                                    symbol=symbol,
                                    orderId=order_id,
                                    timestamp=str(timestamp),
                                    recvWindow=str(int(config.RECV_WINDOW))
                                )
                                if open_resp.get("retCode") != 0:
                                    if self._is_order_not_found_response(open_resp):
                                        break
                                    await asyncio.sleep(retry_delay)
                                    continue

                                orders = open_resp["result"]["list"]
                                if not orders:
                                    break
                                open_link_id = orders[0].get("orderLinkId")
                                if open_link_id and not str(open_link_id).startswith("nertz-"):
                                    return

                                if position.status == "pending":
                                    executed_qty = float(orders[0].get("cumExecQty", "0.0") or 0.0)
                                    if executed_qty > 0:
                                        avg_entry_raw = float(orders[0].get("avgPrice") or 0.0)
                                        if avg_entry_raw <= 0:
                                            cum_exec_value = float(orders[0].get("cumExecValue") or 0.0)
                                            avg_entry = (cum_exec_value / executed_qty) if cum_exec_value > 0 else float(trade.entry_price)
                                        else:
                                            avg_entry = avg_entry_raw

                                        try:
                                            session.cancel_order(
                                                category="spot",
                                                symbol=symbol,
                                                orderId=order_id,
                                                timestamp=str(timestamp),
                                                recvWindow=str(int(config.RECV_WINDOW))
                                            )
                                        except Exception:
                                            pass

                                        if avg_entry > 0:
                                            trade.entry_price = avg_entry
                                            position.entry_price = avg_entry
                                        trade.quantity = executed_qty
                                        position.quantity = executed_qty
                                        position.status = "open"
                                        trade.exit_price = None
                                        db.commit()

                                        self._update_position_cache(symbol, order_id, {
                                            "status": "open",
                                            "entry_price": float(trade.entry_price),
                                            "quantity": float(position.quantity),
                                            "exit_price": None,
                                            "profit_loss": 0.0,
                                        })

                                        await self._save_results(symbol, trade)
                                        promoted_to_open = True
                                        break

                                order_open = True
                                break
                            except Exception:
                                pass
                            if attempt < max_retries - 1:
                                await asyncio.sleep(retry_delay)
                            else:
                                break

                        if promoted_to_open:
                            await asyncio.sleep(0)
                            continue

                        if order_open and position.status == "pending":
                            await asyncio.sleep(check_interval)
                            continue

                        for attempt in range(max_retries):
                            try:
                                timestamp = await get_synced_time()
                                history_response = session.get_order_history(
                                    category="spot",
                                    symbol=symbol,
                                    orderId=order_id,
                                    timestamp=str(timestamp),
                                    recvWindow=str(int(config.RECV_WINDOW))
                                )
                                if history_response.get("retCode") != 0:
                                    if self._is_order_not_found_response(history_response) and position.status == "pending":
                                        trade.exit_price = None
                                        trade.profit_loss = 0.0
                                        trade.decision = "cancelled"
                                        position.status = "cancelled"
                                        db.commit()

                                        self._update_position_cache(symbol, order_id, {
                                            "status": "cancelled",
                                            "exit_price": None,
                                            "profit_loss": 0.0,
                                            "decision": "cancelled",
                                        })
                                        await self._save_results(symbol, trade)
                                        return
                                    await asyncio.sleep(retry_delay)
                                    continue

                                if history_response.get("retCode") == 0 and history_response["result"]["list"]:
                                    order_info = history_response["result"]["list"][0]
                                    order_link_id = order_info.get("orderLinkId")
                                    if order_link_id and not str(order_link_id).startswith("nertz-"):
                                        return
                                    order_status = order_info.get("orderStatus", "").lower()

                                    if position.status == "pending":
                                        if order_status in filled_statuses:
                                            executed_qty = float(order_info.get("cumExecQty", "0.0"))
                                            if executed_qty <= 0:
                                                return
                                            avg_entry_raw = float(order_info.get("avgPrice") or 0.0)
                                            if avg_entry_raw <= 0:
                                                cum_exec_value = float(order_info.get("cumExecValue") or 0.0)
                                                avg_entry = (cum_exec_value / executed_qty) if cum_exec_value > 0 else float(trade.entry_price)
                                            else:
                                                avg_entry = avg_entry_raw
                                            if avg_entry > 0:
                                                trade.entry_price = avg_entry
                                                position.entry_price = avg_entry
                                            trade.quantity = executed_qty
                                            position.quantity = executed_qty
                                            position.status = "open"
                                            trade.exit_price = None
                                            db.commit()

                                            for position_dict in self.positions.get(symbol, []):
                                                if position_dict.get("order_id") == order_id:
                                                    position_dict["status"] = "open"
                                                    position_dict["entry_price"] = float(trade.entry_price)
                                                    position_dict["quantity"] = executed_qty
                                                    break

                                            await self._save_results(symbol, trade)
                                            break

                                        if order_status in cancelled_statuses:
                                            trade.exit_price = None
                                            trade.profit_loss = 0.0
                                            trade.decision = "cancelled"
                                            position.status = "cancelled"
                                            db.commit()

                                            self._update_position_cache(symbol, order_id, {
                                                "status": "cancelled",
                                                "exit_price": None,
                                                "profit_loss": 0.0,
                                                "decision": "cancelled",
                                            })

                                            await self._save_results(symbol, trade)
                                            return

                                        await asyncio.sleep(retry_delay)
                                        continue

                                    if position.status == "open":
                                        last_price = float(self.ticker_data.get(symbol, {}).get("last_price", 0.0))
                                        if last_price <= 0:
                                            last_price = float(trade.entry_price)

                                        tp = float(position.tp)
                                        sl = float(position.sl)
                                        hit_tp = last_price >= tp if trade.action == "buy" else last_price <= tp
                                        hit_sl = last_price <= sl if trade.action == "buy" else last_price >= sl

                                        if hit_tp or hit_sl:
                                            exit_action = "sell" if trade.action == "buy" else "buy"
                                            fixed_ts = await get_synced_time()
                                            exit_res = await self._place_exit_order(
                                                symbol=symbol,
                                                action=exit_action,
                                                quantity=float(position.quantity),
                                                fixed_timestamp=fixed_ts,
                                                parent_order_id=order_id
                                            )
                                            if exit_res.get("success"):
                                                exit_order_id = exit_res.get("order_id")
                                                self.exit_orders[order_id] = exit_order_id
                                                position.status = "closing"
                                                db.commit()

                                                for position_dict in self.positions.get(symbol, []):
                                                    if position_dict.get("order_id") == order_id:
                                                        position_dict["status"] = "closing"
                                                        position_dict["exit_order_id"] = exit_order_id
                                                        break

                                                await self._save_results(symbol, trade)
                                            break

                                        await asyncio.sleep(check_interval)
                                        break

                                    break
                                await asyncio.sleep(retry_delay)
                            except Exception:
                                await asyncio.sleep(retry_delay)

                await asyncio.sleep(check_interval)
        except Exception as e:
            logger.error(f"❌ Error en _check_order_status para {symbol}, OrderID={order_id}: {e}")
            self.error_count += 1
            self.consecutive_errors += 1
            if self.consecutive_errors >= self.max_consecutive_errors:
                logger.warning(
                    f"⏸ Demasiados errores consecutivos ({self.consecutive_errors}). Pausando bot por {self.pause_duration} segundos.")
                self.consecutive_errors = 0
                self._trigger_pause(self.pause_duration)
            if self.error_count >= self.max_errors:
                logger.critical(f"❌ Demasiados errores ({self.error_count}). Deteniendo bot.")
                self.stop()

    async def _save_results(
        self,
        symbol: str,
        trade_result: Optional[Trade] = None,
        include_wallet: bool = True,
    ) -> None:
        try:
            terminal_statuses = {"closed", "cancelled", "failed"}
            closed_statuses = {"closed"}

            all_trade_dicts: List[Dict[str, Any]] = []

            with SessionLocal() as db:
                db_trades: List[Trade] = db.query(Trade).order_by(Trade.timestamp.asc()).all()

                symbols_in_db = {
                    str(t.symbol or "").upper()
                    for t in db_trades
                    if str(t.symbol or "").strip()
                }
                configured_symbols = {str(s or "").upper() for s in (self.symbols or []) if str(s or "").strip()}
                symbol_keys = sorted(symbols_in_db | configured_symbols)
                trades_by_symbol: Dict[str, List[Dict[str, Any]]] = {sym: [] for sym in symbol_keys}

                order_ids = [t.order_id for t in db_trades if getattr(t, "order_id", None)]
                pos_by_order_id: Dict[str, Position] = {}
                if order_ids:
                    for p in db.query(Position).filter(Position.order_id.in_(order_ids)).all():
                        if p.order_id:
                            pos_by_order_id[str(p.order_id)] = p

            def _status_from_decision(decision: Any) -> Optional[str]:
                d = str(decision or "").lower()
                if d in {"closed", "closed_external"}:
                    return "closed"
                if d == "cancelled":
                    return "cancelled"
                if d == "failed":
                    return "failed"
                return None

            for t in db_trades:
                sym = str(t.symbol or "").upper()
                if not sym:
                    sym = "UNKNOWN"
                    trades_by_symbol.setdefault(sym, [])

                oid = getattr(t, "order_id", None)
                oid_str = str(oid) if oid is not None else None
                pos = pos_by_order_id.get(oid_str) if oid_str else None

                status = _status_from_decision(getattr(t, "decision", None))
                if status is None and pos is not None:
                    status = str(pos.status or "open")
                if status is None:
                    status = "open"

                entry_price = float(getattr(t, "entry_price", 0.0) or 0.0)
                exit_price = getattr(t, "exit_price", None)
                try:
                    exit_price_f = float(exit_price) if exit_price is not None else None
                except Exception:
                    exit_price_f = None
                if isinstance(exit_price_f, (int, float)) and float(exit_price_f) == 0.0 and status not in terminal_statuses:
                    exit_price_f = None

                qty = float(getattr(t, "quantity", 0.0) or 0.0)
                pnl_net = getattr(t, "profit_loss", None)
                try:
                    pnl_net_f = float(pnl_net) if pnl_net is not None else 0.0
                except Exception:
                    pnl_net_f = 0.0

                entry_val = entry_price * qty
                exit_val = (exit_price_f * qty) if (exit_price_f is not None) else None

                trade_dict = {
                    "trade_id": getattr(t, "trade_id", None),
                    "order_id": oid_str,
                    "order_link_id": getattr(t, "order_link_id", None),
                    "symbol": sym,
                    "action": getattr(t, "action", None),
                    "entry_price": entry_price,
                    "exit_price": exit_price_f,
                    "quantity": qty,
                    "profit_loss": pnl_net_f,
                    "decision": getattr(t, "decision", None),
                    "combined": self._as_float(getattr(t, "combined", 0.0)) or 0.0,
                    "ild": self._as_float(getattr(t, "ild", 0.0)) or 0.0,
                    "egm": self._as_float(getattr(t, "egm", 0.0)) or 0.0,
                    "rol": self._as_float(getattr(t, "rol", 0.0)) or 0.0,
                    "pio": self._as_float(getattr(t, "pio", 0.0)) or 0.0,
                    "ogm": self._as_float(getattr(t, "ogm", 0.0)) or 0.0,
                    "exit_order_id": (self.exit_orders.get(oid_str) if oid_str else None),
                    "timestamp": (t.timestamp.isoformat() if getattr(t, "timestamp", None) is not None else None),
                    "tp": (self._as_float(getattr(pos, "tp", None)) if pos is not None else None),
                    "sl": (self._as_float(getattr(pos, "sl", None)) if pos is not None else None),
                    "status": status,
                    "entry_value_usdt": entry_val,
                    "exit_value_usdt": exit_val,
                    "fees_usdt": 0.0,
                    "pnl_gross_usdt": pnl_net_f,
                    "pnl_net_usdt": pnl_net_f,
                }

                trades_by_symbol[sym].append(trade_dict)
                all_trade_dicts.append(trade_dict)

            total_profit = sum(
                float(tr.get("profit_loss") or 0.0)
                for tr in all_trade_dicts
                if (tr.get("status") in closed_statuses) and float(tr.get("profit_loss") or 0.0) > 0
            )
            total_loss = sum(
                float(tr.get("profit_loss") or 0.0)
                for tr in all_trade_dicts
                if (tr.get("status") in closed_statuses) and float(tr.get("profit_loss") or 0.0) < 0
            )
            closed_trades = sum(1 for tr in all_trade_dicts if tr.get("status") in closed_statuses)
            total_trades = sum(1 for tr in all_trade_dicts if tr.get("status") in terminal_statuses)

            profit_by_symbol = {
                sym: round(
                    sum(
                        float(tr.get("profit_loss") or 0.0)
                        for tr in (trades_by_symbol.get(sym) or [])
                        if (tr.get("status") in closed_statuses) and float(tr.get("profit_loss") or 0.0) > 0
                    ),
                    2,
                )
                for sym in trades_by_symbol.keys()
            }
            loss_by_symbol = {
                sym: round(
                    sum(
                        float(tr.get("profit_loss") or 0.0)
                        for tr in (trades_by_symbol.get(sym) or [])
                        if (tr.get("status") in closed_statuses) and float(tr.get("profit_loss") or 0.0) < 0
                    ),
                    2,
                )
                for sym in trades_by_symbol.keys()
            }

            net_profit = float(total_profit + total_loss)
            win_trades = sum(
                1
                for tr in all_trade_dicts
                if (tr.get("status") in closed_statuses) and float(tr.get("profit_loss") or 0.0) > 0
            )
            win_rate = (win_trades / closed_trades) if closed_trades > 0 else 0
            avg_profit_per_trade = round(net_profit / closed_trades, 4) if closed_trades > 0 else 0

            wallet_account_type = None
            wallet_usdt_available = float(self.capital or 0.0)
            wallet_usdt_balance = wallet_usdt_available
            wallet_usdt_locked = 0.0
            if include_wallet:
                wallet_snapshot = await self._get_wallet_snapshot(
                    max_age_seconds=float(getattr(config, "WALLET_CACHE_TTL_SECONDS", 5.0) or 5.0)
                )
                wallet_account_type = wallet_snapshot.get("accountType")
                usdt_info = (wallet_snapshot.get("coins") or {}).get("USDT") or {}
                wallet_usdt_available = self._float0(usdt_info.get("available"), float(self.capital or 0.0))
                wallet_usdt_balance = self._float0(usdt_info.get("walletBalance"), wallet_usdt_available)
                wallet_usdt_locked = self._float0(usdt_info.get("locked"), 0.0)

            correlations_by_symbol = {
                sym: self._compute_trade_correlations(trades_by_symbol.get(sym, []) or [])
                for sym in trades_by_symbol.keys()
            }
            correlations_all = self._compute_trade_correlations(all_trade_dicts)

            results = {
                "metadata": {
                    "session_start": self.session_start,
                    "timestamp": datetime.now(timezone.utc).isoformat(),
                    "capital_inicial": self.initial_capital,
                    "capital_actual": self.capital,
                    "capital_final": self.capital,
                    "total_pnl": round(net_profit, 2),
                    "total_pnl_precise": round(float(net_profit), 8),
                    "wallet_account_type": wallet_account_type,
                    "wallet_usdt": {
                        "available": round(wallet_usdt_available, 8),
                        "wallet_balance": round(wallet_usdt_balance, 8),
                        "locked": round(wallet_usdt_locked, 8),
                    },
                    "wallet_delta_usdt_available": round(wallet_usdt_available - float(self.initial_capital or 0.0), 8),
                    "total_trades": total_trades,
                    "iterations": self.iterations,
                    "running": self.running
                },
                "summary": {
                    "total_profit": round(total_profit, 2),
                    "total_loss": round(total_loss, 2),
                    "net_profit": round(net_profit, 2),
                    "net_profit_precise": round(float(net_profit), 8),
                    "win_rate": round(win_rate * 100, 2),
                    "avg_profit_per_trade": avg_profit_per_trade
                },
                "by_symbol": {
                    sym: {
                        "profit": profit_by_symbol[sym],
                        "loss": loss_by_symbol[sym],
                        "net_profit": round(profit_by_symbol[sym] + loss_by_symbol[sym], 2),
                        "trade_count": len([trade for trade in (trades_by_symbol.get(sym) or []) if trade.get("status") in terminal_statuses]),
                        "correlaciones": correlations_by_symbol.get(sym, {"n": 0, "to_pnl": {}, "matrix": {}}),
                    } for sym in trades_by_symbol.keys()
                },
                "correlaciones": {
                    "all": correlations_all,
                    "by_symbol": correlations_by_symbol,
                },
                "trades": trades_by_symbol
            }
            if trade_result:
                exit_price = trade_result.exit_price
                if isinstance(exit_price, (int, float)) and float(exit_price) == 0.0:
                    exit_price = None
                if trade_result.decision == "closed":
                    trade_status = "closed"
                elif trade_result.decision == "closed_external":
                    trade_status = "closed"
                elif trade_result.decision == "cancelled":
                    trade_status = "cancelled"
                elif trade_result.decision == "failed":
                    trade_status = "failed"
                else:
                    trade_status = "open"
                results["metadata"]["last_trade_timestamp"] = trade_result.timestamp.isoformat()

                last_exit_order_id = None
                try:
                    last_order_id = getattr(trade_result, "order_id", None)
                    if last_order_id:
                        last_exit_order_id = self.exit_orders.get(str(last_order_id))
                        if not last_exit_order_id:
                            for position_dict in self.positions.get(trade_result.symbol, []):
                                if position_dict.get("order_id") == str(last_order_id):
                                    last_exit_order_id = position_dict.get("exit_order_id")
                                    break
                except Exception:
                    last_exit_order_id = None
                results["last_trade"] = {
                    "trade_id": trade_result.trade_id,
                    "timestamp": trade_result.timestamp.isoformat(),
                    "symbol": trade_result.symbol,
                    "action": trade_result.action,
                    "entry_price": trade_result.entry_price,
                    "exit_price": exit_price,
                    "quantity": trade_result.quantity,
                    "profit_loss": trade_result.profit_loss,
                    "order_id": getattr(trade_result, "order_id", None),
                    "order_link_id": getattr(trade_result, "order_link_id", None),
                    "exit_order_id": last_exit_order_id,
                    "decision": trade_result.decision,
                    "combined": trade_result.combined,
                    "ild": trade_result.ild,
                    "egm": trade_result.egm,
                    "rol": trade_result.rol,
                    "pio": trade_result.pio,
                    "ogm": trade_result.ogm,
                    "risk_reward_ratio": trade_result.risk_reward_ratio,
                    "status": trade_status
                }

            log_dir = os.path.join(os.path.dirname(__file__), '..', 'logs')
            save_results(results, log_dir, self.session_start)
            logger.info(
                f"📊 Resultados guardados: Total PNL={round(net_profit, 2)} USDT, Capital={self.capital:.2f} USDT")
        except Exception as e:
            logger.error(f"❌ Error al guardar resultados: {e}")

        self.trade_buffer = {symbol: [] for symbol in self.symbols}

    async def reset_trades(self) -> None:
        try:
            self.positions = {symbol: [] for symbol in self.symbols}
            self.trade_buffer = {symbol: [] for symbol in self.symbols}
            self.trade_id_counter = 1

            with SessionLocal() as db:
                db.query(Trade).delete()
                db.query(Position).delete()
                db.query(MarketData).delete()
                db.query(Orderbook).delete()
                db.query(MarketTicker).delete()
                db.commit()

            self.iterations = 0
            self.last_trade_time = {symbol: datetime.min.replace(tzinfo=timezone.utc) for symbol in self.symbols}
            self.last_kline_time = {symbol: 0 for symbol in self.symbols}
            self.error_count = 0
            self.consecutive_errors = 0

            # Cancelar todas las órdenes abiertas
            for symbol in self.symbols:
                try:
                    session = HTTP(
                        testnet=config.USE_TESTNET,
                        api_key=config.BYBIT_API_KEY,
                        api_secret=config.BYBIT_API_SECRET
                    )
                    timestamp = await get_synced_time()
                    session.cancel_all_orders(
                        category="spot",
                        symbol=symbol,
                        timestamp=str(timestamp),
                        recvWindow=str(int(config.RECV_WINDOW))
                    )
                    logger.info(f"✅ Todas las órdenes abiertas para {symbol} canceladas")
                except Exception as e:
                    logger.error(f"❌ Error al cancelar órdenes para {symbol}: {e}")

            logger.info("🧹 Trades reseteados exitosamente")
        except Exception as e:
            logger.error(f"❌ Error al resetear trades: {e}")
            raise

    def stop(self) -> None:
        self.running = False
        if self.ws:
            asyncio.create_task(self.ws.close())
        if any(self.trade_buffer.values()):
            asyncio.create_task(self._save_results(None, None))
        if self.pause_task is not None and not self.pause_task.done():
            self.pause_task.cancel()
        logger.info("🛑 Bot detenido.")


