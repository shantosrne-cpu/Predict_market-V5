@app.get ("/metrics/{symbol}")
async def get_all_metrics (symbol: str, engine: services.trading_engine.TradingEngine = Depends (get_engine)):
    logger.info (f"📡 /metrics/{symbol}")
    try:
        # Fetching necessary data for metrics calculation
        candles = []
        orderbook_data = {"bids": [], "asks": []}
        ticker_data = {}

        def load_data (db):
            nonlocal candles, orderbook_data, ticker_data
            candles = db.query (MarketData).filter (MarketData.symbol == symbol).order_by (
                MarketData.timestamp.desc ()).limit (10).all ()
            orderbook = db.query (Orderbook).filter (Orderbook.symbol == symbol).order_by (
                Orderbook.timestamp.desc ()).first ()
            ticker = db.query (MarketTicker).filter (MarketTicker.symbol == symbol).order_by (
                MarketTicker.timestamp.desc ()).first ()
            if orderbook:
                orderbook_data = {"bids": orderbook.bids, "asks": orderbook.asks}
            if ticker:
                ticker_data = {
                    "last_price": ticker.last_price,
                    "volume_24h": ticker.volume_24h,
                    "high_24h": ticker.high_24h,
                    "low_24h": ticker.low_24h
                }

        execute_in_db (load_data)

        candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in
                       candles]
        metrics = calculate_metrics (candle_data, orderbook_data, ticker_data)
        if not metrics:
            logger.warning (f"⚠️ Métricas vacías para {symbol}")
            metrics = {"combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0}
        return {"symbol": symbol, "metrics": metrics, "timestamp": datetime.now (timezone.utc).isoformat () + "Z"}
    except Exception as exc:
        logger.error (f"❌ Error en /metrics: {exc}")
        raise HTTPException (status_code=500, detail=f"Error interno: {str (exc)}")


