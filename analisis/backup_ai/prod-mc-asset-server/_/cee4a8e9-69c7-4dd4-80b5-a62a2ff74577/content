import asyncio
import threading
import time
import uvicorn
from api.routes import app
from services.trading_engine import TradingEngine
from services.websocket import WebSocketService
from utils.logger import logger

API_PORT = 8081

def run_api():
    logger.info(f"Iniciando servidor API en http://127.0.0.1:{API_PORT}")
    try:
        uvicorn.run(app, host="127.0.0.1", port=API_PORT)
    except Exception as e:
        logger.error(f"Error al iniciar el servidor API: {e}")

async def run_websocket(websocket_service, engine):
    await websocket_service.start(engine)

if __name__ == "__main__":
    symbols = ["BTCUSDT", "ETHUSDT"]
    engines = {symbol: TradingEngine(WebSocketService()) for symbol in symbols}
    for engine in engines.values():
        engine.start()
    app.state.engines = engines
    logger.info("Motor metalero de NetHz listo para rockear!")
    ws_threads = [threading.Thread(target=lambda e=engine: asyncio.run(run_websocket(e.websocket_service, e)), daemon=True) for engine in engines.values()]
    for thread in ws_threads:
        thread.start()
        logger.info("Hilo de WebSocket iniciado")
    api_thread = threading.Thread(target=run_api, daemon=True)
    api_thread.start()
    logger.info("Hilo de API iniciado")
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        for engine in engines.values():
            engine.stop()
        logger.info("Programa detenido con estilo!")