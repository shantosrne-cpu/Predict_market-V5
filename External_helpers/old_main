    def _trigger_pause(self, seconds: float) -> None:
        now_ts = time.time()
        until = now_ts + float(seconds)
        if until > float(self.paused_until_ts or 0.0):
            self.paused_until_ts = until
        self.paused = True
        task = self.pause_task
        if task is None or task.done():
            self.pause_task = asyncio.create_task(self._pause_runner())

    async def _pause_runner(self) -> None:
        while self.running:
            remaining = float(self.paused_until_ts or 0.0) - time.time()
            if remaining <= 0:
                self.paused = False
                self.paused_until_ts = 0.0
                return
            await asyncio.sleep(min(1.0, remaining))

    async def _sync_supervisor_loop(self) -> None:
        while self.running:
            try:
                now_ts = time.time()
                for symbol in self.symbols:
                    if not self.running:
                        return
                    open_orders = await self._get_exchange_open_orders_count(
                        symbol,
                        max_age_seconds=float(getattr(config, "OPEN_ORDERS_CACHE_TTL_SECONDS", 5.0) or 5.0),
                    )
                    open_count = int(open_orders.get("count") or 0)
                    active_count = 0
                    for p in (self.positions.get(symbol) or []):
                        if (p or {}).get("status") in ["pending", "open", "closing"]:
                            active_count += 1

                    if active_count > 0 and open_count == 0:
                        last_seen = float(self.last_sync_mismatch_ts.get(symbol, 0.0) or 0.0)
                        if last_seen <= 0:
                            self.last_sync_mismatch_ts[symbol] = now_ts
                        elif (now_ts - last_seen) >= float(getattr(config, "SYNC_MISMATCH_FORCE_RECONCILE_SECONDS", 20.0) or 20.0):
                            await self.force_reconcile(
                                min_interval_seconds=float(getattr(config, "FORCE_RECONCILE_MIN_INTERVAL_SECONDS", 30.0) or 30.0)
                            )
                            self.last_sync_mismatch_ts[symbol] = now_ts
                    else:
                        self.last_sync_mismatch_ts[symbol] = 0.0
                await asyncio.sleep(float(getattr(config, "SYNC_SUPERVISOR_INTERVAL_SECONDS", 10.0) or 10.0))
            except Exception:
                await asyncio.sleep(2)

    async def force_reconcile(self, min_interval_seconds: float = 30.0, ignore_running: bool = False) -> Dict[str, Any]:
        now_ts = time.time()
        last_ts = float(self.last_force_reconcile_ts or 0.0)
        if (now_ts - last_ts) < float(min_interval_seconds):
            return {
                "started": False,
                "reason": "rate_limited",
                "cooldown_s": float(min_interval_seconds) - float(now_ts - last_ts),
            }

        async with self.force_reconcile_lock:
            now_ts = time.time()
            last_ts = float(self.last_force_reconcile_ts or 0.0)
            if self.force_reconcile_task is not None and not self.force_reconcile_task.done():
                return {"started": False, "reason": "already_running"}
            if (now_ts - last_ts) < float(min_interval_seconds):
                return {
                    "started": False,
                    "reason": "rate_limited",
                    "cooldown_s": float(min_interval_seconds) - float(now_ts - last_ts),
                }

            self.last_force_reconcile_ts = now_ts

            async def _runner() -> None:
                await self._startup_reconcile_positions(ignore_running=ignore_running)

            self.force_reconcile_task = asyncio.create_task(_runner())
            return {"started": True, "reason": "started"}

    def _request_trade(self, symbol: str) -> None:
        if symbol not in self.symbols:
            return
        now_ts = time.time()
        min_interval = float(getattr(config, "TRADE_EVAL_MIN_INTERVAL_SECONDS", 2.0) or 2.0)
        last_ts = float(self.last_trade_eval_request.get(symbol, 0.0) or 0.0)
        if (now_ts - last_ts) < min_interval:
            return
        self.last_trade_eval_request[symbol] = now_ts
        self.trade_requested[symbol] = True
        task = self.trade_tasks.get(symbol)
        if task is None or task.done():
            self.trade_tasks[symbol] = asyncio.create_task(self._trade_loop(symbol))

    async def _trade_loop(self, symbol: str) -> None:
        async with self.trade_locks[symbol]:
            while self.running and self.trade_requested.get(symbol, False):
                self.trade_requested[symbol] = False
                with SessionLocal() as db:
                    await self._execute_trade(symbol, db)
                await asyncio.sleep(0)

    async def _refresh_market_state_if_stale(self, symbol: str, max_age_seconds: float = 15.0) -> None:
        now = time.time()
        stale_ticker = now - self.last_ticker_update.get(symbol, 0.0) > max_age_seconds
        stale_orderbook = now - self.last_orderbook_update.get(symbol, 0.0) > max_age_seconds
        if not stale_ticker and not stale_orderbook:
            return

        async with aiohttp.ClientSession() as session:
            if stale_ticker:
                ticker_url = f"{BASE_URL}/v5/market/tickers"
                params = {"category": "spot", "symbol": symbol}
                ticker_response = await fetch_data(session, ticker_url, params)
                if ticker_response and "result" in ticker_response and "list" in ticker_response["result"]:
                    ticker_data = ticker_response["result"]["list"][0]
                    self.ticker_data[symbol] = {
                        "last_price": float(ticker_data.get("lastPrice", 0.0) or 0.0),
                        "volume_24h": float(ticker_data.get("volume24h", 0.0) or 0.0),
                        "high_24h": float(ticker_data.get("highPrice24h", 0.0) or 0.0),
                        "low_24h": float(ticker_data.get("lowPrice24h", 0.0) or 0.0),
                    }
                    self.last_ticker_update[symbol] = time.time()
                    with SessionLocal() as db:
                        market_ticker = MarketTicker(
                            timestamp=datetime.now(timezone.utc),
                            symbol=symbol,
                            last_price=self.ticker_data[symbol]["last_price"],
                            volume_24h=self.ticker_data[symbol]["volume_24h"],
                            high_24h=self.ticker_data[symbol]["high_24h"],
                            low_24h=self.ticker_data[symbol]["low_24h"]
                        )
                        db.add(market_ticker)
                        db.commit()

            if stale_orderbook:
                orderbook_url = f"{BASE_URL}/v5/market/orderbook"
                params = {"category": "spot", "symbol": symbol, "limit": "50"}
                ob_response = await fetch_data(session, orderbook_url, params)
                if ob_response and "result" in ob_response:
                    bids = ob_response["result"].get("b", [])
                    asks = ob_response["result"].get("a", [])
                    self.orderbook_data[symbol] = {"bids": bids, "asks": asks}
                    self.last_orderbook_update[symbol] = time.time()
                    with SessionLocal() as db:
                        bids_val = self.orderbook_data[symbol]["bids"]
                        asks_val = self.orderbook_data[symbol]["asks"]
                        for _ in range(2):
                            if isinstance(bids_val, str):
                                try:
                                    bids_val = json.loads(bids_val)
                                except Exception:
                                    bids_val = []
                            if isinstance(asks_val, str):
                                try:
                                    asks_val = json.loads(asks_val)
                                except Exception:
                                    asks_val = []

                        orderbook = Orderbook(
                            timestamp=datetime.now(timezone.utc),
                            symbol=symbol,
                            bids=bids_val,
                            asks=asks_val
                        )
                        db.add(orderbook)
                        db.commit()

    async def validate_symbols(self) -> None:
        """Valida que los símbolos sean tradables en Bybit."""
        async with aiohttp.ClientSession() as session:
            for symbol in self.symbols:
                try:
                    url = f"{BASE_URL}/v5/market/instruments-info"
                    params = {"category": "spot", "symbol": symbol}
                    response = await fetch_data(session, url, params)
                    if not response or "result" not in response or not response["result"]["list"]:
                        logger.error(f"❌ Símbolo {symbol} no es tradable en Bybit. Eliminando de la lista.")
                        self.symbols.remove(symbol)
                    else:
                        logger.info(f"✅ Símbolo {symbol} validado como tradable en Bybit.")
                except Exception as e:
                    logger.error(f"❌ Error al validar símbolo {symbol}: {e}. Eliminando de la lista.")
                    self.symbols.remove(symbol)
        if not self.symbols:
            logger.critical("❌ No hay símbolos válidos para operar. Deteniendo bot.")
            self.stop()

    def _load_positions(self) -> None:
        with SessionLocal() as db:
            for symbol in self.symbols:
                positions = db.query(Position).filter(
                    Position.symbol == symbol,
                    Position.status.in_(["pending", "open", "closing"])
                ).order_by(Position.timestamp.asc()).all()
                position_dicts = []
                for p in positions:
                    trade = db.query(Trade).filter_by(order_id=p.order_id).order_by(Trade.id.desc()).first()
                    exit_price = getattr(trade, "exit_price", None)
                    decision = getattr(trade, "decision", "open")
                    if isinstance(exit_price, (int, float)) and float(exit_price) == 0.0 and decision not in ["closed", "cancelled", "failed"]:
                        exit_price = None
                    position_dicts.append({
                        "trade_id": getattr(trade, "trade_id", None),
                        "order_id": p.order_id,
                        "order_link_id": getattr(p, "order_link_id", None),
                        "symbol": p.symbol,
                        "action": p.action,
                        "entry_price": self._as_float(p.entry_price),
                        "exit_price": self._as_float(exit_price),
                        "quantity": self._as_float(p.quantity),
                        "profit_loss": self._as_float(getattr(trade, "profit_loss", 0.0)) or 0.0,
                        "decision": decision,
                        "combined": self._as_float(getattr(trade, "combined", 0.0)) or 0.0,
                        "ild": self._as_float(getattr(trade, "ild", 0.0)) or 0.0,
                        "egm": self._as_float(getattr(trade, "egm", 0.0)) or 0.0,
                        "rol": self._as_float(getattr(trade, "rol", 0.0)) or 0.0,
                        "pio": self._as_float(getattr(trade, "pio", 0.0)) or 0.0,
                        "ogm": self._as_float(getattr(trade, "ogm", 0.0)) or 0.0,
                        "exit_order_id": None,
                        "timestamp": p.timestamp.isoformat(),
                        "tp": self._as_float(p.tp),
                        "sl": self._as_float(p.sl),
                        "status": p.status
                    })
                self.positions[symbol] = position_dicts

    def _resume_order_status_tasks(self) -> None:
        for symbol in self.symbols:
            for position_dict in self.positions.get(symbol, []):
                order_id = position_dict.get("order_id")
                if not order_id:
                    continue
                if position_dict.get("status") in ["closed", "cancelled"]:
                    continue
                existing_task = self.order_status_tasks.get(order_id)
                if existing_task is None or existing_task.done():
                    self.order_status_tasks[order_id] = asyncio.create_task(
                        self._check_order_status(symbol, order_id, side=position_dict.get("action", "buy"))
                    )

    async def _reconcile_active_positions_loop(self) -> None:
        while self.running:
            try:
                if self.paused:
                    await asyncio.sleep(1)
                    continue

                for symbol in self.symbols:
                    if not self.running:
                        return

                    with SessionLocal() as db:
                        active = (
                            db.query(Position)
                            .filter(
                                Position.symbol == symbol,
                                Position.status.in_(["pending", "open", "closing"])
                            )
                            .order_by(Position.timestamp.asc())
                            .limit(10)
                            .all()
                        )

                    now_ts = time.time()
                    last_reconcile = float(self.last_pending_reconcile.get(symbol, 0.0) or 0.0)
                    can_reconcile_pending = (now_ts - last_reconcile) >= 5.0
                    last_open_reconcile = float(self.last_open_reconcile.get(symbol, 0.0) or 0.0)
                    can_reconcile_open = (now_ts - last_open_reconcile) >= 20.0

                    for p in active:
                        if not self.running:
                            return

                        if p.status == "pending":
                            if can_reconcile_pending:
                                self.last_pending_reconcile[symbol] = now_ts
                                await self._reconcile_pending_entry(symbol, p.order_id)
                                can_reconcile_pending = False
                            await self._expire_pending_entry_if_needed(symbol, p.order_id, p.timestamp)
                            continue

                        if p.status in ["open", "closing"]:
                            if can_reconcile_open:
                                self.last_open_reconcile[symbol] = now_ts
                                await self._reconcile_open_position_with_wallet(symbol, p.order_id)
                                can_reconcile_open = False
                            existing_task = self.order_status_tasks.get(p.order_id)
                            if existing_task is None or existing_task.done():
                                self.order_status_tasks[p.order_id] = asyncio.create_task(
                                    self._check_order_status(symbol, p.order_id, side=p.action)
                                )

                await asyncio.sleep(2)
            except Exception as e:
                logger.error(f"❌ Error en loop de reconciliación: {e}")
                await asyncio.sleep(2)

    async def _startup_reconcile_positions(self, ignore_running: bool = False) -> None:
        try:
            self._load_positions()
            for symbol in self.symbols:
                if (not ignore_running) and (not self.running):
                    return
                with SessionLocal() as db:
                    active = (
                        db.query(Position)
                        .filter(
                            Position.symbol == symbol,
                            Position.status.in_(["pending", "open", "closing"])
                        )
                        .order_by(Position.timestamp.asc())
                        .limit(20)
                        .all()
                    )
                for p in active:
                    if (not ignore_running) and (not self.running):
                        return
                    if p.status == "pending":
                        await self._reconcile_pending_entry(symbol, p.order_id)
                        await self._expire_pending_entry_if_needed(symbol, p.order_id, p.timestamp)
                        continue
                    if p.status in ["open", "closing"]:
                        await self._reconcile_open_position_with_wallet(symbol, p.order_id)

            for symbol in self.symbols:
                if (not ignore_running) and (not self.running):
                    return
                open_orders = await self._get_exchange_open_orders_count(symbol, max_age_seconds=0.0)
                if int(open_orders.get("count") or 0) != 0:
                    continue
                with SessionLocal() as db:
                    active = (
                        db.query(Position)
                        .filter(
                            Position.symbol == symbol,
                            Position.status.in_(["pending", "open", "closing"])
                        )
                        .order_by(Position.timestamp.asc())
                        .limit(20)
                        .all()
                    )
                for p in active:
                    if (not ignore_running) and (not self.running):
                        return
                    if p.status == "pending":
                        await self._reconcile_pending_entry(symbol, p.order_id)
                        await self._expire_pending_entry_if_needed(symbol, p.order_id, p.timestamp)
                        continue
                    if p.status in ["open", "closing"]:
                        await self._reconcile_open_position_with_wallet(symbol, p.order_id)

            self._load_positions()
            self._resume_order_status_tasks()
        except Exception as e:
            logger.error(f"❌ Error en reconciliación al arranque: {e}")

    async def _get_exchange_open_orders_count(self, symbol: str, max_age_seconds: float = 5.0) -> Dict[str, Any]:
        now_ts = time.time()
        cached = (self.open_orders_cache or {}).get(symbol) or {}
        cached_ts = float(cached.get("ts", 0.0) or 0.0)
        if (now_ts - cached_ts) <= float(max_age_seconds):
            return cached

        async with self.open_orders_cache_lock:
            now_ts = time.time()
            cached = (self.open_orders_cache or {}).get(symbol) or {}
            cached_ts = float(cached.get("ts", 0.0) or 0.0)
            if (now_ts - cached_ts) <= float(max_age_seconds):
                return cached

            session = HTTP(
                testnet=config.USE_TESTNET,
                api_key=config.BYBIT_API_KEY,
                api_secret=config.BYBIT_API_SECRET
            )
            timestamp = await get_synced_time()
            params: Dict[str, Any] = {
                "category": "spot",
                "symbol": symbol,
                "timestamp": str(timestamp),
                "recvWindow": str(int(config.RECV_WINDOW)),
                "limit": 50,
            }
            try:
                resp = session.get_open_orders(**params)
            except TypeError:
                params.pop("limit", None)
                resp = session.get_open_orders(**params)

            count = 0
            if resp.get("retCode") == 0:
                count = len((resp.get("result", {}) or {}).get("list", []) or [])

            out = {"ts": now_ts, "retCode": resp.get("retCode"), "retMsg": resp.get("retMsg"), "count": count}
            self.open_orders_cache[symbol] = out
            return out

    async def fetch_real_balance(self) -> float:
        try:
            snapshot = await self._get_wallet_snapshot(max_age_seconds=float(getattr(config, "WALLET_CACHE_TTL_SECONDS", 5.0) or 5.0))
            if snapshot.get("retCode") == 0:
                usdt_info = (snapshot.get("coins") or {}).get("USDT") or {}
                available_balance = self._float0(usdt_info.get("available"), 0.0)
                wallet_balance = self._float0(usdt_info.get("walletBalance"), 0.0)
                locked_balance = self._float0(usdt_info.get("locked"), 0.0)
                if available_balance < 0:
                    available_balance = 0.0
                now_ts = time.time()
                if (now_ts - float(self.last_wallet_log_ts or 0.0)) >= 30.0:
                    self.last_wallet_log_ts = now_ts
                    logger.info(
                        f"💰 Saldo real USDT: {wallet_balance:.2f}, Locked: {locked_balance:.2f}, Disponible: {available_balance:.2f}")
                return available_balance

            logger.error(f"❌ Error al obtener saldo real: {snapshot.get('retMsg')}")
            return 1000.0
        except Exception as e:
            logger.error(f"❌ Error al obtener saldo real: {e}")
            return 1000.0

    @staticmethod
    def _split_symbol_base_quote(symbol: str) -> tuple[str, str]:
        quotes = ["USDT", "USDC", "USD", "EUR", "BTC", "ETH", "DAI"]
        for quote in sorted(quotes, key=len, reverse=True):
            if symbol.endswith(quote) and len(symbol) > len(quote):
                return symbol[:-len(quote)], quote
        if len(symbol) > 4:
            return symbol[:-4], symbol[-4:]
        return symbol, ""

    @staticmethod
    def _float0(value: Any, default: float = 0.0) -> float:
        try:
            if value is None:
                return default
            return float(value)
        except (TypeError, ValueError):
            return default

    @staticmethod
    def _float_or_none(value: Any) -> Optional[float]:
        try:
            if value is None:
                return None
            return float(value)
        except (TypeError, ValueError):
            return None

    async def _get_wallet_snapshot(self, max_age_seconds: float = 5.0) -> Dict[str, Any]:
        now_ts = time.time()
        cached_ts = float((self.wallet_cache or {}).get("ts", 0.0) or 0.0)
        cached_coins = (self.wallet_cache or {}).get("coins") or {}
        if cached_coins and (now_ts - cached_ts) <= float(max_age_seconds):
            return self.wallet_cache

        async with self.wallet_cache_lock:
            now_ts = time.time()
            cached_ts = float((self.wallet_cache or {}).get("ts", 0.0) or 0.0)
            cached_coins = (self.wallet_cache or {}).get("coins") or {}
            if cached_coins and (now_ts - cached_ts) <= float(max_age_seconds):
                return self.wallet_cache

            session = HTTP(
                testnet=config.USE_TESTNET,
                api_key=config.BYBIT_API_KEY,
                api_secret=config.BYBIT_API_SECRET
            )
            timestamp = await get_synced_time()

            coins_out: Dict[str, Dict[str, Any]] = {}
            resp: Dict[str, Any] = {"retCode": -1, "retMsg": "wallet_balance_not_fetched"}
            used_account_type: Optional[str] = None

            for account_type in ("UNIFIED", "SPOT"):
                try:
                    candidate = session.get_wallet_balance(
                        accountType=account_type,
                        timestamp=str(timestamp),
                        recvWindow=str(int(config.RECV_WINDOW))
                    )
                except Exception:
                    continue

                candidate_coins: Dict[str, Dict[str, Any]] = {}
                if candidate.get("retCode") == 0:
                    wallet_list = (candidate.get("result", {}).get("list", []) or [])
                    coins = (wallet_list[0].get("coin", []) or []) if wallet_list else []
                    for c in coins:
                        coin = str(c.get("coin", "") or "").upper()
                        if not coin:
                            continue
                        wallet_balance = self._float0(c.get("walletBalance"), 0.0)
                        locked = self._float0(c.get("locked"), 0.0)
                        available_to_withdraw = self._float_or_none(c.get("availableToWithdraw"))
                        equity = self._float_or_none(c.get("equity"))
                        available = available_to_withdraw if available_to_withdraw is not None else (wallet_balance - locked)
                        if available < 0:
                            available = 0.0
                        candidate_coins[coin] = {
                            "walletBalance": wallet_balance,
                            "locked": locked,
                            "availableToWithdraw": available_to_withdraw,
                            "equity": equity,
                            "available": available,
                        }

                resp = candidate
                coins_out = candidate_coins
                used_account_type = account_type
                if resp.get("retCode") == 0 and coins_out:
                    break

            self.wallet_cache = {
                "ts": now_ts,
                "retCode": resp.get("retCode"),
                "retMsg": resp.get("retMsg"),
                "accountType": used_account_type,
                "coins": coins_out,
            }
            return self.wallet_cache

    async def _monitor_cycle(self, symbol: str, stage: str) -> None:
        now_ts = time.time()
        last_ts = float(self.last_cycle_log.get(symbol, 0.0) or 0.0)
        interval = float(getattr(config, "CYCLE_MONITOR_INTERVAL_SECONDS", 15.0) or 15.0)
        if (now_ts - last_ts) < interval:
            return
        self.last_cycle_log[symbol] = now_ts

        base, _quote = self._split_symbol_base_quote(symbol)
        snapshot = await self._get_wallet_snapshot(max_age_seconds=float(getattr(config, "WALLET_CACHE_TTL_SECONDS", 5.0) or 5.0))
        coins = snapshot.get("coins") or {}
        usdt = coins.get("USDT") or {}
        base_info = coins.get(str(base or "").upper()) if base else None
        base_info = base_info or {}

        usdt_available = self._float0(usdt.get("available"), 0.0)
        usdt_wallet = self._float0(usdt.get("walletBalance"), 0.0)
        base_qty = self._float0(base_info.get("walletBalance"), 0.0)
        last_price = self._float0((self.ticker_data.get(symbol, {}) or {}).get("last_price"), 0.0)
        ticker_age = now_ts - float(self.last_ticker_update.get(symbol, 0.0) or 0.0)
        orderbook_age = now_ts - float(self.last_orderbook_update.get(symbol, 0.0) or 0.0)

        active = 0
        for p in (self.positions.get(symbol) or []):
            if (p or {}).get("status") in ["pending", "open", "closing"]:
                active += 1

        open_orders = await self._get_exchange_open_orders_count(
            symbol,
            max_age_seconds=float(getattr(config, "OPEN_ORDERS_CACHE_TTL_SECONDS", 5.0) or 5.0),
        )
        open_orders_count = int(open_orders.get("count") or 0)

        base_label = str(base or "").upper()
        logger.info(
            f"🔁 ciclo={self.cycle_counter} iters={self.iterations} {symbol} stage={stage} "
            f"price={last_price:.2f} usdt_avail={usdt_available:.2f} usdt_wallet={usdt_wallet:.2f} "
            f"{base_label}={base_qty:.8f} active_pos={active} open_orders={open_orders_count} paused={self.paused} "
            f"errs={self.error_count}/{self.consecutive_errors} age_ticker={ticker_age:.1f}s age_ob={orderbook_age:.1f}s"
        )

    async def _fetch_spot_open_order_info(
        self,
        session: HTTP,
        symbol: str,
        order_id: str,
        order_link_id: Optional[str] = None,
    ) -> Optional[dict]:
        timestamp = await get_synced_time()
        base_params = {
            "category": "spot",
            "symbol": symbol,
            "timestamp": str(timestamp),
            "recvWindow": str(int(config.RECV_WINDOW)),
        }

        try:
            resp = session.get_open_orders(**{**base_params, "orderId": order_id})
        except TypeError:
            resp = {"retCode": -1}

        if resp.get("retCode") == 0:
            items = resp.get("result", {}).get("list", []) or []
            if items:
                return items[0]

        if not order_link_id:
            return None

        try:
            resp = session.get_open_orders(**{**base_params, "orderLinkId": order_link_id})
        except TypeError:
            return None

        if resp.get("retCode") != 0:
            return None
        items = resp.get("result", {}).get("list", []) or []
        return items[0] if items else None

    def _spot_order_summary(self, info: dict) -> dict:
        if not isinstance(info, dict):
            return {}
        keys = [
            "orderId",
            "orderLinkId",
            "orderStatus",
            "side",
            "orderType",
            "timeInForce",
            "qty",
            "price",
            "avgPrice",
            "cumExecQty",
            "cumExecValue",
            "cumExecFee",
            "feeCurrency",
            "createdTime",
            "updatedTime",
            "rejectReason",
        ]
        out = {k: info.get(k) for k in keys if k in info}
        return out

    def _spot_order_value_usdt(self, info: dict) -> float:
        cum_value = self._float0(info.get("cumExecValue"), 0.0)
        if cum_value > 0:
            return cum_value
        avg_price = self._float0(info.get("avgPrice"), 0.0)
        qty = self._float0(info.get("cumExecQty"), 0.0)
        if avg_price > 0 and qty > 0:
            return avg_price * qty
        return 0.0

    def _spot_order_avg_price(self, info: dict) -> float:
        avg_price = self._float0(info.get("avgPrice"), 0.0)
        if avg_price > 0:
            return avg_price
        qty = self._float0(info.get("cumExecQty"), 0.0)
        value = self._spot_order_value_usdt(info)
        if qty > 0 and value > 0:
            return value / qty
        return 0.0

    def _spot_order_fee_usdt(self, symbol: str, info: dict) -> float:
        fee = self._float0(info.get("cumExecFee"), 0.0)
        if fee <= 0:
            return 0.0
        fee_ccy = str(info.get("feeCurrency") or "").upper()
        base, quote = self._split_symbol_base_quote(symbol)
        base = str(base or "").upper()
        quote = str(quote or "").upper()

        if fee_ccy and quote and fee_ccy == quote:
            return fee
        if fee_ccy and base and fee_ccy == base:
            avg_price = self._spot_order_avg_price(info)
            if avg_price > 0:
                return fee * avg_price
        return 0.0

    def _compute_spot_realized_pnl_usdt(self, symbol: str, entry_info: dict, exit_info: dict, entry_action: str) -> dict:
        entry_qty = self._float0(entry_info.get("cumExecQty"), 0.0)
        exit_qty = self._float0(exit_info.get("cumExecQty"), 0.0)
        qty = min(entry_qty, exit_qty) if entry_qty > 0 and exit_qty > 0 else max(entry_qty, exit_qty)
        entry_value = self._spot_order_value_usdt(entry_info)
        exit_value = self._spot_order_value_usdt(exit_info)
        entry_fee = self._spot_order_fee_usdt(symbol, entry_info)
        exit_fee = self._spot_order_fee_usdt(symbol, exit_info)
        gross = 0.0
        action = str(entry_action or "").lower()
        if action == "buy":
            gross = exit_value - entry_value
        elif action == "sell":
            gross = entry_value - exit_value
        net = gross - entry_fee - exit_fee
        return {
            "qty_executed": qty,
            "entry_avg_price": self._spot_order_avg_price(entry_info),
            "exit_avg_price": self._spot_order_avg_price(exit_info),
            "entry_value_usdt": entry_value,
            "exit_value_usdt": exit_value,
            "entry_fee_usdt": entry_fee,
            "exit_fee_usdt": exit_fee,
            "pnl_gross_usdt": gross,
            "pnl_net_usdt": net,
            "fees_usdt": entry_fee + exit_fee,
        }

