                "rol": t.rol,
                "pio": t.pio,
                "ogm": t.ogm,
                "risk_reward_ratio": t.risk_reward_ratio
            } for t in trades
        ]
    except Exception as exc:
        logger.error (f"❌ Error en /trades: {exc}")
        raise HTTPException (status_code=500, detail=f"Error interno: {str (exc)}")


