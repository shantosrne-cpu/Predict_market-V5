@app.get("/db_summary")
async def get_db_summary():
    logger.info("📡 /db_summary")
    summary = {"candles_count": 0, "orderbooks_count": 0, "tickers_count": 0, "trades_count": 0}

    def load_summary(db):
        try:
            summary["candles_count"] = db.query(MarketData).count()
            summary["orderbooks_count"] = db.query(Orderbook).count()
            summary["tickers_count"] = db.query(MarketTicker).count()
            summary["trades_count"] = db.query(Trade).count()
        except Exception as exc:
            logger.error(f"❌ Error al cargar resumen de DB: {exc}")
            raise

    try:
        await execute_in_db(load_summary)
        return {**summary, "timestamp": datetime.now(timezone.utc).isoformat() + "Z"}
    except Exception as exc:
        logger.error(f"❌ Error en /db_summary: {exc}")
        raise HTTPException(status_code=500, detail=f"Error interno: {str(exc)}")

