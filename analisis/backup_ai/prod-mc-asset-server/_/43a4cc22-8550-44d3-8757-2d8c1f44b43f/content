import os
from typing import List, Dict, Optional
import requests
import time
from datetime import datetime, timedelta, timezone

from config.config import BASE_URL, config
from models.database import MarketData, Orderbook, MarketTicker, Trade, execute_in_db
from services.metrics import calculate_metrics
from utils.utils import timestamp_to_datetime, save_results
from utils.logger import logger

class TradingEngine:
    def __init__(self, websocket_service):
        self.config = config
        self.symbol: str = self.config.symbol
        self.timeframe: str = self.config.timeframe
        self.capital: float = self.config.capital_usdt
        self.positions: List[Dict] = []
        self.iterations: int = 0
        self.running: bool = True
        self.websocket_service = websocket_service
        self.orderbook_data: Dict[str, List] = {"bids": [], "asks": []}
        self.ticker_data: Dict[str, float] = {"last_price": 0.0, "volume_24h": 0.0, "high_24h": 0.0, "low_24h": 0.0}
        self.candles: List[MarketData] = []
        self.trade_id_counter: int = self._load_initial_trade_id()
        self.last_orderbook_log: float = 0.0
        self.last_trade_time: float = 0.0
        self.force_initial_trade: bool = True
        self._load_positions()

    def _load_initial_trade_id(self) -> int:
        def load_trade_id(db):
            last_trade = db.query(Trade.trade_id).order_by(Trade.trade_id.desc()).first()
            return last_trade[0] + 1 if last_trade else 1
        try:
            result = None
            def set_result(db):
                nonlocal result
                result = load_trade_id(db)
            execute_in_db(set_result)
            return result if result is not None else 1
        except Exception as exc:
            logger.error(f"Error al cargar trade_id inicial: {exc}")
            return 1

    def _load_positions(self) -> None:
        positions: List[Dict] = []
        def load_positions(db):
            try:
                trades = db.query(Trade).filter(Trade.symbol == self.symbol).order_by(Trade.timestamp.desc()).limit(100).all()
                trade_ids = set()
                for t in trades:
                    if t.trade_id not in trade_ids:
                        positions.append({
                            "trade_id": t.trade_id,
                            "timestamp": t.timestamp.isoformat() + "Z",
                            "symbol": t.symbol,
                            "action": t.action,
                            "entry_price": t.entry_price,
                            "exit_price": t.exit_price,
                            "quantity": t.quantity,
                            "profit_loss": t.profit_loss,
                            "decision": t.decision,
                            "combined": t.combined,
                            "ild": t.ild,
                            "egm": t.egm,
                            "rol": t.rol,
                            "pio": t.pio,
                            "ogm": t.ogm,
                            "risk_reward_ratio": t.risk_reward_ratio,
                        })
                        trade_ids.add(t.trade_id)
            except Exception as exc:
                logger.error(f"Error al cargar posiciones: {exc}")
                raise
        try:
            execute_in_db(load_positions)
            self.positions = positions
            logger.info(f"Posiciones cargadas: {len(self.positions)} trades únicos")
        except Exception as exc:
            logger.error(f"Error en _load_positions: {exc}")
            self.positions = []

