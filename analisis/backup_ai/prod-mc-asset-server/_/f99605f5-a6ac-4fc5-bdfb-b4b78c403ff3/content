class AdjuEngine:
    """Opera órdenes reales para AdjuDev con WebSockets optimizados, detector de ballenas matemático bestial, y trading brutal, minimalista y listo para producción."""

    def __init__(self):
        self.symbol = config.get_config()["symbol"]
        self.timeframe = config.get_config()["timeframe"]
        self.simulation_mode = config.get_config()["simulation_mode"]
        self.capital = config.get_config()["capital_usdt"]
        self.positions = []  # Lista para rastrear posiciones abiertas
        self.orderbook_data = {"bids": [], "asks": []}
        self.ticker_data = {
            "last_price": 0.0,
            "volume_24h": 0.0,
            "high_24h": 0.0,
            "low_24h": 0.0
        }
        self.ws = None
        self.running = False
        self.whale_detector = WhaleDetector(self.symbol)
        self.historical_data = []  # Para optimización de umbrales
        self.db_path = Path(config.get_config()["base_path"]) / "market_data.db"

        # Crear base de datos si no existe
        if not self.db_path.exists():
            logger.warning(f"⚡ [⚡ METAL ⚡] Base de datos no encontrada, creando una nueva en {self.db_path}")
            from create_db import create_db  # Importar dinámicamente para evitar dependencia circular
            create_db()  # Esto ejecutará create_db.py para inicializar la base

        # Inicializar estrategias con parámetros correctos
        self.strategies = {
            "EMA": EMAStrategy(self.symbol, self.timeframe, self.db_path,
                               short_period=config.get_config()["whale_ema_short"],
                               long_period=config.get_config()["whale_ema_long"]),
            "Bollinger": BollingerBandsStrategy(self.symbol, self.timeframe, self.db_path),
            "RSI": RsiStrategy(self.symbol, self.timeframe, self.db_path),
            "TripleEMA": TripleEMATpslStrategy(self.symbol, self.timeframe, self.db_path)
        }
        logger.info(
            f"⚡ AdjuEngine iniciado en {'modo simulación' if self.simulation_mode else 'modo real'} para {self.symbol} {'en testnet' if config.get_config()['use_testnet'] else 'en mainnet'} con un riff matemático bestial y detector de ballenas!"
        )

    def get_market_data(self) -> Dict:
        """Obtiene datos minimalistas desde la base de datos SQLite o WebSockets con NumPy."""
        try:
            with sqlite3.connect(self.db_path) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    SELECT close 
                    FROM market_data 
                    WHERE symbol=? AND timeframe=? 
                    ORDER BY timestamp DESC LIMIT 4
                """, (self.symbol, self.timeframe))
                close_prices = np.array([row[0] for row in cursor.fetchall()], dtype=np.float64)
                if not close_prices.size and self.ticker_data["last_price"] > 0:
                    close_prices = np.array([self.ticker_data["last_price"]] * 4, dtype=np.float64)
                elif not close_prices.size:
                    close_prices = np.array([90000, 90100, 90200, 90300], dtype=np.float64)
                return {"close_prices": close_prices}
        except sqlite3.Error as e:
            logger.error(f"❌ Riff roto en datos: {e}")
            return {"close_prices": np.array([90000, 90100, 90200, 90300], dtype=np.float64)}

    def execute_strategy(self, strategy_name: str) -> Optional[Dict]:
        strategy = self.strategies.get(strategy_name)
        if not strategy:
            logger.error(f"❌ Estrategia '{strategy_name}' no encontrada en el metal.")
            return None

        signal = strategy.execute()  # No pasar market_data, ya que la estrategia lo carga internamente

        candles, orderbook, ticker = self.get_latest_data()
        if len(candles) >= self.whale_detector.ema_long and self.whale_detector.detect_whale(orderbook, ticker, candles):
            if signal and signal["action"] != "HOLD":
                logger.info(
                    f"🤘 ¡Ballena detectada matemáticamente! Ajustando señal {signal['action']} para operar en {self.symbol}")
                return signal
            return {"action": "BUY" if ticker["last_price"] > self.get_ema_trend(candles) else "SELL"}

        logger.info(f"📊 Señal metalera de {strategy_name} para AdjuDev: {signal}")
        return signal

    def get_ema_trend(self, candles: List[Dict]) -> float:
        """Calcula tendencia con EMA para decisiones por defecto, usando NumPy."""
        if not candles or len(candles) < self.whale_detector.ema_long:
            return 90000.0  # Valor por defecto
        closes = np.array([c["close"] for c in candles], dtype=np.float64)
        ema_short = self.whale_detector.calculate_ema(closes, config.get_config()["whale_ema_short"])
        ema_long = self.whale_detector.calculate_ema(closes, config.get_config()["whale_ema_long"])
        return ema_short if ema_short > ema_long else ema_long

    def _simulate_trade(self, signal: Dict) -> Optional[Dict]:
        """Simula una orden para AdjuDev (solo si SIMULATION_MODE=true)."""
        if not self.simulation_mode or not signal or signal["action"] == "HOLD":
            logger.info("⏳ No se simula orden: riff en HOLD para AdjuDev.")
            return None

        action = signal["action"].upper()
        latest_price = self.get_latest_price()
        qty = 0.001  # Cantidad mínima ficticia, ajustable

        params = {
            "symbol": self.symbol,
            "side": "Buy" if action == "BUY" else "Sell",
            "order_type": "Limit",
            "qty": qty,
            "price": latest_price,
            "status": "FILLED"
        }

        if action in ["BUY", "SELL"] and "take_profit" in signal and "stop_loss" in signal:
            params["take_profit"] = signal["take_profit"]
            params["stop_loss"] = signal["stop_loss"]

        exit_price = latest_price * (1.005 if action == "BUY" else 0.995)  # 0.5% de cambio
        profit_loss = (exit_price - latest_price) * qty * (1 if action == "BUY" else -1) - (latest_price + exit_price) * qty * config.get_config()["fee_rate"]

        logger.info(f"🚀 Riff de orden simulada para AdjuDev: {params}")
        self._save_trade(action, latest_price, exit_price, qty, profit_loss, {})
        return {
            "result": params,
            "message": f"Riff de orden {action} simulada exitosamente para AdjuDev en {self.symbol}"
        }

    def get_latest_price(self) -> float:
        """Obtiene el precio más reciente desde WebSockets o datos ficticios."""
        return self.ticker_data["last_price"] if self.ticker_data["last_price"] > 0 else 90000.0

    def _place_order(self, action: str, quantity: float, price: float) -> Dict:
        """Coloca una orden real en Bybit, lista para producción en testnet o mainnet, optimizada para no saturar."""
        BASE_URL = "https://api-testnet.bybit.com" if config.get_config()["use_testnet"] else "https://api.bybit.com"
        if not config.get_config()["api_key"] or not config.get_config()["api_secret"]:
            logger.error("❌ Claves API faltantes para operar en modo real.")
            return {"success": False, "error": "Claves API no configuradas"}

        time.sleep(0.5)  # Throttling bestial: Espera 0.5 segundos entre órdenes para máxima eficiencia
        timestamp = int(time.time() * 1000)
        params = {
            "category": "spot",
            "symbol": self.symbol,
            "side": action,
            "orderType": "Limit",
            "qty": str(quantity),
            "price": str(price),
            "timeInForce": "GoodTillCancel",
            "timestamp": str(timestamp)
        }
        signature = hmac.new(
            config.get_config()["api_secret"].encode(),
            "&".join(f"{k}={params[k]}" for k in sorted(params.keys())).encode(),
            hashlib.sha256
        ).hexdigest()

        headers = {
            "X-BAPI-API-KEY": config.get_config()["api_key"],
            "X-BAPI-SIGN": signature,
            "X-BAPI-TIMESTAMP": str(timestamp),
            "Content-Type": "application/json"
        }

        try:
            response = requests.post(f"{BASE_URL}/v5/order/create", headers=headers, json=params,
                                    timeout=5)  # Tiempo de espera optimizado
            response.raise_for_status()
            data = response.json()
            if data['retCode'] == 0:
                order_id = data['result']['orderId']
                logger.info(
                    f"🤘 Riff de compra/venta real bestial - Orden {action} colocada, ID: {order_id} {'en testnet' if config.get_config()['use_testnet'] else 'en mainnet'}")
                self.positions.append({
                    "order_id": order_id,
                    "action": action,
                    "quantity": quantity,
                    "entry_price": price
                })
                return {"success": True, "order_id": order_id}
            else:
                logger.error(f"❌ Fallo en el solo real: {data['retMsg']}")
                return {"success": False, "error": data['retMsg']}
        except Exception as e:
            logger.error(f"❌ Caos en el escenario real: {e}")
            return {"success": False, "error": str(e)}

    def _close_order(self, order_id: str, action: str, quantity: float, price: float, entry_price: float) -> Dict:
        """Cierra una orden real en Bybit, lista para producción en testnet o mainnet, optimizado para no saturar."""
        BASE_URL = "https://api-testnet.bybit.com" if config.get_config()["use_testnet"] else "https://api.bybit.com"
        time.sleep(0.5)  # Throttling bestial para máxima eficiencia
        timestamp = int(time.time() * 1000)
        cancel_params = {
            "category": "spot",
            "symbol": self.symbol,
            "orderId": order_id,
            "timestamp": str(timestamp)
        }
        signature = hmac.new(
            config.get_config()["api_secret"].encode(),
            "&".join(f"{k}={cancel_params[k]}" for k in sorted(cancel_params.keys())).encode(),
            hashlib.sha256
        ).hexdigest()

        headers = {
            "X-BAPI-API-KEY": config.get_config()["api_key"],
            "X-BAPI-SIGN": signature,
            "X-BAPI-TIMESTAMP": str(timestamp),
            "Content-Type": "application/json"
        }

        try:
            # Cancelar orden pendiente si existe
            cancel_response = requests.post(f"{BASE_URL}/v5/order/cancel", headers=headers, json=cancel_params,
                                           timeout=5)
            cancel_response.raise_for_status()
            cancel_data = cancel_response.json()
            if cancel_data['retCode'] != 0:
                logger.error(f"❌ Fallo al cancelar orden real: {cancel_data['retMsg']}")
                return {"success": False, "error": cancel_data['retMsg']}

            # Colocar orden de cierre
            place_params = {
                "category": "spot",
                "symbol": self.symbol,
                "side": action,
                "orderType": "Limit",
                "qty": str(quantity),
                "price": str(price),
                "timeInForce": "GoodTillCancel",
                "timestamp": str(timestamp)
            }
            place_signature = hmac.new(
                config.get_config()["api_secret"].encode(),
                "&".join(f"{k}={place_params[k]}" for k in sorted(place_params.keys())).encode(),
                hashlib.sha256
            ).hexdigest()
            place_headers = {**headers, "X-BAPI-SIGN": place_signature}

            close_response = requests.post(f"{BASE_URL}/v5/order/create", headers=place_headers, json=place_params,
                                          timeout=5)
            close_response.raise_for_status()
            close_data = close_response.json()
            if close_data['retCode'] == 0:
                profit_loss = quantity * (price - entry_price - (price * quantity * config.get_config().get("fee_rate", 0.002))) * (1 if action == "Sell" else -1)
                self.capital += profit_loss
                logger.info(
                    f"🔥 Fin del solo real bestial - Orden cerrada: P&L {profit_loss:.2f} {'en testnet' if config.get_config()['use_testnet'] else 'en mainnet'}")
                self._save_trade(action, entry_price, price, quantity, profit_loss, {})
                return {"success": True, "profit_loss": profit_loss}
            else:
                logger.error(f"❌ Fallo en el headbang real: {close_data['retMsg']}")
                return {"success": False, "error": close_data['retMsg']}
        except Exception as e:
            logger.error(f"❌ Colapso en el escenario real: {e}")
            return {"success": False, "error": str(e)}

    def _save_trade(self, action: str, entry_price: float, exit_price: float, quantity: float, profit_loss: float,
                   metrics: Dict) -> None:
        """Guarda una transacción en la base de datos SQLite, listo para producción con NumPy."""
        try:
            with sqlite3.connect(self.db_path) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    CREATE TABLE IF NOT EXISTS transactions (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        timestamp INTEGER NOT NULL,
                        symbol TEXT NOT NULL,
                        action TEXT NOT NULL,
                        entry_price REAL NOT NULL,
                        exit_price REAL NOT NULL,
                        quantity REAL NOT NULL,
                        profit_loss REAL NOT NULL,
                        status TEXT NOT NULL
                    )
                """)
                cursor.execute("""
                    INSERT INTO transactions (timestamp, symbol, action, entry_price, exit_price, quantity, profit_loss, status)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """, (
                    int(datetime.now(timezone.utc).timestamp() * 1000), self.symbol, action, entry_price, exit_price,
                    quantity, profit_loss, "CLOSED"))
                conn.commit()
            logger.info(
                f"💾 Transacción metalera guardada bestial: {action}, P&L {profit_loss:.2f} {'en testnet' if config.get_config()['use_testnet'] else 'en mainnet'}")
        except sqlite3.Error as e:
            logger.error(f"❌ Riff roto guardando transacción: {e}")

    def get_latest_data(self) -> Tuple[List[dict], Dict, Dict]:
        """Obtiene los últimos datos de mercado desde WebSockets o SQLite, optimizado con NumPy."""
        try:
            with sqlite3.connect(self.db_path) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    SELECT timestamp, open, high, low, close, volume 
                    FROM market_data WHERE symbol=? ORDER BY timestamp DESC LIMIT ?
                """, (self.symbol, self.whale_detector.ema_long))
                candles = [{"timestamp": row[0], "open": row[1], "high": row[2], "low": row[3], "close": row[4],
                            "volume": row[5]}
                           for row in cursor.fetchall()]
                if len(candles) < self.whale_detector.ema_long:
                    logger.warning(f"⚠ Datos insuficientes: solo {len(candles)} velas, se requieren {self.whale_detector.ema_long}")
                return candles, self.orderbook_data, self.ticker_data
        except sqlite3.Error as e:
            logger.error(f"❌ Riff roto obteniendo datos: {e}")
            return ([{"timestamp": int(time.time() * 1000), "open": 90000, "high": 90100, "low": 89900,
                      "close": 90000, "volume": 1.0} for _ in range(self.whale_detector.ema_long)],
                    {"bids": [], "asks": []},
                    {"last_price": 90000.0, "volume_24h": 0.0, "high_24h": 0.0, "low_24h": 0.0})

    def _store_candle(self, candle: Dict) -> None:
        """Almacena velas en la base de datos SQLite, optimizado con NumPy."""
        try:
            with sqlite3.connect(self.db_path) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    CREATE TABLE IF NOT EXISTS market_data (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        timestamp INTEGER NOT NULL,
                        symbol TEXT NOT NULL,
                        timeframe TEXT NOT NULL,
                        open REAL NOT NULL,
                        high REAL NOT NULL,
                        low REAL NOT NULL,
                        close REAL NOT NULL,
                        volume REAL NOT NULL,
                        UNIQUE(timestamp, symbol, timeframe)
                    )
                """)
                cursor.execute("""
                    INSERT INTO market_data (timestamp, symbol, timeframe, open, high, low, close, volume)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                    ON CONFLICT(timestamp, symbol, timeframe) DO UPDATE SET open=?, high=?, low=?, close=?, volume=?
                """, (
                    candle["timestamp"], self.symbol, self.timeframe, candle["open"], candle["high"], candle["low"],
                    candle["close"], candle["volume"],
                    candle["open"], candle["high"], candle["low"], candle["close"], candle["volume"]))
                conn.commit()
            logger.info(
                f"⚡ Nueva nota metalera bestial: {datetime.fromtimestamp(candle['timestamp'] / 1000, tz=timezone.utc)} - Close: {candle['close']}")
        except sqlite3.Error as e:
            logger.error(f"❌ Riff roto almacenando vela: {e}")

    def _store_orderbook(self) -> None:
        """Almacena el orderbook en la base de datos SQLite."""
        try:
            with sqlite3.connect(self.db_path) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    CREATE TABLE IF NOT EXISTS orderbook (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        timestamp INTEGER NOT NULL,
                        symbol TEXT NOT NULL,
                        bids TEXT NOT NULL,
                        asks TEXT NOT NULL,
                        UNIQUE(timestamp, symbol)
                    )
                """)
                timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
                cursor.execute("""
                    INSERT INTO orderbook (timestamp, symbol, bids, asks)
                    VALUES (?, ?, ?, ?)
                    ON CONFLICT(timestamp, symbol) DO UPDATE SET bids=?, asks=?
                """, (timestamp, self.symbol, json.dumps(self.orderbook_data["bids"]),
                      json.dumps(self.orderbook_data["asks"]),
                      json.dumps(self.orderbook_data["bids"]), json.dumps(self.orderbook_data["asks"])))
                conn.commit()
            logger.info(f"🤘 Orderbook almacenado bestial para {self.symbol}")
        except sqlite3.Error as e:
            logger.error(f"❌ Riff roto almacenando orderbook: {e}")

    def _store_ticker(self) -> None:
        """Almacena el ticker en la base de datos SQLite."""
        try:
            with sqlite3.connect(self.db_path) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    CREATE TABLE IF NOT EXISTS market_ticker (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        timestamp INTEGER NOT NULL,
                        symbol TEXT NOT NULL,
                        last_price REAL NOT NULL,
                        volume_24h REAL NOT NULL,
                        high_24h REAL NOT NULL,
                        low_24h REAL NOT NULL,
                        UNIQUE(timestamp, symbol)
                    )
                """)
                timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
                cursor.execute("""
                    INSERT INTO market_ticker (timestamp, symbol, last_price, volume_24h, high_24h, low_24h)
                    VALUES (?, ?, ?, ?, ?, ?)
                    ON CONFLICT(timestamp, symbol) DO UPDATE SET last_price=?, volume_24h=?, high_24h=?, low_24h=?
                """, (timestamp, self.symbol, self.ticker_data["last_price"], self.ticker_data["volume_24h"],
                      self.ticker_data["high_24h"], self.ticker_data["low_24h"],
                      self.ticker_data["last_price"], self.ticker_data["volume_24h"],
                      self.ticker_data["high_24h"], self.ticker_data["low_24h"]))
                conn.commit()
            logger.info(f"⚡ Ticker almacenado bestial para {self.symbol}")
        except sqlite3.Error as e:
            logger.error(f"❌ Riff roto almacenando ticker: {e}")

    def _process_trade(self) -> None:
        """Procesa trades en tiempo real o simulación según el modo."""
        if not self.running:
            return

        candles, orderbook, ticker = self.get_latest_data()
        if len(candles) < self.whale_detector.ema_long:
            logger.warning("⚠ Datos insuficientes para procesar trade")
            return

        metrics = adju_market.calculate_metrics(candles, orderbook, ticker)
        if self.simulation_mode:
            signal = self.execute_strategy(list(self.strategies.keys())[0])  # Usar primera estrategia por defecto
            if signal and signal["action"] != "HOLD":
                self._simulate_trade(signal)
        else:
            self._real_trade()

    def _save_results(self) -> None:
        """Guarda los resultados finales del bot, listo para producción bestial."""
        results = {
            "final_capital": self.capital,
            "symbol": self.symbol,
            "timeframe": self.timeframe,
            "mode": "simulación" if self.simulation_mode else "real",
            "testnet": config.get_config()["use_testnet"],
            "timestamp": int(datetime.now(timezone.utc).timestamp() * 1000)
        }
        adju_market.save_results(results, Path(config.get_config()["base_path"]) / "logs")
        logger.info(f"💾 Resultados metaleros guardados bestial: Capital final {self.capital:.2f} USDT")

    def run_simulation(self) -> None:
        """Ejecuta una simulación continua con todas las estrategias."""
        while self.running:
            for strategy_name in self.strategies.keys():
                signal = self.execute_strategy(strategy_name)
                if signal and signal["action"] != "HOLD":
                    self._simulate_trade(signal)
            time.sleep(60)  # Simulación cada minuto

    def start(self):
        pygame.mixer.init()
        # Generar un sonido básico (onda cuadrada para simular un riff metalero)
        sample_rate = 44100  # Frecuencia de muestreo (Hz)
        frequency = 220  # Frecuencia del tono (A3, un tono grave para un riff metalero)
        duration = 1.0  # Duración en segundos
        t = np.linspace(0, duration, int(sample_rate * duration), False)
        wave = 0.5 * np.sign(np.sin(2 * np.pi * frequency * t))  # Onda cuadrada
        sound_array = (wave * 32767).astype(np.int16)
        sound = pygame.mixer.Sound(sound_array)
        try:
            sound.play()
            logger.info("🎸 [⚡ METAL ⚡] Reproduciendo riff metalero generado - ¡A rockearlo, hermano!")
        except Exception as e:
            logger.warning(f"❌ No se pudo reproducir el riff metalero: {e} - Usando solo logs")

        self.running = True
        if not self.simulation_mode:
            self.ws = websocket.WebSocketApp(
                "wss://stream-testnet.bybit.com/v5/public/spot" if config.get_config()["use_testnet"] else "wss://stream.bybit.com/v5/public/spot",
                on_open=self._on_open,
                on_message=self._on_message,
                on_error=self._on_error,
                on_close=self._on_close
            )
            ws_thread = threading.Thread(target=self.ws.run_forever, daemon=True)
            ws_thread.start()
            logger.info("⚡ Ritmo metalero bestial iniciado - WebSocket conectado en hilo separado con detector matemático")
        else:
            self.run_simulation()

    def stop(self):
        """Detiene el bot y guarda resultados, listo para producción bestial en testnet o mainnet."""
        self.running = False
        if hasattr(self, "ws") and self.ws:
            self.ws.close()
        self._save_results()
        logger.info(
            f"🦇 Final del riff bestial - Bot detenido. Capital final: {self.capital:.2f} USDT {'en testnet' if config.get_config()['use_testnet'] else 'en mainnet'}")

    def _on_open(self, ws):
        logger.info("⚡ Ritmo metalero bestial iniciado - WebSocket conectado")
        ws.send(json.dumps({
            "op": "subscribe",
            "args": [
                f"kline.{self.timeframe}.{self.symbol}",
                f"orderbook.50.{self.symbol}",  # Nivel 50 para eficiencia bestial
                f"tickers.{self.symbol}"
            ]
        }))

    def _on_message(self, ws, message: str):
        try:
            data = json.loads(message)
            if "topic" in data:
                if "kline" in data["topic"]:
                    kline = data["data"][0]
                    candle = {
                        "timestamp": kline["start"],
                        "open": float(kline["open"]),
                        "high": float(kline["high"]),
                        "low": float(kline["low"]),
                        "close": float(kline["close"]),
                        "volume": float(kline["volume"])
                    }
                    self._store_candle(candle)
                    self.historical_data.append({"timestamp": candle["timestamp"], "last_price": candle["close"],
                                                "volume_24h": candle["volume"], "bids": [], "asks": []})
                elif "orderbook" in data["topic"]:
                    self.orderbook_data = {"bids": data["data"]["b"], "asks": data["data"]["a"]}
                    if self.historical_data:
                        self.historical_data[-1]["bids"] = self.orderbook_data["bids"]
                        self.historical_data[-1]["asks"] = self.orderbook_data["asks"]
                    self._store_orderbook()
                elif "tickers" in data["topic"]:
                    ticker = data["data"]
                    self.ticker_data = {
                        "last_price": float(ticker["lastPrice"]),
                        "volume_24h": float(ticker["volume24h"]),
                        "high_24h": float(ticker["highPrice24h"]),
                        "low_24h": float(ticker["lowPrice24h"])
                    }
                    if self.historical_data:
                        self.historical_data[-1]["last_price"] = self.ticker_data["last_price"]
                        self.historical_data[-1]["volume_24h"] = self.ticker_data["volume_24h"]
                    self._store_ticker()
                self._process_trade()
        except Exception as e:
            logger.error(f"❌ Desafío metalero bestial fallido: {e}")

    def _on_error(self, ws, error):
        logger.error(f"❌ Trueno en el escenario bestial: {error}")
        # Reintentar conexión después de un error con optimización
        time.sleep(2)  # Esperar 2 segundos para eficiencia
        if self.running and not self.simulation_mode:
            self.ws = websocket.WebSocketApp(
                "wss://stream-testnet.bybit.com/v5/public/spot" if config.get_config()["use_testnet"] else "wss://stream.bybit.com/v5/public/spot",
                on_open=self._on_open,
                on_message=self._on_message,
                on_error=self._on_error,
                on_close=self._on_close
            )
            ws_thread = threading.Thread(target=self.ws.run_forever, daemon=True)
            ws_thread.start()

    def _on_close(self, ws, *args):
        logger.info("🔥 Fin del concierto bestial - WebSocket cerrado")
        if self.running and not self.simulation_mode:
            # Reintentar conexión automáticamente con optimización
            time.sleep(2)  # Esperar 2 segundos para eficiencia
            self.ws = websocket.WebSocketApp(
                "wss://stream-testnet.bybit.com/v5/public/spot" if config.get_config()["use_testnet"] else "wss://stream.bybit.com/v5/public/spot",
                on_open=self._on_open,
                on_message=self._on_message,
                on_error=self._on_error,
                on_close=self._on_close
            )
            ws_thread = threading.Thread(target=self.ws.run_forever, daemon=True)
            ws_thread.start()

    def _real_trade(self) -> None:
        """Ejecuta trades reales en Bybit, optimizado para ballenas y rendimiento bestial."""
        candles, orderbook, ticker = self.get_latest_data()
        if len(candles) < self.whale_detector.ema_long:
            logger.warning("⚠ Datos insuficientes para trade real")
            return
        metrics = adju_market.calculate_metrics(candles, orderbook, ticker)

        # Usar la primera estrategia por defecto para decidir
        signal = self.execute_strategy(list(self.strategies.keys())[0])
        if signal and signal["action"] != "HOLD":
            action = signal["action"].upper()
            if action == "BUY" and metrics["egm"] > config.get_config()["egm_buy_threshold"] and metrics["combined"] > 0:
                self._place_order("Buy", 0.001, ticker["last_price"])
            elif action == "SELL" and metrics["egm"] < config.get_config()["egm_sell_threshold"] and metrics["combined"] < 0:
                self._close_open_positions(ticker["last_price"])

        # Optimizar umbrales cada hora con datos históricos
        if len(self.historical_data) >= 60 and time.time() % 3600 < 60:  # Cada hora
            self.whale_detector.optimize_thresholds(self.historical_data)
            self.historical_data = []  # Reiniciar historial después de optimizar

    def _close_open_positions(self, price: float) -> None:
        """Cierra posiciones abiertas en modo real, optimizado para rendimiento bestial."""
        for position in self.positions[:]:  # Copia para modificar durante iteración
            if position["action"] == "Buy":
                action = "Sell"
            else:
                action = "Buy"
            result = self._close_order(position["order_id"], action, position["quantity"], price,
                                      position["entry_price"])
            if result["success"]:
                self.positions.remove(position)

