async def main ():
    try:
        # Reinicia configuraciones previas del bot antes de comenzar
        bot.reset_trades ()
        logger.info ("🚀 Iniciando bot y servidor API...")

        # Ejecuta el bot y el servidor de forma paralela
        await asyncio.gather (bot.start_async (), server.serve ())

    except Exception as e:
        logger.error (f"❌ Error crítico en main(): {e}")
        await server.shutdown ()
    except KeyboardInterrupt:
        logger.info ("🛑 Interrupción del usuario detectada.")
        await server.shutdown ()
        bot.stop ()


if __name__ == "__main__":
    asyncio.run (main ())
