    def start(self):
        logger.info(f"🔥 Motor metalero iniciado para {self.symbols}")
        max_attempts = 5
        attempt = 0
        while attempt < max_attempts and self.running:
            try:
                asyncio.run(self.fetch_initial_data())
                self._connect_websocket()
                break
            except Exception as e:
                logger.error(f"❌ Error al iniciar (intento {attempt + 1}/{max_attempts}): {e}")
                attempt += 1
                time.sleep(5)
        if attempt >= max_attempts:
            logger.critical("❌ Máximo de intentos alcanzado. Deteniendo bot.")
            self.stop()

    def _connect_websocket(self):
        if self.ws and self.ws.sock and self.ws.sock.connected:
            logger.info("🌐 WebSocket conectado, re-suscripción")
            self._resubscribe()
            return
        self.ws = WebSocketApp(
            WS_URL,
            on_open=self._on_open,
            on_message=self._on_message,
            on_error=self._on_error,
            on_close=self._on_close
        )
        wst = threading.Thread(target=self.ws.run_forever, daemon=True)
        wst.start()
        logger.info("🌐 WebSocket en hilo iniciado")

    def _resubscribe(self):
        interval = self.timeframe.replace("m", "")
        for symbol in self.symbols:
            subscription = {
                "op": "subscribe",
                "args": [
                    f"kline.{interval}.{symbol}",
                    f"orderbook.50.{symbol}",
                    f"tickers.{symbol}"
                ]
            }
            if self.ws and self.ws.sock and self.ws.sock.connected:
                try:
                    self.ws.send(json.dumps(subscription))
                    logger.info(f"📡 Suscripción enviada para {symbol}: {subscription}")
                except Exception as e:
                    logger.error(f"❌ Error suscripción para {symbol}: {e}")

    def _on_open(self, ws):
        logger.info("🌐 WebSocket abierto")
        self._resubscribe()
        threading.Thread(
            target=lambda: [self.ws.send(json.dumps({"op": "ping"})) or time.sleep(10) for _ in iter(int, 1) if
                            self.running and self.ws.sock.connected],
            daemon=True
        ).start()

    def _on_message(self, ws, message: str):
        with SessionLocal() as db:
            try:
                data = json.loads(message)
                logger.debug(f"📨 Mensaje: {json.dumps(data, indent=2)}")
                if "op" in data:
                    if data["op"] == "subscribe":
                        logger.info(f"✅ Suscripción: {data.get('args', [])}" if data.get('success') else f"❌ Suscripción fallida: {data.get('ret_msg')}")
                        return
                    elif data["op"] == "ping":
                        logger.debug("📡 Pong recibido")
                        return
                if "topic" not in data:
                    return

                topic_parts = data["topic"].split(".")
                symbol = topic_parts[-1]

                if symbol not in self.symbols:
                    logger.warning(f"⚠️ Símbolo desconocido: {symbol}")
                    return

                if "kline" in data["topic"]:
                    self._handle_kline(symbol, data["data"][0], db)
                elif "orderbook" in data["topic"]:
                    new_bids = data["data"]["b"]
                    new_asks = data["data"]["a"]
                    filtered_bids = [bid for bid in new_bids if float(bid[1]) > 0]
                    filtered_asks = [ask for ask in new_asks if float(ask[1]) > 0]
                    if self._is_valid_orderbook(filtered_bids, filtered_asks):
                        self.orderbook_data[symbol] = {"bids": filtered_bids, "asks": filtered_asks}
                        self._store_orderbook(symbol, db)
                        logger.info(f"📊 Orderbook actualizado para {symbol}: Bids={len(filtered_bids)}, Asks={len(filtered_asks)}")
                    else:
                        logger.warning(f"⚠️ Orderbook inválido para {symbol}, manteniendo datos previos")
                elif "tickers" in data["topic"]:
                    self._handle_ticker(symbol, data["data"], db)
            except Exception as e:
                logger.error(f"❌ Error mensaje: {e}")

    def _on_error(self, ws, error):
        logger.error(f"❌ Error en WebSocket: {error}")
        if self.running:
            logger.info("🔄 Intentando reconectar WebSocket...")
            self._connect_websocket()

    def _on_close(self, ws, close_status_code, close_msg):
        logger.info(f"🌐 WebSocket cerrado: Código={close_status_code}, Mensaje={close_msg}")
        if self.running:
            logger.info("🔄 Intentando reconectar WebSocket...")
            self._connect_websocket()

    def _is_valid_orderbook(self, bids, asks):
        return len(bids) > 0 and len(asks) > 0 and all(len(bid) >= 2 for bid in bids) and all(len(ask) >= 2 for ask in asks)

    def _handle_kline(self, symbol: str, kline: Dict, db: Session):
        timestamp = timestamp_to_datetime(int(kline["start"]))
        if not db.query(MarketData).filter_by(timestamp=timestamp, symbol=symbol).first():
            candle = MarketData(
                timestamp=timestamp,
                symbol=symbol,
                open=float(kline["open"]),
                high=float(kline["high"]),
                low=float(kline["low"]),
                close=float(kline["close"]),
                volume=float(kline["volume"])
            )
            db.add(candle)
            db.commit()
            self.candles[symbol] = db.query(MarketData).filter_by(symbol=symbol).order_by(
                MarketData.timestamp.desc()).limit(5).all()
            self._execute_trade(symbol, db)
            logger.info(f"⚡ Kline para {symbol}: {timestamp}, Close: {candle.close}, Volume: {candle.volume}")

    def _store_orderbook(self, symbol: str, db: Session):
        orderbook = Orderbook(
            timestamp=datetime.now(timezone.utc),
            symbol=symbol,
            bids=json.dumps(self.orderbook_data[symbol]["bids"]),
            asks=json.dumps(self.orderbook_data[symbol]["asks"])
        )
        db.add(orderbook)
        db.commit()
        if time.time() - self.last_orderbook_log >= 5:
            logger.info(f"🤘 Orderbook actualizado para {symbol}: Bids={len(self.orderbook_data[symbol]['bids'])}, Asks={len(self.orderbook_data[symbol]['asks'])}")
            self.last_orderbook_log = time.time()

    def _handle_ticker(self, symbol: str, ticker: Dict, db: Session):
        self.ticker_data[symbol] = {
            "last_price": float(ticker["lastPrice"]),
            "volume_24h": float(ticker["volume24h"]),
            "high_24h": float(ticker["highPrice24h"]),
            "low_24h": float(ticker["lowPrice24h"])
        }
        if self.ticker_data[symbol]["last_price"] <= 0:
            self.ticker_data[symbol]["last_price"] = 83737.54
            logger.warning(f"⚠️ last_price inválido para {symbol}, usando valor simulado")
        market_ticker = MarketTicker(
            timestamp=datetime.now(timezone.utc),
            symbol=symbol,
            last_price=self.ticker_data[symbol]["last_price"],
            volume_24h=self.ticker_data[symbol]["volume_24h"],
            high_24h=self.ticker_data[symbol]["high_24h"],
            low_24h=self.ticker_data[symbol]["low_24h"]
        )
        db.add(market_ticker)
        db.commit()
        logger.info(f"⚡ Ticker para {symbol}: {self.ticker_data[symbol]['last_price']}")

    @lru_cache(maxsize=128)
    def _cached_calculate_metrics(self, candle_tuple: tuple, orderbook_str: str, ticker_str: str) -> Dict:
        candle_data = json.loads(candle_tuple)
        orderbook_data = json.loads(orderbook_str)
        ticker_data = json.loads(ticker_str)
        return calculate_metrics(candle_data, orderbook_data, ticker_data)

    def _determine_decision(self, symbol):
        candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in
                       self.candles.get(symbol, [])] or []
        if not self._is_valid_orderbook(self.orderbook_data[symbol]["bids"], self.orderbook_data[symbol]["asks"]):
            logger.warning(f"⚠️ Orderbook inválido para decisión en {symbol}, usando datos de respaldo")
            last_price = float(self.ticker_data[symbol].get("last_price", 83737.54))
            self.orderbook_data[symbol] = {
                "bids": [[str(last_price - 100), "0.001"]] * 50,
                "asks": [[str(last_price + 100), "0.001"]] * 50
            }
        candle_tuple = tuple(json.dumps(candle_data))
        orderbook_str = json.dumps(self.orderbook_data[symbol])
        ticker_str = json.dumps(self.ticker_data[symbol])
        metrics = self._cached_calculate_metrics(candle_tuple, orderbook_str, ticker_str)
        logger.info(f"📊 Métricas para {symbol}: {metrics}")

        if metrics["egm"] > Config.egm_buy_threshold and self.capital > Config.min_capital:
            return "buy"
        elif metrics["egm"] < Config.egm_sell_threshold and self.positions[symbol]:
            return "sell"
        return "hold"

    def _place_order(self, action: str, quantity: float, price: float) -> Dict:
        logger.info(f"🛠️ Simulando {action}, Qty: {quantity:.6f}, Price: {price:.2f}")
        return {"success": True, "order_id": f"sim-{self.trade_id_counter}", "entry_price": price}

    def _execute_trade(self, symbol: str, db: Session):
        if not self.running or self.iterations >= Config.max_iterations:
            logger.info(f"🛑 Detenido: Iter={self.iterations}/{Config.max_iterations}")
            self.stop()
            return

        decision = self._determine_decision(symbol)
        logger.info(f"🔍 Decisión para {symbol}: {decision}")

        if decision == "hold":
            self.iterations += 1
            self._save_results(None)
            return

        entry_price = float(self.ticker_data[symbol].get("last_price", 83737.54))
        quantity = max(min(Config.risk_factor * self.capital / entry_price, Config.max_trade_size), Config.min_trade_size)

        try:
            order_result = self._place_order(decision, quantity, entry_price)
            if not order_result["success"]:
                logger.error(f"❌ Orden falló para {symbol}: {order_result.get('error')}")
                return

            if decision == "buy":
                self.positions[symbol].append({
                    "trade_id": self.trade_id_counter,
                    "timestamp": datetime.now(timezone.utc).isoformat(),
                    "symbol": symbol,
                    "action": decision,
                    "entry_price": entry_price,
                    "exit_price": 0.0,
                    "quantity": quantity,
                    "profit_loss": 0.0,
                    "decision": decision,
                    "combined": self._determine_decision_metrics(symbol)["combined"],
                    "ild": self._determine_decision_metrics(symbol)["ild"],
                    "egm": self._determine_decision_metrics(symbol)["egm"],
                    "rol": self._determine_decision_metrics(symbol)["rol"],
                    "pio": self._determine_decision_metrics(symbol)["pio"],
                    "ogm": self._determine_decision_metrics(symbol)["ogm"],
                    "risk_reward_ratio": 1.5
                })
                self.capital -= (quantity * entry_price * (1 + Config.fee_rate))
                logger.info(f"💰 Compra ejecutada para {symbol}: Capital={self.capital:.2f}")

            elif decision == "sell" and self.positions[symbol]:
                position = self.positions[symbol].pop(0)  # Cerrar la posición más antigua
                exit_price = entry_price
                profit_loss = (exit_price - position["entry_price"]) * quantity - (quantity * exit_price * Config.fee_rate)
                position.update({
                    "exit_price": exit_price,
                    "profit_loss": profit_loss,
                    "action": "sell"
                })
                self.capital += (quantity * exit_price * (1 - Config.fee_rate))
                trade = Trade(
                    trade_id=position["trade_id"],
                    timestamp=datetime.strptime(position["timestamp"], "%Y-%m-%dT%H:%M:%S.%f%z"),
                    symbol=symbol,
                    action=position["action"],
                    entry_price=position["entry_price"],
                    exit_price=position["exit_price"],
                    quantity=position["quantity"],
                    profit_loss=position["profit_loss"],
                    decision=position["decision"],
                    combined=position["combined"],
                    ild=position["ild"],
                    egm=position["egm"],
                    rol=position["rol"],
                    pio=position["pio"],
                    ogm=position["ogm"],
                    risk_reward_ratio=position["risk_reward_ratio"]
                )
                db.add(trade)
                db.commit()
                logger.info(f"💸 Venta ejecutada para {symbol}: Capital={self.capital:.2f}, P&L={profit_loss:.2f}")

            self.trade_id_counter += 1
            self.iterations += 1
            self._save_results(None)
        except Exception as e:
            logger.error(f"❌ Error en _execute_trade para {symbol}: {e}")
            db.rollback()

    def _determine_decision_metrics(self, symbol: str):
        candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in
                       self.candles.get(symbol, [])] or []
        candle_tuple = tuple(json.dumps(candle_data))
        orderbook_str = json.dumps(self.orderbook_data[symbol])
        ticker_str = json.dumps(self.ticker_data[symbol])
        return self._cached_calculate_metrics(candle_tuple, orderbook_str, ticker_str)

    def _save_results(self, trade_result: Dict):
        total_profit = sum(trade["profit_loss"] for symbol in self.symbols for trade in self.positions[symbol] if trade["profit_loss"] > 0)
        total_loss = sum(trade["profit_loss"] for symbol in self.symbols for trade in self.positions[symbol] if trade["profit_loss"] < 0)
        total_trades = sum(len(self.positions[symbol]) for symbol in self.symbols)
        results = {
            "metadata": {
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "capital_inicial": Config.capital_usdt,
                "capital_actual": self.capital,
                "total_pnl": round(self.capital - Config.capital_usdt, 2),
                "total_trades": total_trades,
                "iterations": self.iterations,
                "running": self.running
            },
            "summary": {
                "total_profit": round(total_profit, 2),
                "total_loss": round(total_loss, 2),
                "net_profit": round(total_profit + total_loss, 2),
                "win_rate": round((total_profit / (total_trades + 1e-6)) * 100, 2)
            }
        }
        save_results(results, log_dir=os.path.join(os.path.dirname(__file__), '..', 'logs'))

    def stop(self):
        self.running = False
        if self.ws:
            self.ws.close()
        logger.info("🛑 Bot detenido")

    def save_to_csv(self, data: List[Dict], filename: str, fieldnames: List[str], base_dir: str = "logs"):
        log_dir = os.path.join(os.path.dirname(__file__), '..', base_dir, 'csv')
        os.makedirs(log_dir, exist_ok=True)
        filepath = os.path.join(log_dir, filename)
        file_exists = os.path.isfile(filepath)
        with open(filepath, mode='a', newline='') as csvfile:
            writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
            if not file_exists:
                writer.writeheader()
            for row in data:
                writer.writerow(row)

    def reset_trades(self):
        self.positions = {symbol: [] for symbol in self.symbols}
        self.trade_id_counter = self._load_initial_trade_id()
        with SessionLocal() as db:
            db.query(Trade).delete()
            db.commit()
        logger.info("🧹 Trades reseteados")

