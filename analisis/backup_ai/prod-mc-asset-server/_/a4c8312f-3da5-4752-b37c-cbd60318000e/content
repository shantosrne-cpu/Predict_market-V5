from fastapi import FastAPI
from contextlib import asynccontextmanager
from services.trading_engine import TradingEngine
from config import config
import logging

logging.basicConfig(
    level=logging.DEBUG,
    format="%(asctime)s [%(name)s] %(levelname)s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S"
)
logger = logging.getLogger("⚡ METAL ⚡")

@asynccontextmanager
async def lifespan(app: FastAPI):
    logger.info("Iniciando servidor API en http://127.0.0.1:8081")
    app.state.engines = {}
    try:
        app.state.engines["BTCUSDT"] = TradingEngine(
            symbol=config.symbol,
            timeframe=config.timeframe,
            capital=config.capital_usdt
        )
        await app.state.engines["BTCUSDT"].start()
    except Exception as exc:
        logger.error(f"Error al iniciar TradingEngine: {exc}")
        raise
    yield
    logger.info("Apagando servidor API...")
    try:
        for engine in app.state.engines.values():
            await engine.stop()
    except Exception as exc:
        logger.error(f"Error al detener TradingEngine: {exc}")

app = FastAPI(lifespan=lifespan)

@app.get("/health")
async def health_check():
    return {"status": "ok"}