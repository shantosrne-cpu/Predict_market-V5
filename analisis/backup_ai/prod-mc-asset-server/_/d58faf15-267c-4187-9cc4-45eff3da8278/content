import asyncio
import json
import websockets
from config.config import WS_URL
from utils.logger import logger

class WebSocketService:
    def __init__(self, engine):
        self.ws = None
        self.running = False
        self.engine = engine
        self.error_count = 0
        self.last_message_id = None
        self.max_reconnect_attempts = 10  # Límite de intentos de reconexión

    async def start(self):
        self.running = True
        await self._connect()

    async def stop(self):
        self.running = False
        if self.ws:
            await self.ws.close()

    async def _connect(self):
        attempt = 0
        while self.running and attempt < self.max_reconnect_attempts:
            try:
                async with websockets.connect(WS_URL) as ws:
                    self.ws = ws
                    logger.info("WebSocket conectado")
                    await self._resubscribe()
                    while self.running:
                        message = await ws.recv()
                        await self._on_message(message)
                    break  # Salir si se detiene manualmente
            except Exception as e:
                logger.error(f"Error WebSocket (intento {attempt + 1}/{self.max_reconnect_attempts}): {e}")
                self.error_count += 1
                attempt += 1
                delay = min(3 * (2 ** min(self.error_count, 5)), 60)
                await asyncio.sleep(delay)
        if attempt >= self.max_reconnect_attempts:
            logger.error("Máximo de intentos de reconexión alcanzado. Cerrando WebSocketService.")
            self.running = False

    async def _resubscribe(self):
        interval = self.engine.timeframe.replace("m", "")
        subscription = {
            "op": "subscribe",
            "args": [
                f"kline.{interval}.{self.engine.symbol}",
                f"orderbook.50.{self.engine.symbol}",
                f"tickers.{self.engine.symbol}"
            ]
        }
        if self.ws:
            await self.ws.send(json.dumps(subscription))
            logger.info(f"Suscripción enviada: {subscription}")

    async def _on_message(self, message: str):
        try:
            logger.debug(f"Mensaje recibido: {message}")
            data = json.loads(message)
            if "id" in data and data["id"] == self.last_message_id:
                logger.debug("Mensaje duplicado ignorado")
                return
            self.last_message_id = data.get("id")
            if "op" in data:
                if data["op"] == "subscribe" and data.get("success"):
                    logger.info("Suscripción confirmada")
                    return
                elif data["op"] == "ping" and data.get("success"):
                    logger.debug("Pong recibido")
                    return
            if "topic" in data and "data" in data:
                if "kline" in data["topic"]:
                    if data["data"] and isinstance(data["data"], list) and len(data["data"]) > 0:
                        await self.engine.handle_kline(data["data"][0])
                    else:
                        logger.warning("Datos de kline inválidos")
                elif "orderbook" in data["topic"]:
                    if "b" in data["data"] and "a" in data["data"]:
                        self.engine.orderbook_data = {"bids": data["data"]["b"], "asks": data["data"]["a"]}
                        await self.engine.store_orderbook()
                    else:
                        logger.warning("Datos de orderbook inválidos")
                elif "tickers" in data["topic"]:
                    if data["data"]:
                        await self.engine.handle_ticker(data["data"])
                    else:
                        logger.warning("Datos de tickers inválidos")
            else:
                logger.warning(f"Mensaje inesperado: {data}")
        except json.JSONDecodeError as e:
            logger.error(f"Error decodificando JSON: {e}")
        except Exception as e:
            logger.error(f"Error mensaje: {e}")