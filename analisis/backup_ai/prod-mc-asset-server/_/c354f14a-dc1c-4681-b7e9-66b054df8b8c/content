    try:
        yield db
    finally:
        db.close()

# Clase principal
class NertzMetalEngine:
    def __init__(self):
        self.symbol = Config.symbol
        self.timeframe = Config.timeframe
        self.capital = Config.capital_usdt
        self.positions: List[Dict] = []
        self.iterations = 0
        self.ws = None
        self.running = True
        self.orderbook_data: Dict = {"bids": [], "asks": []}
        self.ticker_data: Dict = {"last_price": 0.0, "volume_24h": 0.0, "high_24h": 0.0, "low_24h": 0.0}
        self.candles: List[MarketData] = []
        self.trade_id_counter = self._load_initial_trade_id()
        self._load_positions()
        self.last_orderbook_log = 0
        self.force_initial_trade = True

