import queue
import threading
from sqlalchemy import create_engine, Column, Integer, String, Float, DateTime, JSON
from sqlalchemy.orm import scoped_session, sessionmaker, declarative_base
from config.config import DATABASE_URL
from utils.logger import logger

# Inicialización de la cola y el engine
db_queue = queue.Queue()
try:
    engine = create_engine(
        f"sqlite:///{DATABASE_URL}", connect_args={"check_same_thread": False}  # Nota: Cambiar a False
    )
except Exception as e:
    logger.error(f"❌ Error al crear el engine de SQLite: {e}")
    raise

Base = declarative_base()

# Definición de las clases de modelo
class MarketData(Base):
    __tablename__ = "market_data"
    id = Column(Integer, primary_key=True, index=True)
    timestamp = Column(DateTime, index=True, nullable=False)
    symbol = Column(String(10), nullable=False)
    open = Column(Float, nullable=False, default=0.0)
    high = Column(Float, nullable=False, default=0.0)
    low = Column(Float, nullable=False, default=0.0)
    close = Column(Float, nullable=False, default=0.0)
    volume = Column(Float, nullable=False, default=0.0)


class Orderbook(Base):
    __tablename__ = "orderbook"
    id = Column(Integer, primary_key=True, index=True)
    timestamp = Column(DateTime, nullable=False, index=True)
    symbol = Column(String(10), nullable=False, index=True)
    bids = Column(JSON, nullable=False)
    asks = Column(JSON, nullable=False)


class MarketTicker(Base):
    __tablename__ = "market_ticker"
    id = Column(Integer, primary_key=True, index=True)
    timestamp = Column(DateTime, nullable=False, index=True)
    symbol = Column(String(10), nullable=False, index=True)
    last_price = Column(Float, nullable=False, default=0.0)
    volume_24h = Column(Float, nullable=False, default=0.0)
    high_24h = Column(Float, nullable=False, default=0.0)
    low_24h = Column(Float, nullable=False, default=0.0)


class Trade(Base):
    __tablename__ = "trades"
    id = Column(Integer, primary_key=True, index=True)
    trade_id = Column(Integer, nullable=False, unique=True)
    timestamp = Column(DateTime, nullable=False, index=True)
    symbol = Column(String(10), nullable=False, index=True)
    action = Column(String, nullable=False)
    entry_price = Column(Float, nullable=False, default=0.0)
    exit_price = Column(Float, nullable=False, default=0.0)
    quantity = Column(Float, nullable=False, default=0.0)
    profit_loss = Column(Float, nullable=False, default=0.0)
    decision = Column(String, nullable=False)
    combined = Column(Float, nullable=False, default=0.0)
    ild = Column(Float, nullable=False, default=0.0)
    egm = Column(Float, nullable=False, default=0.0)
    rol = Column(Float, nullable=False, default=0.0)
    pio = Column(Float, nullable=False, default=0.0)
    ogm = Column(Float, nullable=False, default=0.0)
    risk_reward_ratio = Column(Float, nullable=False, default=1.5)



# Crear las tablas en la BD
try:
    Base.metadata.create_all(bind=engine)
    logger.info("📊 Tablas de base de datos creadas exitosamente")
except Exception as e:
    logger.error(f"❌ Error al crear las tablas: {e}")
    raise

# Configuración de la sesión utilizando scoped_session
SessionLocal = scoped_session(sessionmaker(autocommit=False, autoflush=False, bind=engine))

# Hilo Worker para manejar operaciones de la base de datos
def db_worker():
    while True:
        func = db_queue.get()  # Obtener la tarea de la cola
        if func is None:
            logger.info("🛑 Hilo de base de datos detenido")
            break
        try:
            # Crear una sesión independiente para cada tarea
            db = SessionLocal()
            func(db)  # Ejecutar la operación de base de datos con la sesión actual
        except Exception as e:
            logger.error(f"❌ Error en operación de base de datos: {e}")
        finally:
            db.close()  # Cerrar la sesión después de ejecutar la tarea
            db_queue.task_done()

# Iniciar el hilo de trabajo del Worker
db_thread = threading.Thread(target=db_worker, daemon=True)
try:
    db_thread.start()
    logger.info("🔧 Hilo de base de datos iniciado")
except Exception as e:
    logger.error(f"❌ Error al iniciar el hilo de base de datos: {e}")
    raise

# Función para ejecutar operaciones en la base de datos
def execute_in_db(func):
    """Agrega una tarea al worker encargado de manejar las operaciones de BD."""
    db_queue.put(func)

# Contexto de sesión para obtener una nueva sesión independiente
def get_db():
    """Provee un contexto de sesión para operaciones directas."""
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()