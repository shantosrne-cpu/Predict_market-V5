from datetime import datetime, timezone
from fastapi import FastAPI, Depends, HTTPException
from models.database import MarketData, Orderbook, MarketTicker, Trade, execute_in_db
from services.metrics import calculate_metrics
import services.trading_engine
from utils.logger import logger

app = FastAPI()

def get_engine(symbol: str):
    if not hasattr(app.state, 'engines') or symbol not in app.state.engines or not app.state.engines[symbol].running:
        raise HTTPException(status_code=500, detail=f"TradingEngine para {symbol} no inicializado o no está corriendo")
    return app.state.engines[symbol]

@app.get("/market_data/{symbol}")
async def get_market_data(symbol: str, engine: services.trading_engine.TradingEngine = Depends(get_engine)):
    logger.info(f"📡 /market_data/{symbol}")
    try:
        candles = engine.candles[-5:] if engine.candles else []
        if not candles:
            logger.warning(f"⚠️ No se encontraron candles para {symbol} en engine.candles")
            return {"symbol": symbol, "candles": [], "message": "No data", "timestamp": datetime.now(timezone.utc).isoformat() + "Z"}

        return {
            "symbol": symbol,
            "candles": [
                {
                    "timestamp": c.timestamp.isoformat() + "Z",
                    "open": c.open,
                    "high": c.high,
                    "low": c.low,
                    "close": c.close,
                    "volume": c.volume
                } for c in candles
            ],
            "message": "",
            "timestamp": datetime.now(timezone.utc).isoformat() + "Z"
        }
    except Exception as exc:
        logger.error(f"❌ Error en /market_data: {exc}")
        raise HTTPException(status_code=500, detail=f"Error interno: {str(exc)}")

