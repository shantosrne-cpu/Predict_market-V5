    def start(self) -> None:
        logger.info(f"Motor metalero iniciado para {self.symbol}")
        self.fetch_initial_data()
        self.websocket_service.start(self)

    def stop(self) -> None:
        self.running = False
        self.websocket_service.stop()
        logger.info("Bot detenido")

    def handle_kline(self, kline: Dict) -> None:
        logger.debug(f"Kline recibido: {kline}")
        if "start" not in kline or not isinstance(kline["start"], (int, str)):
            logger.warning(f"Kline inválido, falta 'start' o no es numérico: {kline}")
            return
        try:
            timestamp = timestamp_to_datetime(int(kline["start"]) / 1000)
            candle = MarketData(
                timestamp=timestamp,
                symbol=self.symbol,
                open=float(kline["open"]),
                high=float(kline["high"]),
                low=float(kline["low"]),
                close=float(kline["close"]),
                volume=float(kline["volume"])
            )
            def save_kline(db):
                if not db.query(MarketData).filter(MarketData.timestamp == candle.timestamp, MarketData.symbol == self.symbol).first():
                    db.add(candle)
                    db.commit()
                    self.candles = db.query(MarketData).filter(MarketData.symbol == self.symbol).order_by(MarketData.timestamp.desc()).limit(5).all()
                    logger.info(f"Kline: {timestamp}, Close: {candle.close}")
                    self._execute_trade(db)
            execute_in_db(save_kline)
        except Exception as exc:
            logger.error(f"Error en handle_kline: {exc}")

    def store_orderbook(self) -> None:
        if not isinstance(self.orderbook_data["bids"], list) or not isinstance(self.orderbook_data["asks"], list):
            logger.warning("Bids o asks no son listas válidas")
            return
        if not self.orderbook_data["bids"] and not self.orderbook_data["asks"]:
            logger.warning("Orderbook completamente vacío")
            return
        if not self.orderbook_data["asks"] and hasattr(self, "last_valid_orderbook"):
            self.orderbook_data["asks"] = self.last_valid_orderbook["asks"]
        orderbook = Orderbook(
            timestamp=datetime.now(timezone.utc),
            symbol=self.symbol,
            bids=self.orderbook_data["bids"],
            asks=self.orderbook_data["asks"]
        )
        self.last_valid_orderbook = {"bids": self.orderbook_data["bids"], "asks": self.orderbook_data["asks"]}
        def save_orderbook(db):
            db.add(orderbook)
            db.commit()
            if time.time() - self.last_orderbook_log >= 5:
                logger.info(f"Orderbook actualizado")
                self.last_orderbook_log = time.time()
        execute_in_db(save_orderbook)

    def handle_ticker(self, ticker: Dict) -> None:
        try:
            self.ticker_data = {
                "last_price": float(ticker["lastPrice"]),
                "volume_24h": float(ticker["volume24h"]),
                "high_24h": float(ticker["highPrice24h"]),
                "low_24h": float(ticker["lowPrice24h"])
            }
            market_ticker = MarketTicker(
                timestamp=datetime.now(timezone.utc),
                symbol=self.symbol,
                last_price=self.ticker_data["last_price"],
                volume_24h=self.ticker_data["volume_24h"],
                high_24h=self.ticker_data["high_24h"],
                low_24h=self.ticker_data["low_24h"]
            )
            def save_ticker(db):
                db.add(market_ticker)
                db.commit()
                logger.info(f"Ticker: {self.ticker_data['last_price']}")
            execute_in_db(save_ticker)
        except Exception as exc:
            logger.error(f"Error en handle_ticker: {exc}")

    def _determine_decision(self) -> str:
        candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume} for c in self.candles]
        metrics = calculate_metrics(candle_data, self.orderbook_data, self.ticker_data)
        logger.info(f"Métricas: {metrics}")
        recent_positions = self.positions[-10:] if len(self.positions) >= 10 else self.positions
        buy_count = sum(1 for pos in recent_positions if pos["action"] == "Buy")
        sell_count = len(recent_positions) - buy_count
        buy_sell_ratio = buy_count / (sell_count + 1)
        if metrics["combined"] > 0.5 and self.capital > self.config.min_capital and buy_sell_ratio < 2.0:
            return "buy"
        elif metrics["combined"] < -0.5 and len(self.positions) > 0 and buy_sell_ratio > 0.5:
            return "sell"
        return "hold"

    def _place_order(self, action: str, quantity: float, price: float) -> Dict:
        logger.info(f"Simulando {action}, Qty: {quantity:.6f}, Price: {price:.2f}")
        return {"success": True, "order_id": f"sim-{self.trade_id_counter}", "entry_price": price}

    def _close_order (self, order_id_param: str, action: str, quantity: float, entry_price: float, db) -> Dict:
        try:
            # Verificar si el trade_id ya existe
            existing_trade = db.query (Trade).filter_by (trade_id=self.trade_id_counter).first ()
            if existing_trade:
                logger.warning (f"Trade_id {self.trade_id_counter} ya existe, usando el existente")
                return {"success": True, "exit_price": existing_trade.exit_price}

            # Determinar el precio de salida desde el orderbook
            if action == "Buy" and self.orderbook_data ["asks"]:
                exit_price = float (self.orderbook_data ["asks"] [0] [0])
            elif action == "Sell" and self.orderbook_data ["bids"]:
                exit_price = float (self.orderbook_data ["bids"] [0] [0])
            else:
                logger.warning ("Orderbook vacío, usando fallback con variación mínima")
                exit_price = entry_price * (1.002 if action == "Buy" else 0.998)

            # Asegurar que el precio de salida no sea igual al de entrada
            if exit_price == entry_price:
                logger.warning (f"Exit price igual a entry price ({entry_price}), ajustando ligeramente")
                exit_price = entry_price * (1.001 if action == "Buy" else 0.999)

            # Calcular profit_loss (esto faltaba en el código original aquí)
            profit_loss = (exit_price - entry_price) * quantity if action == "Buy" else (
                                                                                                    entry_price - exit_price) * quantity

            # Calcular métricas
            candle_data = [{"open": c.open, "high": c.high, "low": c.low, "close": c.close, "volume": c.volume}
                           for c in self.candles]
            metrics = calculate_metrics (candle_data, self.orderbook_data, self.ticker_data) if candle_data else {
                "combined": 0.0, "ild": 0.0, "egm": 0.0, "rol": 0.0, "pio": 0.0, "ogm": 0.0
            }

            # Crear el objeto Trade
            trade = Trade (
                trade_id=self.trade_id_counter,
                timestamp=datetime.now (timezone.utc),
                symbol=self.symbol,
                action=action,
                entry_price=entry_price,
                exit_price=exit_price,
                quantity=quantity,
                profit_loss=profit_loss,
                decision=action.lower (),
                combined=metrics ["combined"],
                ild=metrics ["ild"],
                egm=metrics ["egm"],
                rol=metrics ["rol"],
                pio=metrics ["pio"],
                ogm=metrics ["ogm"],
                risk_reward_ratio=1.5
            )
            db.add (trade)
            db.commit ()

            # Actualizar capital y agregar a positions
            self.capital += profit_loss
            trade_dict = {k: getattr (trade, k) for k in vars (trade).keys () if k != 'id'}
            self.positions.append (trade_dict)

            # Incrementar el contador de trades
            self.trade_id_counter += 1
            logger.info (f"Cierre: P&L={profit_loss:.2f}, Entry={entry_price:.2f}, Exit={exit_price:.2f}")

            return {"success": True, "exit_price": exit_price}
        except Exception as exc:
            logger.error (f"Error en _close_order: {exc}")
            db.rollback ()
            return {"success": False, "error": str (exc)}

    def _execute_trade (self, db) -> None:
        if not self.running or self.iterations >= self.config.max_iterations:
            logger.info (f"Detenido: Iter={self.iterations}/{self.config.max_iterations}")
            self.stop ()
            return
        if time.time () - self.last_trade_time < 300:
            logger.info ("Cooldown activo, esperando...")
            return

        decision = self._determine_decision ()
        if decision == "hold":
            logger.info ("Hold")
            self.iterations += 1
            self._save_results (None)
            return

        # Determinar precio de entrada y cantidad
        entry_price = float (self.ticker_data.get ("last_price", 80090.68))
        liquidity = sum (float (bid [1]) * float (bid [0]) for bid in self.orderbook_data ["bids"] [:5]) if \
        self.orderbook_data ["bids"] else 0
        quantity = max (min (self.config.risk_factor * self.capital / entry_price * (liquidity / 1000 + 1),
                             self.config.max_trade_size), self.config.min_trade_size)
        logger.info (f"Trade: {decision}, Price={entry_price:.2f}, Qty={quantity:.6f}")

        try:
            # Colocar la orden
            order_result = self._place_order (decision, quantity, entry_price)
            if not order_result ["success"]:
                logger.error (f"Orden falló: {order_result.get ('error')}")
                return

            # Esperar y cerrar la orden
            time.sleep (5)
            close_result = self._close_order (order_result ["order_id"], "Sell" if decision == "buy" else "Buy",
                                              quantity, entry_price, db)
            if not close_result ["success"]:
                logger.error (f"Cierre falló: {close_result.get ('error')}")
                return

            # Obtener el exit_price del cierre
            exit_price = close_result ["exit_price"]

            # Actualizar iteraciones y tiempo del último trade
            self.iterations += 1
            self.last_trade_time = time.time ()

            # Crear el trade_result para guardar
            trade_result = {
                "trade_id": self.trade_id_counter - 1,  # Usar el ID recién asignado en _close_order
                "timestamp": datetime.now (timezone.utc).isoformat () + "Z",
                "symbol": self.symbol,
                "action": decision,
                "entry_price": entry_price,
                "exit_price": exit_price,
                "quantity": quantity,
                "profit_loss": (exit_price - entry_price) * quantity if decision == "buy" else (
                                                                                                           entry_price - exit_price) * quantity,
                "current_capital": self.capital
            }

            # Guardar resultados
            self._save_results (trade_result)

        except Exception as exc:
            logger.error (f"Error en _execute_trade: {exc}")
            db.rollback ()

    def _save_results(self, trade_result: Optional[Dict]) -> None:
        results = {
            "capital_inicial": self.config.capital_usdt,
            "capital_final": self.capital,
            "total_pnl": self.capital - self.config.capital_usdt,
            "trades": self.positions,
            "iterations": self.iterations
        }
        if trade_result:
            results["last_trade"] = trade_result

        if self.iterations % 100 == 0:
            def clean_db(db):
                cutoff = datetime.now(timezone.utc) - timedelta(days=7)
                db.query(Trade).filter(Trade.timestamp < cutoff).delete()
                db.commit()
                logger.info("Base de datos limpiada: trades antiguos eliminados")
            execute_in_db(clean_db)

        try:
            save_results(results, log_dir=os.path.join(os.path.dirname(__file__), '..', 'logs'), consolidate=True, max_files=1)
        except Exception as exc:
            logger.error(f"Error al guardar resultados: {exc}")

    def reset_trades (self, reset_counter: bool = False) -> None:
        """
        Resetea los trades en la base de datos y, opcionalmente, el contador de trade_id.
        Mantiene el resto de los datos (candles, orderbook, ticker) intactos.
        """

        def delete_trades (db):
            db.query (Trade).filter (Trade.symbol == self.symbol).delete ()
            db.commit ()
            logger.info (f"Trades reseteados para {self.symbol}")

        try:
            execute_in_db (delete_trades)
            self.positions = []  # Limpiar la lista de posiciones en memoria
            if reset_counter:
                self.trade_id_counter = 1  # Reiniciar el contador si se especifica
                logger.info ("Contador de trade_id reiniciado a 1")
            else:
                # Ajustar el contador al último ID + 1 si no se reinicia completamente
                self.trade_id_counter = self._load_initial_trade_id ()
            logger.info ("Reset de trades completado")
        except Exception as exc:
            logger.error (f"Error al resetear trades: {exc}")