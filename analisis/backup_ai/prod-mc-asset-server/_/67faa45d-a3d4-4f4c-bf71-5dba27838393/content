import os
from dataclasses import dataclass
from dotenv import load_dotenv
from utils.logger import logger

dotenv_path = os.path.join(os.path.dirname(__file__), '..', '.env')
if not os.path.exists(dotenv_path):
    logger.warning(f"Archivo .env no encontrado en {dotenv_path}, usando valores por defecto")
load_dotenv(dotenv_path=dotenv_path)

@dataclass
class Config:
    api_key: str = os.getenv("BYBIT_API_KEY", "")
    api_secret: str = os.getenv("BYBIT_API_SECRET", "")
    use_testnet: bool = os.getenv("USE_TESTNET", "true").lower() == "true"
    symbol: str = os.getenv("SYMBOL", "BTCUSDT")
    timeframe: str = os.getenv("TIMEFRAME", "5m")
    max_iterations: int = int(os.getenv("MAX_ITERATIONS", "1440"))
    capital_usdt: float = float(os.getenv("CAPITAL_USDT", "50000.0"))
    min_capital: float = float(os.getenv("MIN_CAPITAL", "1000.0"))
    risk_factor: float = float(os.getenv("RISK_FACTOR", "0.01"))
    min_trade_size: float = float(os.getenv("MIN_TRADE_SIZE", "0.0001"))
    max_trade_size: float = float(os.getenv("MAX_TRADE_SIZE", "0.1"))
    fee_rate: float = float(os.getenv("FEE_RATE", "0.002"))

    def validate(self):
        if not self.api_key or not self.api_secret:
            logger.error("API Key o Secret no definidos")
            raise ValueError("API Key y Secret son obligatorios")
        if self.capital_usdt < self.min_capital:
            logger.error("Capital inicial menor que mínimo permitido")
            raise ValueError("Capital inicial debe ser >= min_capital")

config = Config()
config.validate()

BASE_URL = "https://api-testnet.bybit.com" if config.use_testnet else "https://api.bybit.com"
WS_URL = "wss://stream-testnet.bybit.com/v5/public/spot" if config.use_testnet else "wss://stream.bybit.com/v5/public/spot"

DATABASE_DIR = os.path.join(os.path.dirname(__file__), '..', 'data')
if not os.path.exists(DATABASE_DIR):
    os.makedirs(DATABASE_DIR)
    logger.info(f"Directorio {DATABASE_DIR} creado")
DATABASE_URL = os.path.join(DATABASE_DIR, 'trading.db').replace('\\', '/')