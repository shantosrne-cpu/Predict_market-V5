import sqlite3
import pandas as pd
from pathlib import Path


class TradingStrategy:
    def __init__ (self, symbol, timeframe, db_path):
        self.symbol = symbol
        self.timeframe = timeframe
        self.db_path = Path (db_path).resolve ()  # Asegurar ruta absoluta
        self.data = None

    def load_data (self, limit=100):
        """Carga los datos más recientes de market_data.db con manejo de errores."""
        if not self.db_path.exists ():
            raise FileNotFoundError (f"❌ [⚡ METAL ⚡] Base de datos no encontrada en: {self.db_path}")

        try:
            conn = sqlite3.connect (self.db_path)
            query = f"""
                SELECT timestamp, open, high, low, close, volume
                FROM market_data
                WHERE symbol = ? AND timeframe = ?
                ORDER BY timestamp DESC
                LIMIT ?
            """
            self.data = pd.read_sql_query (query, conn, params=(self.symbol, self.timeframe, limit))
            self.data = self.data [::-1]  # Ordenar por timestamp ascendente
            conn.close ()
            if len (self.data) < 2:
                return {"action": "HOLD", "reason": "⚡ [⚡ METAL ⚡] No hay suficientes datos"}
        except sqlite3.Error as e:
            raise Exception (f"❌ [⚡ METAL ⚡] Error al cargar datos: {e}")

    def execute (self):
        """Método base para ejecutar la estrategia"""
        raise NotImplementedError ("⚡ [⚡ METAL ⚡] Esta estrategia debe implementarse en una subclase")


class EMAStrategy (TradingStrategy):
    def __init__ (self, symbol, timeframe, db_path, short_period=5, long_period=20):
        super ().__init__ (symbol, timeframe, db_path)
        self.short_period = short_period
        self.long_period = long_period

    def execute (self):
        result = self.load_data ()
        if isinstance (result, dict) and result.get ("action") == "HOLD":
            return result

        if len (self.data) < self.long_period or len (self.data) < 2:
            return {"action": "HOLD", "reason": "⚡ [⚡ METAL ⚡] No hay suficientes datos para calcular EMAs"}

        self.data ['ema_short'] = self.data ['close'].ewm (span=self.short_period, adjust=False).mean ()
        self.data ['ema_long'] = self.data ['close'].ewm (span=self.long_period, adjust=False).mean ()

        latest = self.data.iloc [-1]
        previous = self.data.iloc [-2]
        if previous ['ema_short'] < previous ['ema_long'] and latest ['ema_short'] > latest ['ema_long']:
            return {"action": "BUY"}
        elif previous ['ema_short'] > previous ['ema_long'] and latest ['ema_short'] < latest ['ema_long']:
            return {"action": "SELL"}
        return {"action": "HOLD"}


# (Otras clases como BollingerBandsStrategy, RsiStrategy, TripleEMATpslStrategy permanecen iguales, ajusta solo si es necesario)

class BollingerBandsStrategy(TradingStrategy):
    def __init__(self, symbol, timeframe, db_path, period=20, std_dev=2):
        super().__init__(symbol, timeframe, db_path)
        self.period = period
        self.std_dev = std_dev

    def execute(self):
        self.load_data()
        if len(self.data) < self.period:
            return {"action": "HOLD", "reason": "⚡ [⚡ METAL ⚡] No hay suficientes datos para calcular Bollinger Bands"}

        self.data['sma'] = self.data['close'].rolling(window=self.period).mean()
        self.data['std'] = self.data['close'].rolling(window=self.period).std()
        self.data['upper_band'] = self.data['sma'] + (self.data['std'] * self.std_dev)
        self.data['lower_band'] = self.data['sma'] - (self.data['std'] * self.std_dev)

        latest = self.data.iloc[-1]
        if latest['close'] > latest['upper_band']:
            return {"action": "SELL"}
        elif latest['close'] < latest['lower_band']:
            return {"action": "BUY"}
        return {"action": "HOLD"}

class RsiStrategy(TradingStrategy):
    def __init__(self, symbol, timeframe, db_path, period=14, overbought=70, oversold=30):
        super().__init__(symbol, timeframe, db_path)
        self.period = period
        self.overbought = overbought
        self.oversold = oversold

    def execute(self):
        self.load_data()
        if len(self.data) < self.period:
            return {"action": "HOLD", "reason": "⚡ [⚡ METAL ⚡] No hay suficientes datos para calcular RSI"}

        delta = self.data['close'].diff()
        gain = (delta.where(delta > 0, 0)).rolling(window=self.period).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(window=self.period).mean()
        rs = gain / loss
        self.data['rsi'] = 100 - (100 / (1 + rs))

        latest_rsi = self.data['rsi'].iloc[-1]
        if latest_rsi > self.overbought:
            return {"action": "SELL"}
        elif latest_rsi < self.oversold:
            return {"action": "BUY"}
        return {"action": "HOLD"}

class TripleEMATpslStrategy(TradingStrategy):
    def __init__(self, symbol, timeframe, db_path, short=5, medium=13, long=21):
        super().__init__(symbol, timeframe, db_path)
        self.short = short
        self.medium = medium
        self.long = long

    def execute(self):
        self.load_data()
        if len(self.data) < self.long or len(self.data) < 2:
            return {"action": "HOLD", "reason": "⚡ [⚡ METAL ⚡] No hay suficientes datos para calcular Triple EMA"}

        self.data['ema_short'] = self.data['close'].ewm(span=self.short, adjust=False).mean()
        self.data['ema_medium'] = self.data['close'].ewm(span=self.medium, adjust=False).mean()
        self.data['ema_long'] = self.data['close'].ewm(span=self.long, adjust=False).mean()

        latest = self.data.iloc[-1]
        if (latest['ema_short'] > latest['ema_medium'] > latest['ema_long']):
            return {"action": "BUY"}
        elif (latest['ema_short'] < latest['ema_medium'] < latest['ema_long']):
            return {"action": "SELL"}
        return {"action": "HOLD"}