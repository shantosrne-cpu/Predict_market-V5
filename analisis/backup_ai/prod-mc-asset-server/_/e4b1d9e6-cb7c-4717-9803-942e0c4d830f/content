import json
import logging
import sqlite3
from datetime import datetime, timezone
from pathlib import Path

import numpy as np

from adju_config import config

# Configurar logging con vibe metalero
logging.basicConfig(level=logging.INFO, format='%(asctime)s [⚡ METAL ⚡] %(message)s')
logger = logging.getLogger("CreateDB")

# Obtener la ruta de la base de datos desde la configuración
base_path = Path(config.get_config()["base_path"])
db_path = base_path / "market_data.db"

# Asegurarse de que el directorio DATA exista
base_path.mkdir(parents=True, exist_ok=True)

# Conectar a la base de datos con manejo de errores
try:
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    logger.info(f"⚡ Conectado a la base de datos en: {db_path}")
except sqlite3.Error as e:
    logger.error(f"❌ [⚡ METAL ⚡] Error al conectar a la base de datos: {e}")
    raise

# Crear tablas
try:
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS market_data (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp INTEGER NOT NULL,
            symbol TEXT NOT NULL,
            timeframe TEXT NOT NULL,
            open REAL NOT NULL,
            high REAL NOT NULL,
            low REAL NOT NULL,
            close REAL NOT NULL,
            volume REAL NOT NULL,
            UNIQUE(timestamp, symbol, timeframe)
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS orderbook (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp INTEGER NOT NULL,
            symbol TEXT NOT NULL,
            bids TEXT NOT NULL,
            asks TEXT NOT NULL,
            UNIQUE(timestamp, symbol)
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS market_ticker (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp INTEGER NOT NULL,
            symbol TEXT NOT NULL,
            last_price REAL NOT NULL,
            volume_24h REAL NOT NULL,
            high_24h REAL NOT NULL,
            low_24h REAL NOT NULL,
            UNIQUE(timestamp, symbol)
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS transactions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp INTEGER NOT NULL,
            symbol TEXT NOT NULL,
            action TEXT NOT NULL,
            entry_price REAL NOT NULL,
            exit_price REAL NOT NULL,
            quantity REAL NOT NULL,
            profit_loss REAL NOT NULL,
            status TEXT NOT NULL
        )
    """)
    logger.info("⚡ Tablas creadas exitosamente en la base de datos")
except sqlite3.Error as e:
    logger.error(f"❌ [⚡ METAL ⚡] Error al crear las tablas: {e}")
    conn.close()
    raise

# Insertar datos ficticios
symbol = config.get_config()["symbol"]
timeframe = config.get_config()["timeframe"]
timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)

# 1. Datos ficticios para market_data (50 velas con variación sinusoidal)
try:
    for i in range(50):  # 50 velas ficticias
        price = 90000 + np.sin(i * 0.1) * 500  # Variación sinusoidal para simular fluctuaciones
        open_price = price
        high_price = price + np.random.uniform(50, 150)
        low_price = price - np.random.uniform(50, 150)
        close_price = price + np.random.uniform(-50, 50)
        volume = 1000 + np.random.uniform(0, 500)
        cursor.execute("""
            INSERT INTO market_data (timestamp, symbol, timeframe, open, high, low, close, volume)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (timestamp - i * 60000, symbol, timeframe, open_price, high_price, low_price, close_price, volume))
    logger.info(f"⚡ {symbol} - {timeframe}: 50 velas ficticias insertadas con variación sinusoidal")
except sqlite3.Error as e:
    logger.error(f"❌ [⚡ METAL ⚡] Error al insertar datos en market_data: {e}")
    conn.close()
    raise

# 2. Datos ficticios para orderbook (5 entradas)
try:
    for i in range(5):
        bids = [[90000.0 - i * 10, 10.0 + i] for i in range(3)]  # Ejemplo: [[90000, 10], [89990, 11], [89980, 12]]
        asks = [[90100.0 + i * 10, 12.0 + i] for i in range(3)]  # Ejemplo: [[90100, 12], [90110, 13], [90120, 14]]
        cursor.execute("""
            INSERT INTO orderbook (timestamp, symbol, bids, asks)
            VALUES (?, ?, ?, ?)
        """, (timestamp - i * 60000, symbol, json.dumps(bids), json.dumps(asks)))
    logger.info(f"⚡ {symbol}: 5 entradas ficticias de orderbook insertadas")
except sqlite3.Error as e:
    logger.error(f"❌ [⚡ METAL ⚡] Error al insertar datos en orderbook: {e}")
    conn.close()
    raise

# 3. Datos ficticios para market_ticker (5 entradas)
try:
    for i in range(5):
        last_price = 90000 + np.sin(i * 0.1) * 500
        cursor.execute("""
            INSERT INTO market_ticker (timestamp, symbol, last_price, volume_24h, high_24h, low_24h)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (timestamp - i * 60000, symbol, last_price, 2500000.0 + i * 1000, last_price + 500, last_price - 500))
    logger.info(f"⚡ {symbol}: 5 entradas ficticias de market_ticker insertadas")
except sqlite3.Error as e:
    logger.error(f"❌ [⚡ METAL ⚡] Error al insertar datos en market_ticker: {e}")
    conn.close()
    raise

# 4. Datos ficticios para transactions (3 transacciones)
try:
    for i in range(3):
        action = "BUY" if i % 2 == 0 else "SELL"
        entry_price = 90000 + i * 100
        exit_price = entry_price * (1.05 if action == "BUY" else 0.95)
        quantity = 0.001
        profit_loss = quantity * (exit_price - entry_price) * (1 if action == "BUY" else -1)
        cursor.execute("""
            INSERT INTO transactions (timestamp, symbol, action, entry_price, exit_price, quantity, profit_loss, status)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (timestamp - i * 60000, symbol, action, entry_price, exit_price, quantity, profit_loss, "CLOSED"))
    logger.info(f"⚡ {symbol}: 3 transacciones ficticias insertadas")
except sqlite3.Error as e:
    logger.error(f"❌ [⚡ METAL ⚡] Error al insertar datos en transactions: {e}")
    conn.close()
    raise

# Confirmar cambios y cerrar conexión
try:
    conn.commit()
    logger.info(f"⚡ Base de datos poblada con datos ficticios en {db_path}")
except sqlite3.Error as e:
    logger.error(f"❌ [⚡ METAL ⚡] Error al confirmar cambios: {e}")
finally:
    conn.close()
    logger.info("⚡ Conexión a la base de datos cerrada")