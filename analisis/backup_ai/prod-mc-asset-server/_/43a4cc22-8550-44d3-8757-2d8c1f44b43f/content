                            volume=float(k[5])
                        ) for k in kline_response["result"]["list"]
                    ]
                    def save_initial_candles(db):
                        for candle in self.candles:
                            if not db.query(MarketData).filter(MarketData.timestamp == candle.timestamp, MarketData.symbol == self.symbol).first():
                                db.add(candle)
                        db.commit()
