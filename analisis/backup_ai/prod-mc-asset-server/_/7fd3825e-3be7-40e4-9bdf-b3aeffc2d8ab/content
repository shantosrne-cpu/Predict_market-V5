import logging
from datetime import datetime, timezone
from pathlib import Path

import numpy as np

logging.basicConfig(level=logging.INFO, format='%(asctime)s [⚡ METAL ⚡] %(message)s')
logger = logging.getLogger("AdjuMarket")

def calculate_metrics(candles: list, orderbook: dict, ticker: dict) -> dict:
    if not candles or not orderbook or not ticker or not any("close" in c for c in candles):
        return {"egm": 0.0, "combined": 0.0, "volatility": 0.0, "volume_zscore": 0.0}

    close_prices = np.array([c["close"] for c in candles if "close" in c], dtype=np.float64)
    volumes = np.array([c["volume"] for c in candles if "volume" in c], dtype=np.float64)
    volume_24h = ticker.get("volume_24h", 0.0)

    egm = (close_prices[-1] - close_prices[0]) / close_prices[0] * 100 if len(close_prices) > 1 else 0.0
    volatility = np.std(close_prices) / np.mean(close_prices) * 100 if np.mean(close_prices) > 0 else 0.0
    volume_zscore = (volume_24h - np.mean(volumes)) / np.std(volumes) if np.std(volumes) != 0 else 0.0

    combined = egm * (1 + volatility / 100) * (1 + abs(volume_zscore))

    logger.info(
        f"📈 Métricas bestiales - EGM: {egm:.2f}, Volatility: {volatility:.2f}, Volume Z-score: {volume_zscore:.2f}, Combined: {combined:.2f}")
    return {"egm": egm, "combined": combined, "volatility": volatility, "volume_zscore": volume_zscore}

def save_results(results: dict, log_dir: Path):
    log_dir.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%d_%H-%M-%S")
    log_file = log_dir / f"system_{timestamp}.log"

    with open(log_file, "w", encoding="utf-8") as f:
        f.write(f"Resultados Bestiales de AdjuDev - {timestamp}\n")
        for key, value in results.items():
            f.write(f"{key}: {value}\n")

    logger.info(f"💾 Resultados guardados en {log_file}")

def timestamp_to_datetime(timestamp: int) -> datetime:
    return datetime.fromtimestamp(timestamp / 1000, tz=timezone.utc)