import hmac
import hashlib
from typing import Dict
from config import config
from utils.logger import logger
import time

def generate_signature(params: Dict[str, str] = None, recv_window: int = 5000) -> str:
    """
    Generate HMAC-SHA256 signature for Bybit API requests using the provided API secret.

    :param params: A dictionary of parameters to be included in the signature.
    :param recv_window: The request time window in milliseconds (default: 5000).
    :return: The generated HMAC-SHA256 signature as a hexadecimal string.
    """
    if not params:
        params = {}
    if not config.api_secret:
        logger.error("API Secret no definido en config")
        raise ValueError("API Secret es obligatorio")

    # Añadir timestamp y recv_window a los parámetros
    params["api_key"] = config.api_key
    params["timestamp"] = str(int(time.time() * 1000))
    params["recv_window"] = str(recv_window)

    try:
        # Ordenar parámetros y crear query string
        sorted_params = "&".join([f"{k}={v}" for k, v in sorted(params.items())])
        signature = hmac.new(
            config.api_secret.encode(),
            sorted_params.encode(),
            hashlib.sha256
        ).hexdigest()
        return signature
    except Exception as e:
        logger.error(f"Error generating signature: {e}")
        raise

if __name__ == "__main__":
    example_params = {"symbol": "BTCUSDT", "side": "Buy"}
    try:
        signature = generate_signature(example_params)
        logger.info(f"Generated Signature: {signature}")
        logger.info(f"Parameters: {example_params}")
    except ValueError as e:
        logger.error(f"Error en ejemplo: {e}")