# Bybit credentials. Use Demo Trading credentials for TRADING_ENV=demo.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Active execution environment. Valid values: demo, mainnet.
# demo uses Bybit Demo Trading.
TRADING_ENV=demo

# Market scope.
SYMBOL=BTCUSDT
TIMEFRAME=1m
ORDERBOOK_DEPTH=50
ORDER_TYPE=Limit
TIME_IN_FORCE=GTC

# Runtime.
CAPITAL_USDT=1000
MAX_ITERATIONS=0
DEFAULT_SLEEP_TIME=10
RATE_LIMIT_DELAY=50

# Risk and execution.
RISK_FACTOR=0.01
MAX_TRADE_SIZE=0.05
MIN_TRADE_SIZE=0.0001
FEE_RATE=0.002
TP_PERCENTAGE=1.5
SL_PERCENTAGE=0.5
PRICE_SHIFT_FACTOR=0.003

# Signal thresholds.
RSI_UPPER_THRESHOLD=80
RSI_LOWER_THRESHOLD=20
PIO_THRESHOLD=0
EGM_BUY_THRESHOLD=0.02
EGM_SELL_THRESHOLD=-0.02
COMBINED_BUY_THRESHOLD=25
COMBINED_SELL_THRESHOLD=-25
COMBINED_HOLD_BAND=12
ORDERBOOK_LAMBDA=0.03
ORDERBOOK_PCT_BAND=0.015
ILD_TARGET_MOVE=0.002
METRICS_WINDOW_MINUTES=15
AUTO_TUNE_THRESHOLDS=False
FORMULAS_JSON={}

# Optional learning loop.
ML_ENABLED=False
ML_MIN_SAMPLES=150
ML_PROB_THRESHOLD=0.6
AUTO_AGENT_ENABLED=False
AUTO_AGENT_TRAIN_INTERVAL_MIN=30
