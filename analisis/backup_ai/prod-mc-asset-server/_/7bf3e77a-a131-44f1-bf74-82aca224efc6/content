        async with aiohttp.ClientSession() as session:
            try:
                logger.info("Fetching initial data...")
                BASE_URL = "https://api.bybit.com"
                kline_url = f"{BASE_URL}/v5/market/kline"
                params = {"category": "spot", "symbol": self.symbol, "interval": self.timeframe.replace("m", ""), "limit": 10}
                async with session.get(kline_url, params=params, timeout=10) as response:
                    if response.status == 200:
                        kline_response = await response.json()
