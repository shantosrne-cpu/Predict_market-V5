                else:
                    logger.error(f"Kline inesperado: {kline_response}")
            else:
                logger.error(f"Error kline: {response.status_code} - {response.text}")

            orderbook_url = f"{BASE_URL}/v5/market/orderbook"
            params = {"category": "spot", "symbol": self.symbol, "limit": 100}
            response = requests.get(orderbook_url, params=params, timeout=10)
            if response.status_code == 200:
                orderbook_response = response.json()
                if "result" in orderbook_response:
                    self.orderbook_data = {"bids": orderbook_response["result"]["b"], "asks": orderbook_response["result"]["a"]}
                    logger.info(f"Orderbook: Bids={len(self.orderbook_data['bids'])}, Asks={len(self.orderbook_data['asks'])}")
                else:
                    logger.error(f"Orderbook inesperado: {orderbook_response}")
            else:
                logger.error(f"Error orderbook: {response.status_code} - {response.text}")

            ticker_url = f"{BASE_URL}/v5/market/tickers"
            params = {"category": "spot", "symbol": self.symbol}
            response = requests.get(ticker_url, params=params, timeout=10)
            if response.status_code == 200:
                ticker_response = response.json()
                if "result" in ticker_response and "list" in ticker_response["result"]:
                    ticker_data = ticker_response["result"]["list"][0]
                    self.ticker_data = {
                        "last_price": float(ticker_data["lastPrice"]),
                        "volume_24h": float(ticker_data["volume24h"]),
                        "high_24h": float(ticker_data["highPrice24h"]),
                        "low_24h": float(ticker_data["lowPrice24h"])
                    }
                    logger.info(f"Ticker inicial: {self.ticker_data['last_price']}")
                else:
                    logger.error(f"Ticker inesperado: {ticker_response}")
            else:
                logger.error(f"Error ticker: {response.status_code} - {response.text}")

        except requests.exceptions.RequestException as exc:
            logger.error(f"Error de red en fetch inicial: {exc}")
            self._load_fallback_data()
        except Exception as exc:
            logger.error(f"Fetch inicial falló: {exc}")
            self._load_fallback_data()

