def _ensure_sqlite_schema() -> None:
    try:
        with engine.begin() as conn:
            trade_cols = [row[1] for row in conn.exec_driver_sql("PRAGMA table_info(trades)").fetchall()]
            if "order_link_id" not in trade_cols:
                conn.exec_driver_sql("ALTER TABLE trades ADD COLUMN order_link_id TEXT")
                conn.exec_driver_sql("CREATE INDEX IF NOT EXISTS ix_trades_order_link_id ON trades(order_link_id)")

            pos_cols = [row[1] for row in conn.exec_driver_sql("PRAGMA table_info(positions)").fetchall()]
            if "order_link_id" not in pos_cols:
                conn.exec_driver_sql("ALTER TABLE positions ADD COLUMN order_link_id TEXT")
                conn.exec_driver_sql("CREATE INDEX IF NOT EXISTS ix_positions_order_link_id ON positions(order_link_id)")
    except Exception as e:
        logger.error(f"❌ Error al migrar esquema SQLite: {e}")


def _repair_orderbook_double_encoded(max_rows: int = 5000) -> None:
    def _decode(value: Any) -> Optional[List[Any]]:
        if value is None:
            return []
        if isinstance(value, (bytes, bytearray)):
            raw = value.decode("utf-8", "replace")
        else:
            raw = value if isinstance(value, str) else str(value)
        try:
            obj: Any = json.loads(raw)
        except Exception:
            return None
        for _ in range(2):
            if isinstance(obj, str):
                try:
                    obj = json.loads(obj)
                except Exception:
                    break
        return obj if isinstance(obj, list) else None

    try:
        with engine.begin() as conn:
            rows = conn.exec_driver_sql(
                "SELECT id, bids, asks FROM orderbook "
                "WHERE substr(bids, 1, 2)='\"[' OR substr(asks, 1, 2)='\"[' "
                "ORDER BY id DESC LIMIT ?",
                (int(max_rows),),
            ).fetchall()
            for row_id, bids_raw, asks_raw in rows:
                bids_obj = _decode(bids_raw)
                asks_obj = _decode(asks_raw)
                if bids_obj is None or asks_obj is None:
                    continue
                conn.exec_driver_sql(
                    "UPDATE orderbook SET bids=?, asks=? WHERE id=?",
                    (
                        json.dumps(bids_obj, ensure_ascii=False),
                        json.dumps(asks_obj, ensure_ascii=False),
                        int(row_id),
                    ),
                )
            if rows:
                logger.info(f"🧹 Orderbook reparado (double-encoded): {len(rows)} filas")
    except Exception as e:
        logger.warning(f"⚠️ No se pudo reparar orderbook double-encoded: {e}")


_ensure_sqlite_schema()
_repair_orderbook_double_encoded()
